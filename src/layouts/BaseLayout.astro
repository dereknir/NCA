---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE_CONFIG, NAVIGATION, NAV_GROUPS, PLANETS } from '../config';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishDate?: Date;
  /** View Transitions (像素溶解換頁 + 封面 morph)。
   *  目前只在 translations 列表/內頁圈內開 — 兩頁都開才有效果;
   *  開了的頁面所有 client script 都要能在 astro:page-load 重跑, 別亂加頁。 */
  viewTransitions?: boolean;
  /** 內容寬度: wide (列表/工具 1024) / read (閱讀 896) / legacy (舊 container, 還沒改版的頁)。
   *  跟 PageHero 的 width 一致, hero 左緣才會對齊內文。 */
  width?: 'wide' | 'read' | 'stage' | 'legacy';
  /** 沉浸模式 (首頁的房間): 整頁只剩 hero, 沒有頁首、內文、頁尾;
   *  左下的指令列按鈕也收起來 (房間裡的電腦就是指令列, 手機就是 N247i), 按 / 照樣叫得出來。 */
  immersive?: boolean;
  /** 標題是日文的頁 (歌曲頁、完整 Live): 日文像素字也先抓, 不然標題先用備用字型畫、字型到了再換, 整塊會跳一下 */
  jaTitle?: boolean;
}

const {
  title,
  description = SITE_CONFIG.description,
  image = SITE_CONFIG.defaultOGImage,
  article = false,
  publishDate,
  viewTransitions = false,
  width = 'legacy',
  immersive = false,
  jaTitle = false
} = Astro.props;

// 目前頁面屬於哪個選單項 (路徑前綴最長者); site-shell.js 對靜態頁用同一套規則
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const here = norm(Astro.url.pathname);
const navItems = NAV_GROUPS.flatMap(g => g.items.map(it => ({ ...it, group: g.name })));
const current = navItems
  .filter(it => here === norm(it.href) || here.startsWith(norm(it.href) + '/'))
  .sort((a, b) => b.href.length - a.href.length)[0];
const mainClass = width === 'legacy' ? 'container mx-auto px-4 py-8 fade-in'
  : `sh-wrap${width === 'read' ? ' sh-wrap--read' : width === 'stage' ? ' sh-wrap--stage' : ''} sh-main fade-in`;

// 網域還沒定 (astro.config.mjs 的 SITE 留空) 時不輸出 canonical / og:url, og:image 用站內路徑
const canonicalURL = Astro.site && new URL(Astro.url.pathname, Astro.site);
const imageURL = Astro.site ? new URL(image, Astro.site) : image;
const fullTitle = title === SITE_CONFIG.title ? title : `${title} | ${SITE_CONFIG.title}`;
---

<!DOCTYPE html>
<html lang="zh-TW" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- 只有深色: 瀏覽器自己畫的東西 (捲軸、表單、載入前的底色) 也用深色; 手機網址列配站的底色 -->
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0a0a15">

  <!-- 基本 SEO -->
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta name="author" content={SITE_CONFIG.author}>
  {canonicalURL && <link rel="canonical" href={canonicalURL}>}
  {Astro.site && <link rel="sitemap" href="/sitemap-index.xml">}
  {Astro.site && <link rel="alternate" type="application/rss+xml" title="derekkk" href="/rss.xml">}

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={article ? "article" : SITE_CONFIG.seo.ogType}>
  {canonicalURL && <meta property="og:url" content={canonicalURL}>}
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={imageURL}>
  <meta property="og:site_name" content={SITE_CONFIG.title}>
  <meta property="og:locale" content={SITE_CONFIG.locale}>
  {article && publishDate && (
    <meta property="article:published_time" content={publishDate.toISOString()}>
  )}

  <!-- Twitter Card -->
  <meta name="twitter:card" content={SITE_CONFIG.seo.twitterCard}>
  {canonicalURL && <meta name="twitter:url" content={canonicalURL}>}
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={imageURL}>

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <!-- 加到主畫面 (PWA): service worker 由 site-shell.js 註冊, 靜態頁也吃得到 -->
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">

  <!-- Pixel 主視覺字型 (全站統一: PX12=UI/標題, PX10=內文; 首屏防閃字)
       只先抓中文兩份: 日文那兩份各 100KB 上下, 大部分頁面第一眼用不到, 用到再抓 -->
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pixel/fp12-site-zh_hant.woff2">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pixel/fp10-site-zh_hant.woff2">
  {jaTitle && <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pixel/fp12-site-ja.woff2">}

  <link rel="stylesheet" href="/css/scrollbar.css">

  <link rel="stylesheet" href="/css/site-shell.css">
  <script is:inline src="/js/site-shell.js" defer></script>

  {viewTransitions && <ClientRouter />}
  {/* 滑鼠停在站內連結上 (手機是手指按下去) 就先把那頁抓好, 點下去幾乎是瞬間打開。
      翻譯頁圈內是 ClientRouter 自己換頁 (用 fetch, 吃不到這種預抓), 所以只在其他頁放。
      後台、標注工具、資料檔不抓 */}
  {!viewTransitions && <script is:inline type="speculationrules" set:html={JSON.stringify({
    prefetch: [{
      where: { and: [{ href_matches: '/*' }, { not: { href_matches: ['/admin/*', '/annotate/*', '/*.xml', '/*.json'] } }] },
      eagerness: 'moderate',
    }],
  })} />}

  <!-- 字體預連接與預載入（性能優化）; DotGothic16 已改自己放 (site-shell.css), 這裡只剩 Noto Sans JP -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- 先用 media="print" 載 (不擋畫面), site-shell.js 再換回 all; 不寫 onload, 之後開 CSP 也不會被擋 -->
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap"
    rel="stylesheet"
    media="print"
    data-async-css
  >
  <!-- Fallback for browsers that don't support media attribute manipulation -->
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet">
  </noscript>

  <!-- 舊 theme 設定清理 (dark-only, 不再讀取) -->
  <script is:inline>
    try { localStorage.removeItem('theme'); } catch (e) {}
  </script>
</head>

<body class="min-h-screen bg-[#0a0a15] text-gray-100 font-sans" data-sh-pill={immersive ? 'off' : undefined}>
  {!immersive && <>
  <!-- 鍵盤使用者按 Tab 第一個到這裡, 直接跳過頁首選單 -->
  <a class="sh-skip" href="#main">跳到主要內容</a>
  <!-- 頁首: 4 組下拉 + 單鍵 [X]; 捲動後標題縮進 .sh-dock (樣式/行為在 site-shell) -->
  <header class="sh-hd">
    <div class="sh-wrap">
      <a class="sh-logo" href="/">{SITE_CONFIG.title}</a>
      <span class="sh-dock"></span>
      <button class="sh-burger" type="button" aria-expanded="false" aria-controls="sh-nav">選單</button>
      <nav class="sh-nav" id="sh-nav" aria-label="全站">
        {NAV_GROUPS.map((g, gi) => (
          <div class={`sh-grp${current?.group === g.name ? ' on' : ''}`}>
            <button type="button" aria-expanded="false" aria-controls={`sh-menu-${gi}`}>{g.name}</button>
            <div class="sh-menu" id={`sh-menu-${gi}`}>
              {g.items.map(it => (
                <a href={it.href} class={current?.href === it.href ? 'cur' : undefined}
                   aria-current={current?.href === it.href ? 'page' : undefined}>
                  <kbd>[{it.key}]</kbd>{it.name}<span>{PLANETS[it.planet]?.ja}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </nav>
    </div>
    <div class="sh-prog"></div>
  </header>
  </>}

  <!-- Optional 100vw hero (bleeds out of container) -->
  <slot name="hero" />

  {!immersive && <>
  <!-- Main Content -->
  <main id="main" tabindex="-1" class={mainClass}>
    <slot />
  </main>

  <!-- 頁尾: 平常只有一條狀態列, 展開才有連結 (src/components/SiteFooter.astro) -->
  <SiteFooter />
  </>}

</body>
</html>
