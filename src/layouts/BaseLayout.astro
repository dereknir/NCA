---
import '../styles/global.css';
import { SITE_CONFIG, NAVIGATION } from '../config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishDate?: Date;
}

const {
  title,
  description = SITE_CONFIG.description,
  image = SITE_CONFIG.defaultOGImage,
  article = false,
  publishDate
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE_CONFIG.title ? title : `${title} | ${SITE_CONFIG.title}`;
---

<!DOCTYPE html>
<html lang="zh-TW" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- 基本 SEO -->
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta name="author" content={SITE_CONFIG.author}>
  <link rel="canonical" href={canonicalURL}>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={article ? "article" : SITE_CONFIG.seo.ogType}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(image, Astro.site)}>
  <meta property="og:site_name" content={SITE_CONFIG.title}>
  <meta property="og:locale" content={SITE_CONFIG.locale}>
  {article && publishDate && (
    <meta property="article:published_time" content={publishDate.toISOString()}>
  )}

  <!-- Twitter Card -->
  <meta name="twitter:card" content={SITE_CONFIG.seo.twitterCard}>
  <meta name="twitter:url" content={canonicalURL}>
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={new URL(image, Astro.site)}>

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Pixel 主視覺字型 (D 層外殼用, 首屏防閃字) -->
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pixel/fp12-site-zh_hant.woff2">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pixel/fp12-site-ja.woff2">

  <!-- 字體預連接與預載入（性能優化） -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- 使用 font-display: swap 避免字體加載阻塞渲染 -->
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Noto+Sans+TC:wght@400;700&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  >
  <!-- Fallback for browsers that don't support media attribute manipulation -->
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Noto+Sans+TC:wght@400;700&display=swap" rel="stylesheet">
  </noscript>

  <!-- 舊 theme 設定清理 (dark-only, 不再讀取) -->
  <script is:inline>
    try { localStorage.removeItem('theme'); } catch (e) {}
  </script>
</head>

<body class="min-h-screen bg-[#0a0a15] text-gray-100 font-sans">
  <!-- Header -->
  <header class="sticky top-0 z-50 bg-[#0a0a15]/75 backdrop-blur-md border-b border-white/5">
    <nav class="container mx-auto px-4 py-4">
      <div class="flex justify-between items-center">
        <a href="/" class="px-font text-2xl text-white hover:text-blue-400 transition-colors">
          {SITE_CONFIG.title}
        </a>

        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg hover:bg-white/5">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>

        <!-- Desktop nav -->
        <div class="hidden md:flex items-center gap-6">
          {NAVIGATION.map(item => (
            <a href={item.href} class="px-font text-[12px] hover:text-blue-400 transition-colors">
              {item.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Mobile nav -->
      <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t border-white/10 pt-4">
        <div class="flex flex-col gap-3">
          {NAVIGATION.map(item => (
            <a href={item.href} class="px-font text-[12px] hover:text-blue-400 transition-colors">
              {item.name}
            </a>
          ))}
        </div>
      </div>
    </nav>
  </header>

  <!-- Optional 100vw hero (bleeds out of container) -->
  <slot name="hero" />

  <!-- Main Content -->
  <main class="container mx-auto px-4 py-8 fade-in">
    <slot />
  </main>

  <!-- Footer (structure/CSS 1:1 replicated from nlpfin.github.io reference) -->
  <footer class="site-footer">
    <div class="site-footer-container">
      <div class="site-footer-grid">
        <div class="site-footer-section">
          <h3>探索</h3>
          <ul class="site-footer-links">
            {NAVIGATION.map(item => (
              <li><a href={item.href}>{item.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="site-footer-section">
          <h3>Connect</h3>
          <ul class="site-footer-links">
            <li><a href={`mailto:${SITE_CONFIG.social.email}`}>{SITE_CONFIG.social.email}</a></li>
            <li><a href={SITE_CONFIG.social.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          </ul>
        </div>
      </div>
      <div class="site-footer-bottom">
        <p>© {new Date().getFullYear()} {SITE_CONFIG.author}. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <style is:global>
    .site-footer {
      background: #0f0f1d;
      color: rgb(156 163 175);
      padding: 3.5rem 0 1.5rem;
      margin-top: 6rem;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
    .site-footer-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.25rem;
    }
    .site-footer-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      margin-bottom: 2.5rem;
    }
    .site-footer-section h3 {
      font-family: 'PX-ZH', 'PX-JA', var(--font-sans);
      font-size: 12px;
      font-weight: 400;
      letter-spacing: .1em;
      color: #fff;
      margin: 0 0 0.9rem;
    }
    .site-footer-links {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .site-footer-links li { margin-bottom: 0.45rem; }
    .site-footer-links a {
      color: rgb(156 163 175);
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
    }
    .site-footer-links a:hover { color: rgb(96 165 250); }

    .site-footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-top: 1.4rem;
      text-align: center;
      font-size: 0.85rem;
      color: rgb(107 114 128);
    }
    .site-footer-bottom p { margin: 0; }

    @media (max-width: 580px) {
      .site-footer-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script is:inline>
    document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
      document.getElementById('mobile-menu')?.classList.toggle('hidden');
    });
  </script>
</body>
</html>
