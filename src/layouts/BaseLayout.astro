---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE_CONFIG, NAVIGATION, NAV_GROUPS, PLANETS } from '../config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishDate?: Date;
  /** View Transitions (像素溶解換頁 + 封面 morph)。
   *  目前只在 translations 列表/內頁圈內開 — 兩頁都開才有效果;
   *  開了的頁面所有 client script 都要能在 astro:page-load 重跑, 別亂加頁。 */
  viewTransitions?: boolean;
  /** 內容寬度: wide (列表/工具 1024) / read (閱讀 896) / legacy (舊 container, 還沒改版的頁)。
   *  跟 PageHero 的 width 一致, hero 左緣才會對齊內文。 */
  width?: 'wide' | 'read' | 'stage' | 'legacy';
}

const {
  title,
  description = SITE_CONFIG.description,
  image = SITE_CONFIG.defaultOGImage,
  article = false,
  publishDate,
  viewTransitions = false,
  width = 'legacy'
} = Astro.props;

// 目前頁面屬於哪個選單項 (路徑前綴最長者); site-shell.js 對靜態頁用同一套規則
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const here = norm(Astro.url.pathname);
const navItems = NAV_GROUPS.flatMap(g => g.items.map(it => ({ ...it, group: g.name })));
const current = navItems
  .filter(it => here === norm(it.href) || here.startsWith(norm(it.href) + '/'))
  .sort((a, b) => b.href.length - a.href.length)[0];
const mainClass = width === 'legacy' ? 'container mx-auto px-4 py-8 fade-in'
  : `sh-wrap${width === 'read' ? ' sh-wrap--read' : width === 'stage' ? ' sh-wrap--stage' : ''} sh-main fade-in`;

// 網域還沒定 (astro.config.mjs 的 SITE 留空) 時不輸出 canonical / og:url, og:image 用站內路徑
const canonicalURL = Astro.site && new URL(Astro.url.pathname, Astro.site);
const imageURL = Astro.site ? new URL(image, Astro.site) : image;
const fullTitle = title === SITE_CONFIG.title ? title : `${title} | ${SITE_CONFIG.title}`;
---

<!DOCTYPE html>
<html lang="zh-TW" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- 基本 SEO -->
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta name="author" content={SITE_CONFIG.author}>
  {canonicalURL && <link rel="canonical" href={canonicalURL}>}
  {Astro.site && <link rel="sitemap" href="/sitemap-index.xml">}

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={article ? "article" : SITE_CONFIG.seo.ogType}>
  {canonicalURL && <meta property="og:url" content={canonicalURL}>}
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={imageURL}>
  <meta property="og:site_name" content={SITE_CONFIG.title}>
  <meta property="og:locale" content={SITE_CONFIG.locale}>
  {article && publishDate && (
    <meta property="article:published_time" content={publishDate.toISOString()}>
  )}

  <!-- Twitter Card -->
  <meta name="twitter:card" content={SITE_CONFIG.seo.twitterCard}>
  {canonicalURL && <meta name="twitter:url" content={canonicalURL}>}
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={imageURL}>

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Pixel 主視覺字型 (全站統一: PX12=UI/標題, PX10=內文; 首屏防閃字) -->
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pixel/fp12-site-zh_hant.woff2">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pixel/fp12-site-ja.woff2">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pixel/fp10-site-zh_hant.woff2">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pixel/fp10-site-ja.woff2">

  <link rel="stylesheet" href="/css/site-shell.css">
  <script is:inline src="/js/site-shell.js" defer></script>

  {viewTransitions && <ClientRouter />}

  <!-- 字體預連接與預載入（性能優化） -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- 使用 font-display: swap 避免字體加載阻塞渲染 -->
  <link
    href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Noto+Sans+JP:wght@400;700&family=Noto+Sans+TC:wght@400;700&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  >
  <!-- Fallback for browsers that don't support media attribute manipulation -->
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Noto+Sans+JP:wght@400;700&family=Noto+Sans+TC:wght@400;700&display=swap" rel="stylesheet">
  </noscript>

  <!-- 舊 theme 設定清理 (dark-only, 不再讀取) -->
  <script is:inline>
    try { localStorage.removeItem('theme'); } catch (e) {}
  </script>
</head>

<body class="min-h-screen bg-[#0a0a15] text-gray-100 font-sans">
  <!-- 頁首: 4 組下拉 + 單鍵 [X]; 捲動後標題縮進 .sh-dock (樣式/行為在 site-shell) -->
  <header class="sh-hd">
    <div class="sh-wrap">
      <a class="sh-logo" href="/">{SITE_CONFIG.title}</a>
      <span class="sh-dock"></span>
      <button class="sh-burger" type="button" aria-expanded="false">選單</button>
      <nav class="sh-nav">
        {NAV_GROUPS.map(g => (
          <div class={`sh-grp${current?.group === g.name ? ' on' : ''}`}>
            <button type="button" aria-haspopup="true">{g.name}</button>
            <div class="sh-menu">
              {g.items.map(it => (
                <a href={it.href} class={current?.href === it.href ? 'cur' : undefined}
                   aria-current={current?.href === it.href ? 'page' : undefined}>
                  <kbd>[{it.key}]</kbd>{it.name}<span>{PLANETS[it.planet]?.ja}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </nav>
    </div>
    <div class="sh-prog"></div>
  </header>

  <!-- Optional 100vw hero (bleeds out of container) -->
  <slot name="hero" />

  <!-- Main Content -->
  <main class={mainClass}>
    <slot />
  </main>

  <!-- Footer (structure/CSS 1:1 replicated from nlpfin.github.io reference) -->
  <footer class="site-footer">
    <div class="site-footer-container">
      <div class="site-footer-grid">
        <div class="site-footer-section">
          <h3>探索</h3>
          <ul class="site-footer-links">
            {NAVIGATION.map(item => (
              <li><a href={item.href}>{item.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="site-footer-section">
          <h3>Connect</h3>
          <ul class="site-footer-links">
            <li><a href={`mailto:${SITE_CONFIG.social.email}`}>{SITE_CONFIG.social.email}</a></li>
            <li><a href={SITE_CONFIG.social.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          </ul>
        </div>
      </div>
      <div class="site-footer-bottom">
        <p>© {new Date().getFullYear()} {SITE_CONFIG.author}. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <style is:global>
    .site-footer {
      background: #0f0f1d;
      color: rgb(156 163 175);
      padding: 3.5rem 0 1.5rem;
      margin-top: 6rem;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
    .site-footer-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.25rem;
    }
    .site-footer-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      margin-bottom: 2.5rem;
    }
    .site-footer-section h3 {
      font-family: 'PX-ZH', 'PX-JA', var(--font-sans);
      font-size: 12px;
      font-weight: 400;
      letter-spacing: .1em;
      color: #fff;
      margin: 0 0 0.9rem;
    }
    .site-footer-links {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .site-footer-links li { margin-bottom: 0.45rem; }
    .site-footer-links a {
      color: rgb(156 163 175);
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
    }
    .site-footer-links a:hover { color: rgb(96 165 250); }

    .site-footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-top: 1.4rem;
      text-align: center;
      font-size: 0.85rem;
      color: rgb(107 114 128);
    }
    .site-footer-bottom p { margin: 0; }

    @media (max-width: 580px) {
      .site-footer-grid { grid-template-columns: 1fr; }
    }
  </style>

</body>
</html>
