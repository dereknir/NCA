---
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';
import { SITE_CONFIG, NAVIGATION } from '../config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishDate?: Date;
}

const {
  title,
  description = SITE_CONFIG.description,
  image = SITE_CONFIG.defaultOGImage,
  article = false,
  publishDate
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE_CONFIG.title ? title : `${title} | ${SITE_CONFIG.title}`;
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- 基本 SEO -->
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta name="author" content={SITE_CONFIG.author}>
  <link rel="canonical" href={canonicalURL}>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={article ? "article" : SITE_CONFIG.seo.ogType}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(image, Astro.site)}>
  <meta property="og:site_name" content={SITE_CONFIG.title}>
  <meta property="og:locale" content={SITE_CONFIG.locale}>
  {article && publishDate && (
    <meta property="article:published_time" content={publishDate.toISOString()}>
  )}

  <!-- Twitter Card -->
  <meta name="twitter:card" content={SITE_CONFIG.seo.twitterCard}>
  <meta name="twitter:url" content={canonicalURL}>
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={new URL(image, Astro.site)}>

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- 字體預連接與預載入（性能優化） -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- 使用 font-display: swap 避免字體加載阻塞渲染 -->
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Noto+Sans+TC:wght@400;700&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  >
  <!-- Fallback for browsers that don't support media attribute manipulation -->
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Noto+Sans+TC:wght@400;700&display=swap" rel="stylesheet">
  </noscript>

  <!-- 主題腳本 -->
  <script is:inline>
    if (localStorage.getItem('theme') === 'dark' ||
      (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>

<body class="min-h-screen bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 font-sans">
  <!-- Header -->
  <header class="sticky top-0 z-50 bg-white/80 dark:bg-gray-800/80 backdrop-blur-md shadow-sm">
    <nav class="container mx-auto px-4 py-4">
      <div class="flex justify-between items-center">
        <a href="/" class="text-2xl font-bold text-gray-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
          {SITE_CONFIG.title}
        </a>

        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>

        <!-- Desktop nav -->
        <div class="hidden md:flex items-center gap-6">
          {NAVIGATION.map(item => (
            <a href={item.href} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              {item.name}
            </a>
          ))}
          <ThemeToggle />
        </div>
      </div>

      <!-- Mobile nav -->
      <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t border-gray-200 dark:border-gray-700 pt-4">
        <div class="flex flex-col gap-3">
          {NAVIGATION.map(item => (
            <a href={item.href} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              {item.name}
            </a>
          ))}
          <ThemeToggle />
        </div>
      </div>
    </nav>
  </header>

  <!-- Main Content -->
  <main class="container mx-auto px-4 py-8 fade-in">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container mx-auto px-6 pt-16 pb-4">
      <div class="footer-cols">
        <div>
          <h3 class="footer-heading">Explore</h3>
          <ul class="footer-list">
            {NAVIGATION.map(item => (
              <li><a href={item.href} class="footer-link">{item.name}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="footer-heading">Connect</h3>
          <ul class="footer-list">
            <li><a href={`mailto:${SITE_CONFIG.social.email}`} class="footer-link">{SITE_CONFIG.social.email}</a></li>
            <li><a href={SITE_CONFIG.social.github} target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-divider"></div>
      <p class="footer-copy">
        © {new Date().getFullYear()} {SITE_CONFIG.author}. All rights reserved.
      </p>
    </div>
  </footer>

  <style is:global>
    .site-footer {
      background: rgb(243 244 246);   /* light: gray-100 */
      color: rgb(75 85 99);            /* light text: gray-600 */
      margin-top: 6rem;
    }
    /* 兩欄置中偏左, 右側留空白 (跟參考圖比例一致) */
    .footer-cols {
      max-width: 72rem;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }
    @media (min-width: 768px) {
      .footer-cols {
        display: grid;
        /* 兩欄自然寬度 + spacer 吃掉剩下空間 → 內容靠左 */
        grid-template-columns: max-content max-content 1fr;
        column-gap: 8rem;
        gap: 0;
      }
    }
    :root.dark .site-footer,
    .dark .site-footer {
      background: rgb(31 41 55);       /* dark: gray-800 */
      color: rgb(156 163 175);
    }
    .footer-heading {
      color: rgb(31 41 55);
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      margin-bottom: 1.5rem;
    }
    .dark .footer-heading { color: rgb(243 244 246); }
    .footer-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }
    .footer-link {
      color: rgb(75 85 99);
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.15s ease;
    }
    .footer-link:hover { color: rgb(37 99 235); }   /* blue-600 (跟現有 accent 一致) */
    .dark .footer-link { color: rgb(156 163 175); }
    .dark .footer-link:hover { color: rgb(96 165 250); }  /* blue-400 */

    .footer-divider {
      border-top: 1px solid rgb(229 231 235);
      margin: 3rem auto 2rem;
      max-width: 72rem;
    }
    .dark .footer-divider { border-top-color: rgb(55 65 81); }

    .footer-copy {
      text-align: center;
      font-size: 0.75rem;
      color: rgb(156 163 175);
      margin: 0;                         /* 拿掉 <p> 預設 margin, 貼底 */
    }
    .dark .footer-copy { color: rgb(107 114 128); }
  </style>

  <script is:inline>
    document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
      document.getElementById('mobile-menu')?.classList.toggle('hidden');
    });
  </script>
</body>
</html>
