---
import BrandPlanet from './BrandPlanet.astro';
/**
 * SiteFooter — 內頁最下面 (首頁是房間, 沒有頁尾)
 * 平常只有一條像終端機最下面的狀態列: 中間版權, 右邊快捷鍵說明 (?)、RSS (有網域才有)、信箱、GitHub、展開鈕; 左下角的指令列膠囊疊在這條上面, 太窄的手機上版權字讓開它。
 * 展開才看得到連結 (跟頁首選單同樣分 4 組) 跟左邊的「derekkk」+ 小行星; 頁首本來就有全部連結, 所以預設收著, 展開過就記住 (localStorage sh-foot)。
 * 圖示都是像素畫 (用 # 畫的格子轉成 SVG 方塊), 顏色跟著文字。
 */
import { SITE_CONFIG, NAV_GROUPS } from '../config';

// 格子 → SVG path (每一列連續的 # 合成一塊)
const px = (rows: string[]) => {
  let d = '';
  rows.forEach((r, y) => {
    for (let x = 0; x < r.length;) {
      if (r[x] !== '#') { x++; continue; }
      let w = 1; while (r[x + w] === '#') w++;
      d += `M${x} ${y}h${w}v1h-${w}z`; x += w;
    }
  });
  return { d, w: rows[0].length, h: rows.length };
};
const ICON = {
  mail: px([
    '###########',
    '##.......##',
    '#.#.....#.#',
    '#..#...#..#',
    '#...###...#',
    '#.........#',
    '###########',
  ]),
  github: px([
    '..#.....#..',
    '..##...##..',
    '..#######..',
    '.#########.',
    '.##.###.##.',
    '.#########.',
    '..#######..',
    '#..#####...',
    '.##.#.#....',
  ]),
  rss: px([
    '##.....',
    '..##...',
    '....#..',
    '##...#.',
    '..#...#',
    '...#..#',
    '##.#..#',
  ]),
  help: px([
    '.###.',
    '#...#',
    '...#.',
    '..#..',
    '..#..',
    '.....',
    '..#..',
  ]),
  up: px([
    '...#...',
    '..###..',
    '.##.##.',
    '##...##',
  ]),
};
const year = new Date().getFullYear();
---

<footer class="site-footer" data-foot>
  <div class="sf-more" id="sf-more" hidden>
    <div class="sf-inner">
      <a class="sf-brand" href="/" aria-label="derekkk (回首頁)">
        <BrandPlanet class="sf-planet" />
        <span>derekkk</span>
      </a>
      <div class="sf-cols">
        {NAV_GROUPS.map(g => (
          <nav class="sf-col" aria-label={g.name}>
            <h2>{g.name}</h2>
            <ul>{g.items.map(it => <li><a href={it.href}>{it.name}</a></li>)}</ul>
          </nav>
        ))}
      </div>
    </div>
  </div>
  <div class="sf-line">
    <p class="sf-copy">© {year} derekkk</p>
    <div class="sf-ico">
      <button type="button" class="sf-help" title="鍵盤快捷鍵 (?)" aria-label="鍵盤快捷鍵">
        <svg viewBox={`0 0 ${ICON.help.w} ${ICON.help.h}`} width={ICON.help.w * 2} height={ICON.help.h * 2} shape-rendering="crispEdges" aria-hidden="true"><path d={ICON.help.d} fill="currentColor" /></svg>
      </button>
      {Astro.site && (
        <a href="/rss.xml" title="RSS 訂閱" aria-label="RSS 訂閱">
          <svg viewBox={`0 0 ${ICON.rss.w} ${ICON.rss.h}`} width={ICON.rss.w * 2} height={ICON.rss.h * 2} shape-rendering="crispEdges" aria-hidden="true"><path d={ICON.rss.d} fill="currentColor" /></svg>
        </a>
      )}
      <a href={`mailto:${SITE_CONFIG.social.email}`} title="寄信給我" aria-label="寄信給我">
        <svg viewBox={`0 0 ${ICON.mail.w} ${ICON.mail.h}`} width={ICON.mail.w * 2} height={ICON.mail.h * 2} shape-rendering="crispEdges" aria-hidden="true"><path d={ICON.mail.d} fill="currentColor" /></svg>
      </a>
      <a href={SITE_CONFIG.social.github} target="_blank" rel="noopener noreferrer" title="GitHub" aria-label="GitHub">
        <svg viewBox={`0 0 ${ICON.github.w} ${ICON.github.h}`} width={ICON.github.w * 2} height={ICON.github.h * 2} shape-rendering="crispEdges" aria-hidden="true"><path d={ICON.github.d} fill="currentColor" /></svg>
      </a>
      <button type="button" class="sf-toggle" aria-expanded="false" aria-controls="sf-more" title="展開頁尾連結" aria-label="展開頁尾連結">
        <svg viewBox={`0 0 ${ICON.up.w} ${ICON.up.h}`} width={ICON.up.w * 2} height={ICON.up.h * 2} shape-rendering="crispEdges" aria-hidden="true"><path d={ICON.up.d} fill="currentColor" /></svg>
      </button>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const f = document.querySelector('[data-foot]');
    if (!f || f.dataset.wired) return;
    f.dataset.wired = '1';
    const more = f.querySelector('.sf-more'), btn = f.querySelector('.sf-toggle');
    const set = open => {
      more.hidden = !open; btn.setAttribute('aria-expanded', open);
      const t = open ? '收起頁尾連結' : '展開頁尾連結'; btn.title = t; btn.setAttribute('aria-label', t);
    };
    try { set(localStorage.getItem('sh-foot') === 'open'); } catch (e) {}
    // ? 按鈕: 不寫在 onclick 屬性裡 (之後 CSP 收緊也不會被擋)
    f.querySelector('.sf-help')?.addEventListener('click', () => window.__shellHelp?.open());
    btn.addEventListener('click', () => {
      const open = more.hidden; set(open);
      try { localStorage.setItem('sh-foot', open ? 'open' : 'closed'); } catch (e) {}
      if (open) more.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });
    // 左下角的指令列膠囊疊在狀態列左邊: 版權字讓開它的寬度
    // 指令列打開時整條變全寬, 這時候量會把 --sf-cli 寫成整個視窗寬 (之後頁尾就能左右滑): 開著先不量, 關掉再量一次
    const line = f.querySelector('.sf-line'), copy = f.querySelector('.sf-copy'), ico = f.querySelector('.sf-ico');
    const fit = () => {
      const c = document.querySelector('.sh-cli');
      if (c?.classList.contains('open')) return;
      const right = c ? (c.querySelector('.sh-cli-pill') || c).getBoundingClientRect().right : 0;
      f.style.setProperty('--sf-cli', right + 'px');
      // 版權字放不下 (碰到膠囊或右邊圖示, 例如有了 RSS 多一顆) 就搬到上面一行; 不寫死寬度, 照實際位置判斷
      line.classList.remove('sf-stack');
      const a = copy.getBoundingClientRect(), b = ico.getBoundingClientRect();
      if (a.left < right + 8 || a.right > b.left - 8) line.classList.add('sf-stack');
    };
    fit(); addEventListener('resize', fit); setTimeout(fit, 800);
    const cli = document.querySelector('.sh-cli');
    if (cli) new MutationObserver(fit).observe(cli, { attributes: true, attributeFilter: ['class'] });
  })();
</script>

<style is:global>
  .site-footer { margin-top: 6rem; font-family: var(--sh-px); color: var(--sh-ink3); background: #0f0f1d; border-top: 2px solid #1f1838; }
  .sf-more { border-bottom: 2px solid #1f1838; }
  .sf-inner { max-width: 1072px; margin: 0 auto; padding: 40px 24px 36px; display: grid; grid-template-columns: 220px 1fr; gap: 32px; }
  .sf-brand { display: flex; align-items: center; gap: 10px; align-self: start; color: var(--sh-ink); text-decoration: none; font-size: 16px; letter-spacing: .08em; }
  .sf-planet { width: 32px; height: 32px; image-rendering: pixelated; flex: none; }
  .sf-cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .sf-col h2 { margin: 0 0 12px; font-size: 12px; font-weight: 400; letter-spacing: .14em; color: var(--sh-gold); }
  .sf-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .sf-col a { font-size: 13px; color: var(--sh-ink2); text-decoration: none; }
  .sf-col a:hover, .sf-brand:hover span { color: var(--sh-gold); }
  /* 狀態列: 一條就好, 跟左下角的膠囊差不多高 */
  .sf-line { position: relative; display: flex; align-items: center; gap: 16px; min-height: 52px; padding: 0 16px 0 calc(var(--sf-cli, 0px) + 16px); }
  /* 版權字放在整條的正中間; 手機太窄 (左邊有膠囊、右邊有圖示), 改成放在兩者中間的空位置中 */
  .sf-copy { position: absolute; left: 50%; translate: -50% 0; margin: 0; font-size: 12px; letter-spacing: .08em; white-space: nowrap; }
  .sf-ico { margin-left: auto; display: flex; align-items: center; gap: 6px; }
  .sf-ico a, .sf-toggle, .sf-help { display: grid; place-items: center; width: 34px; height: 34px; padding: 0; color: var(--sh-ink3); background: none; border: 2px solid transparent; cursor: pointer; }
  .sf-ico a:is(:hover, :focus-visible), .sf-toggle:is(:hover, :focus-visible), .sf-help:is(:hover, :focus-visible) { color: var(--sh-gold); border-color: #3b335f; }
  .sf-ico a:focus-visible, .sf-toggle:focus-visible, .sf-help:focus-visible { outline: 2px solid var(--sh-gold); outline-offset: 2px; }
  .sf-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  @media (hover: none) { .sf-help { display: none; } }   /* 手機沒有鍵盤, 快捷鍵說明用不到 */
  @media (max-width: 760px) {
    .sf-inner { grid-template-columns: 1fr; gap: 24px; padding: 28px 16px; }
    .sf-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 16px; }
  }
  /* 膠囊 + 版權字 + 圖示一排塞不下 (320 小手機; 有網域多一顆 RSS 時 390 也會): 版權字搬到上面一行、置中整條;
     下面那排維持膠囊在左、圖示靠右, 高度跟原本一樣。sf-stack 是上面 script 量了真的會碰到才加的, 360 以下沒 JS 也照樣換行 */
  .sf-line.sf-stack { flex-wrap: wrap; padding-top: 12px; }
  .sf-stack .sf-copy { position: static; translate: none; order: -1; flex: 0 0 calc(100% + var(--sf-cli, 0px)); margin-left: calc(-1 * var(--sf-cli, 0px)); text-align: center; }
  .sf-stack .sf-ico { height: 52px; }
  @media (max-width: 360px) {
    .sf-line { flex-wrap: wrap; padding-top: 12px; }
    .sf-copy { position: static; translate: none; order: -1; flex: 0 0 calc(100% + var(--sf-cli, 0px)); margin-left: calc(-1 * var(--sf-cli, 0px)); text-align: center; }
    .sf-ico { height: 52px; }
  }
</style>
