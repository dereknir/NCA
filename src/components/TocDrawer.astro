---
/**
 * TocDrawer — YouTube 觀看頁式的目錄抽屜
 *
 * - 左上角的「目錄」鈕 (窄螢幕收進頁首, 排在「選單」左邊)
 * - 抽屜是瀏覽器內建的 <dialog>: 按鈕打開是 modal (背後的頁面整個 inert、Esc / 點旁邊關掉、焦點回到原處都是瀏覽器做的);
 *   桌機上次開著的話, 進頁面時用非 modal 的側欄還原 (不鎖捲動、不搶焦點)
 * - 目錄項目是真的連結 (#章節), 目前讀到的那節標 aria-current, 跳過去焦點也跟著到那一節
 * - 翻譯頁換頁不重新載入 (ClientRouter): 每次 astro:page-load 都重新掃一次文章、重新接上按鈕
 *
 * 使用方式: 直接放在頁面, 元件會自己掃 article 內的 H2/H3 + .shelf 建目錄。
 */
---

<button id="toc-btn" class="toc-btn" type="button" aria-label="開啟目錄" aria-expanded="false" aria-controls="toc-drawer">
  <svg class="toc-btn-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
    <line x1="4" y1="6" x2="20" y2="6"/>
    <line x1="4" y1="12" x2="20" y2="12"/>
    <line x1="4" y1="18" x2="20" y2="18"/>
  </svg>
  <span class="toc-btn-label">目錄</span>
</button>

<dialog id="toc-drawer" class="toc-drawer" aria-label="頁面目錄" closedby="any">
  <div class="toc-header">
    <h2 class="toc-heading">目錄</h2>
    <button class="toc-close" type="button" aria-label="關閉目錄">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="6" y1="18" x2="18" y2="6"/>
      </svg>
    </button>
  </div>
  <nav class="toc-scroll" aria-label="章節">
    <ul class="toc-list" role="list"></ul>
  </nav>
</dialog>

<style is:global>
  /* 章節錨點補償 sticky 頁首的高度, 跳轉時不會被遮 */
  .prose h2, .prose h3, .shelf { scroll-margin-top: 5rem; }

  /* ── 目錄鈕 (左上角) ── */
  .toc-btn {
    position: fixed;
    top: 5rem;
    left: 1rem;
    z-index: 30;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(31, 41, 55, 0.9);
    backdrop-filter: blur(8px);
    color: rgb(243 244 246);
    border: 1px solid rgb(55 65 81);
    border-radius: 999px;
    padding: 6px 14px 6px 10px;
    font-family: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
  }
  .toc-btn:hover { border-color: var(--sh-gold); }
  .toc-btn:focus-visible { outline: 2px solid var(--sh-gold); outline-offset: 2px; }
  .toc-btn-icon { flex-shrink: 0; }
  .toc-btn-label { font-weight: 500; }
  /* 抽屜開著的時候藏起來 (避免跟抽屜疊在一起) */
  html:has(.toc-drawer[open]) .toc-btn { opacity: 0; pointer-events: none; }

  /* ── 抽屜 (<dialog>) ── */
  .toc-drawer {
    position: fixed;
    inset: 0 auto 0 0;
    width: 300px;
    max-width: 85vw;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-right: 1px solid rgb(55 65 81);
    background: rgb(17 24 39);
    color: rgb(243 244 246);
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.12);
    flex-direction: column;
    overscroll-behavior: contain;
    translate: -100% 0;
    transition: translate .24s cubic-bezier(.4, 0, .2, 1), overlay .24s allow-discrete, display .24s allow-discrete;
  }
  .toc-drawer[open] { display: flex; translate: 0 0; }
  @starting-style { .toc-drawer[open] { translate: -100% 0; } }
  .toc-drawer::backdrop { background: rgb(0 0 0 / 0); overflow: hidden; overscroll-behavior: contain;
    transition: background .22s, overlay .22s allow-discrete, display .22s allow-discrete; }
  .toc-drawer[open]::backdrop { background: rgb(0 0 0 / .4); }
  @starting-style { .toc-drawer[open]::backdrop { background: rgb(0 0 0 / 0); } }
  @media (prefers-reduced-motion: reduce) { .toc-drawer, .toc-drawer::backdrop { transition: none; } }

  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgb(55 65 81);
    flex-shrink: 0;
  }
  .toc-heading { font-size: 0.95rem; font-weight: 600; color: rgb(243 244 246); margin: 0; letter-spacing: 0.02em; }
  .toc-close {
    background: transparent;
    border: 0;
    color: rgb(156 163 175);
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
    line-height: 0;
  }
  .toc-close:hover { background: rgb(55 65 81); color: rgb(243 244 246); }
  .toc-close:focus-visible { outline: 2px solid var(--sh-gold); outline-offset: 2px; }

  .toc-scroll { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 0.5rem 0; }
  .toc-list { list-style: none; margin: 0; padding: 0; }

  .toc-item {
    display: block;
    color: rgb(156 163 175);
    padding: 8px 1.25rem;
    font-size: 0.85rem;
    line-height: 1.4;
    text-decoration: none;
    border-left: 2px solid transparent;
  }
  .toc-item:hover { background: rgb(31 41 55); color: rgb(243 244 246); }
  .toc-item:focus-visible { outline: 2px solid var(--sh-gold); outline-offset: -2px; }
  .toc-item[aria-current="true"] { color: rgb(248 113 113); border-left-color: rgb(239 68 68); background: rgba(239, 68, 68, 0.08); font-weight: 500; }
  .toc-item-l3 { padding-left: 2.5rem; font-size: 0.78rem; }
  .toc-item-num { display: inline-block; color: rgb(156 163 175); margin-right: 0.4rem; font-variant-numeric: tabular-nums; font-size: 0.72rem; }
  .toc-item[aria-current="true"] .toc-item-num { color: rgb(248 113 113); }

  /* 窄螢幕 (頁首收成「選單」那顆的時候): 目錄鈕收進頁首, 排在「選單」左邊, 樣子跟它一樣;
     浮在左上角會在捲動時蓋到標題、歌詞。位置由下面那段 script 對齊「選單」鈕 */
  @media (max-width: 860px) {
    .toc-btn {
      top: var(--toc-top, 12px); left: auto; right: var(--toc-right, 72px); z-index: 51;
      gap: 6px; padding: 6px 10px; border: 2px solid var(--sh-line); border-radius: 0;
      background: none; backdrop-filter: none; box-shadow: none; color: var(--sh-ink);
      font: 12px var(--sh-px);
    }
    .toc-btn-icon { width: 14px; height: 14px; }
    .toc-btn-label { font-weight: 400; }
  }
</style>

<script is:inline>
  (function () {
    if (window.__toc) return;
    window.__toc = true;

    /* 窄螢幕: 把目錄鈕對齊頁首的「選單」鈕 (同高、排在它左邊) */
    function dock() {
      var btn = document.getElementById('toc-btn'), menu = document.querySelector('.sh-burger');
      if (!btn || !menu) return;
      var r = menu.getBoundingClientRect();
      if (!r.width) { btn.style.removeProperty('--toc-top'); btn.style.removeProperty('--toc-right'); return; }
      btn.style.setProperty('--toc-top', Math.round(r.top + (r.height - btn.offsetHeight) / 2) + 'px');
      btn.style.setProperty('--toc-right', Math.round(innerWidth - r.left + 8) + 'px');
    }
    addEventListener('resize', dock);

    var spy = null;   // 上一頁的 IntersectionObserver, 換頁時拆掉

    function slugify(text) {
      return text.toLowerCase().replace(/[\s\/\\.,!?"'`~()\[\]{}<>#*+=;:]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 40);
    }

    function init() {
      dock(); setTimeout(dock, 300);
      if (spy) { spy.disconnect(); spy = null; }
      var btn = document.getElementById('toc-btn'), drawer = document.getElementById('toc-drawer');
      var article = document.querySelector('article');
      if (!btn || !drawer || !article || btn.dataset.ready) return;
      btn.dataset.ready = '1';
      var list = drawer.querySelector('.toc-list');

      // 掃文章: H2 / H3, 還有 shorts 書架 (標成「現場 & 版本」)
      var items = [];
      article.querySelectorAll('.prose h2, .prose h3, .shelf').forEach(function (el) {
        var shelf = el.classList.contains('shelf'), text = shelf ? '現場 & 版本' : (el.textContent || '').trim();
        if (!text) return;
        if (!el.id) el.id = 'toc-' + slugify(text) + '-' + items.length;
        el.setAttribute('tabindex', '-1');   // 跳過去的時候焦點也移到這一節
        var level = shelf || el.tagName === 'H2' ? 2 : 3, num = null, label = text;
        if (level === 3) { var m = text.match(/^(\d+)[\.．]\s*(.*)$/); if (m) { num = m[1] + '.'; label = m[2]; } }
        items.push({ el: el, level: level, num: num, label: label });
      });
      if (!items.length) { btn.hidden = true; return; }

      list.replaceChildren.apply(list, items.map(function (it) {
        var li = document.createElement('li'), a = document.createElement('a');
        a.className = 'toc-item toc-item-l' + it.level;
        a.href = '#' + it.el.id;
        if (it.num) { var n = document.createElement('span'); n.className = 'toc-item-num'; n.textContent = it.num; a.append(n); }
        a.append(it.label);
        a.addEventListener('click', function (e) {
          e.preventDefault();
          drawer.close();
          history.replaceState(history.state, '', '#' + it.el.id);
          it.el.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
          it.el.focus({ preventScroll: true });
        });
        li.append(a);
        return li;
      }));

      function open(modal) {
        if (drawer.open) drawer.close();
        if (modal) drawer.showModal(); else drawer.show();
        btn.setAttribute('aria-expanded', 'true');
        try { localStorage.setItem('nca-toc-open', '1'); } catch (e) {}
        if (modal) { var cur = list.querySelector('[aria-current="true"]') || list.querySelector('a'); if (cur) cur.focus(); }
      }
      btn.addEventListener('click', function () { open(true); });
      drawer.querySelector('.toc-close').addEventListener('click', function () { drawer.close(); });
      // closedby="any" 不支援的瀏覽器 (Safari): 點抽屜外的暗處自己關
      if (!('closedBy' in HTMLDialogElement.prototype)) drawer.addEventListener('click', function (e) { if (e.target === drawer) drawer.close(); });
      drawer.addEventListener('close', function () {
        btn.setAttribute('aria-expanded', 'false');
        try { localStorage.setItem('nca-toc-open', '0'); } catch (e) {}
      });

      // 目前讀到哪一節: 畫面上半部、最靠上的那節
      var visible = new Set(), frame = 0;
      function mark() {
        if (frame) return;
        frame = requestAnimationFrame(function () {
          frame = 0;
          var best = null, bestTop = Infinity;
          items.forEach(function (it) {
            if (!visible.has(it.el)) return;
            var t = it.el.getBoundingClientRect().top;
            if (t < bestTop && t < innerHeight * 0.4) { bestTop = t; best = it.el; }
          });
          list.querySelectorAll('a').forEach(function (a) {
            if (best && a.hash === '#' + best.id) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
          });
        });
      }
      spy = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) visible.add(e.target); else visible.delete(e.target); });
        mark();
      }, { rootMargin: '-64px 0px -55% 0px', threshold: [0, 0.1, 0.5, 1] });
      items.forEach(function (it) { spy.observe(it.el); });

      // 桌機上次開著: 用非 modal 的側欄還原 (不鎖捲動、不搶焦點); 手機一律收著
      try { if (localStorage.getItem('nca-toc-open') === '1' && innerWidth >= 900) open(false); } catch (e) {}
    }

    // ShortsShelf 是頁面上的 script 搬進文章的, 等它搬完 (下一兩個 frame) 再掃
    document.addEventListener('astro:page-load', function () { requestAnimationFrame(function () { requestAnimationFrame(init); }); });
  })();
</script>
