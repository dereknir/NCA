---
/**
 * LiveShorts component - Displays a sequence of YouTube Shorts that auto-advance.
 * Designed for LIVE performance clips scattered across the artist's Shorts feed.
 *
 * @param shorts - Array of YouTube video IDs (in play order)
 * @param title - Optional section heading
 */
interface Props {
  shorts: string[];
  title?: string;
}

const { shorts, title = 'LIVE 版本' } = Astro.props;

if (!shorts || shorts.length === 0) return null;

const componentId = `live-shorts-${Math.random().toString(36).slice(2, 9)}`;
---

<section class="live-shorts-container" data-component-id={componentId}>
  <div class="flex items-center justify-between mb-4">
    <h2 class="flex items-center gap-2 text-2xl font-bold m-0">
      <span class="text-red-500">🎤</span>
      <span>{title}</span>
      <span class="text-sm font-normal text-gray-500 dark:text-gray-400">
        （共 {shorts.length} 段，自動連播）
      </span>
    </h2>
    <div class="text-sm text-gray-500 dark:text-gray-400">
      <span class="current-position">1</span> / {shorts.length}
    </div>
  </div>

  <div class="live-shorts-layout">
    <!-- Main player (vertical 9:16) -->
    <div class="live-shorts-player-wrap">
      <div class="live-shorts-player-frame">
        <div id={`${componentId}-player`} class="live-shorts-player"></div>
      </div>
      <div class="live-shorts-hint">
        💡 點擊播放後會自動連播下一段
      </div>
    </div>

    <!-- Thumbnails queue -->
    <div class="live-shorts-queue">
      <div class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-2 font-semibold">
        播放清單
      </div>
      <div class="live-shorts-thumbs">
        {shorts.map((id, i) => (
          <button
            type="button"
            class="live-shorts-thumb"
            data-index={i}
            data-video-id={id}
            aria-label={`播放第 ${i + 1} 段`}
          >
            <div class="live-shorts-thumb-image">
              <img
                src={`https://img.youtube.com/vi/${id}/hqdefault.jpg`}
                alt={`第 ${i + 1} 段`}
                loading="lazy"
              />
              <span class="live-shorts-thumb-number">{i + 1}</span>
            </div>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .live-shorts-container {
    margin: 3rem 0;
    padding: 1.5rem;
    background: linear-gradient(135deg, #1e1e2e 0%, #2d2d44 100%);
    border-radius: 1rem;
    color: white;
  }
  .live-shorts-container h2 {
    color: white;
  }

  .live-shorts-layout {
    display: grid;
    grid-template-columns: minmax(280px, 360px) 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .live-shorts-player-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .live-shorts-player-frame {
    position: relative;
    aspect-ratio: 9 / 16;
    background: #000;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .live-shorts-player {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .live-shorts-player iframe {
    width: 100% !important;
    height: 100% !important;
    border: 0;
  }

  .live-shorts-hint {
    font-size: 0.75rem;
    text-align: center;
    opacity: 0.6;
  }

  .live-shorts-queue {
    min-width: 0;
  }

  .live-shorts-thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
    gap: 0.5rem;
    max-height: 480px;
    overflow-y: auto;
    padding-right: 0.25rem;
  }
  .live-shorts-thumbs::-webkit-scrollbar {
    width: 6px;
  }
  .live-shorts-thumbs::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
  }

  .live-shorts-thumb {
    background: transparent;
    border: 2px solid transparent;
    padding: 0;
    cursor: pointer;
    border-radius: 0.5rem;
    overflow: hidden;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .live-shorts-thumb:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.4);
  }
  .live-shorts-thumb.active {
    border-color: #ef4444;
    box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.3);
  }

  .live-shorts-thumb-image {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .live-shorts-thumb-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .live-shorts-thumb-number {
    position: absolute;
    bottom: 4px;
    left: 4px;
    background: rgba(0, 0, 0, 0.7);
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 4px;
  }
  .live-shorts-thumb.active .live-shorts-thumb-number {
    background: #ef4444;
  }

  @media (max-width: 768px) {
    .live-shorts-layout {
      grid-template-columns: 1fr;
    }
    .live-shorts-player-wrap {
      max-width: 320px;
      margin: 0 auto;
    }
    .live-shorts-thumbs {
      max-height: 240px;
    }
  }
</style>

<script>
  interface YTPlayerLike {
    loadVideoById: (id: string) => void;
    playVideo: () => void;
    destroy: () => void;
  }
  interface YTStateEvent { data: number }

  declare global {
    interface Window {
      YT?: {
        Player: new (
          el: HTMLElement | string,
          opts: Record<string, unknown>
        ) => YTPlayerLike;
        PlayerState: { ENDED: number };
        loaded?: number;
      };
      onYouTubeIframeAPIReady?: () => void;
    }
  }

  const YT_ENDED = 0;

  function loadYouTubeAPI(): Promise<void> {
    return new Promise(resolve => {
      if (window.YT && window.YT.Player) {
        resolve();
        return;
      }
      if (!document.querySelector('script[src*="youtube.com/iframe_api"]')) {
        const tag = document.createElement('script');
        tag.src = 'https://www.youtube.com/iframe_api';
        document.body.appendChild(tag);
      }
      const prev = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = () => {
        prev?.();
        resolve();
      };
    });
  }

  function initLiveShorts(root: HTMLElement) {
    const componentId = root.dataset.componentId;
    if (!componentId) return;

    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('.live-shorts-thumb'));
    const positionEl = root.querySelector<HTMLElement>('.current-position');
    const playerEl = document.getElementById(`${componentId}-player`);
    if (!playerEl || thumbs.length === 0) return;

    const shortIds = thumbs.map(t => t.dataset.videoId || '');
    let currentIndex = 0;
    let player: YTPlayerLike | null = null;

    function setActive(index: number) {
      currentIndex = index;
      thumbs.forEach((thumb, i) => thumb.classList.toggle('active', i === index));
      if (positionEl) positionEl.textContent = String(index + 1);
    }

    function playAt(index: number) {
      if (index < 0 || index >= shortIds.length) return;
      setActive(index);
      if (player) {
        player.loadVideoById(shortIds[index]);
      }
    }

    loadYouTubeAPI().then(() => {
      if (!window.YT) return;
      player = new window.YT.Player(playerEl, {
        videoId: shortIds[0],
        playerVars: {
          rel: 0,
          modestbranding: 1,
          playsinline: 1,
        },
        events: {
          onStateChange: (event: YTStateEvent) => {
            if (event.data === YT_ENDED) {
              const next = currentIndex + 1;
              if (next < shortIds.length) {
                playAt(next);
              }
            }
          },
        },
      });
      setActive(0);
    });

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', () => playAt(i));
    });
  }

  function bootstrap() {
    document.querySelectorAll<HTMLElement>('.live-shorts-container[data-component-id]').forEach(root => {
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';
      initLiveShorts(root);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootstrap);
  } else {
    bootstrap();
  }
</script>
