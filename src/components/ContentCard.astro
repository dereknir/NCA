---
/**
 * ContentCard 組件 - 通用內容卡片
 * @param title - 卡片標題
 * @param href - 連結地址
 * @param description - 描述文字（可選）
 * @param image - 圖片 URL（可選）
 * @param date - 日期（可選）
 * @param tags - 標籤陣列（可選）
 * @param subtitle - 副標題（可選）
 */
import TagList from './TagList.astro';
import DateDisplay from './DateDisplay.astro';

interface Props {
  title: string;
  href: string;
  description?: string;
  image?: string;
  date?: Date | string;
  tags?: string[];
  subtitle?: string;
}

const { title, href, description, image, date, tags, subtitle } = Astro.props;
---

<a
  href={href}
  class="px-card block bg-white dark:bg-gray-800 overflow-hidden group"
>
  {image && (
    <div class="aspect-video overflow-hidden">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </div>
  )}

  <div class="p-6">
    {subtitle && (
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">{subtitle}</p>
    )}

    <h3 class="text-xl font-semibold mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
      {title}
    </h3>

    {description && (
      <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-2">
        {description}
      </p>
    )}

    {date && (
      <div class="mb-3">
        <DateDisplay date={date} format="long" class="text-sm text-gray-500" />
      </div>
    )}

    {tags && tags.length > 0 && (
      <TagList tags={tags} variant="secondary" size="sm" />
    )}
  </div>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
