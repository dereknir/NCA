---
/**
 * FullLivePlayer — 完整 Live 播放器: 直式舞台 / 逐句歌詞 / 片段清單 + 底部時間軸
 *
 * 兩個 YouTube 播放器輪流用: 下一段提早在背景靜音載好、停在切入點, 時間到按播放接上 (中間蓋一層雜訊轉場)。
 * 排段規則在 src/lib/fullLive.ts; 某支播不了就從當下那句重排, 不整段跳過。
 * ?mock=1 換成假播放器 (自動測試用, 參數見 mockPlayer)。
 */
import type { FLSong } from '../lib/fullLive';

interface Props { song: FLSong }
const { song } = Astro.props;
---

<div class="flp" data-flp data-song={JSON.stringify(song)}>
  <div class="flp-main">
    <div>
      <div class="flp-stage" data-stage>
        <div class="flp-pl" data-pl="0"><div></div></div>
        <div class="flp-pl" data-pl="1"><div></div></div>
        <div class="flp-nosig" data-nosig><div><b>NO SIGNAL</b>這句還沒有人拍到<br><span data-nosig-t></span></div></div>
        <div class="flp-crt"></div>
        <canvas class="flp-noise" data-noise width="90" height="160"></canvas>
        <div class="flp-osd"><span class="rec" data-osd-l>LIVE</span><span data-osd-r>— / —</span></div>
        <div class="flp-osd-big" data-osd-big></div>
        <div class="flp-cap" data-cap></div>
        <button class="flp-start" data-start type="button"><div><span>▶ 播放</span>從第一句聽到最後一句</div></button>
      </div>
      <div class="flp-ctl">
        <button data-prev type="button">‹ 上一段</button>
        <button data-play type="button">⏸ 暫停</button>
        <button data-next type="button">下一段 ›</button>
      </div>
    </div>
    <div class="flp-lyr" data-lyr><div class="flp-lyr-in" data-lyr-in></div></div>
    <div class="flp-list" data-list role="group" aria-label="這首歌的片段"></div>
  </div>
  <div class="flp-track-h"><span><b data-now>0:00</b> / <span data-all>0:00</span></span></div>
  <div class="flp-track" data-track></div>
  <p class="flp-legend">點格子、片段或歌詞都可以直接跳過去</p>
</div>

<style is:global>
  /* 舞台高度跟著視窗: 筆電上底下的按鈕也要看得到; 寬度照 9:16 */
  .flp { --flp-h: clamp(480px, calc(100svh - 220px), 640px); --flp-stage: calc(var(--flp-h) * 9 / 16); --glow: 255 140 105; margin-top: 8px; }
  .flp-main { display: grid; grid-template-columns: var(--flp-stage) minmax(0, 1fr) 280px; gap: 40px; align-items: start; }

  .flp-stage { position: relative; width: var(--flp-stage); height: var(--flp-h); background: #000; border: 2px solid var(--sh-line);
    box-shadow: 0 0 0 6px #0b0b16, 0 0 80px rgb(var(--glow) / .35); transition: box-shadow .4s; overflow: hidden; }
  .flp-stage.alt { box-shadow: 0 0 0 6px #0b0b16, 0 0 80px rgb(182 194 224 / .25); }
  .flp-pl { position: absolute; inset: 0; opacity: 0; transition: opacity .12s; }
  .flp-pl.on { opacity: 1; }
  .flp-pl iframe, .flp-pl > div { width: 100%; height: 100%; border: 0; pointer-events: none; }
  .flp-crt { position: absolute; inset: 0; pointer-events: none; z-index: 3;
    background: repeating-linear-gradient(0deg, rgb(0 0 0 / .22) 0 1px, transparent 1px 3px),
                radial-gradient(120% 90% at 50% 50%, transparent 60%, rgb(0 0 0 / .55)); mix-blend-mode: multiply; }
  .flp-noise { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 4; image-rendering: pixelated; opacity: 0; pointer-events: none; }
  .flp-noise.on { opacity: 1; }
  .flp-osd { position: absolute; z-index: 5; left: 14px; top: 12px; right: 14px; display: flex; justify-content: space-between;
    font: 12px var(--sh-px); color: var(--sh-ink); text-shadow: 0 0 6px rgb(0 0 0 / .9), 1px 1px 0 #000; pointer-events: none; }
  .flp-osd .rec::before { content: '●'; color: #ff4d4d; margin-right: 4px; animation: sh-blink 1s steps(2) infinite; }
  .flp-stage.alt .flp-osd span:first-child { background: var(--sh-ink2); color: #0a0a15; padding: 0 6px; text-shadow: none; }
  .flp-osd-big { position: absolute; z-index: 5; inset: 0; display: grid; place-items: center; pointer-events: none;
    font: 36px var(--sh-px); color: #fff; text-shadow: 3px 3px 0 #000, 0 0 18px rgb(var(--glow) / .9); opacity: 0; }
  .flp-osd-big.on { opacity: 1; }
  .flp-cap { position: absolute; z-index: 5; left: 0; right: 0; bottom: 0; padding: 32px 14px 12px; color: var(--sh-ink);
    background: linear-gradient(transparent, rgb(0 0 0 / .85)); font: 12px/1.6 var(--sh-pxja); pointer-events: none; }
  .flp-nosig { position: absolute; inset: 0; z-index: 2; display: none; place-items: center; text-align: center;
    font: 12px/1.6 var(--sh-px); color: var(--sh-ink2); background: #050509; }
  .flp-nosig.on { display: grid; }
  .flp-nosig b { display: block; font: 24px var(--sh-px); color: var(--sh-ink); letter-spacing: .1em; margin-bottom: 6px; }
  .flp-start { position: absolute; inset: 0; z-index: 6; display: grid; place-items: center; background: rgb(5 5 10 / .72);
    cursor: pointer; border: 0; color: var(--sh-ink2); font: 12px/1.6 var(--sh-px); }
  .flp-start span { display: block; font: 24px var(--sh-px); color: #fff; margin-bottom: 8px; }
  .flp-start[hidden] { display: none; }
  .flp-start:disabled { cursor: progress; }
  .flp-ctl { display: flex; gap: 8px; margin-top: 16px; }
  .flp-ctl button { flex: 1; font: 12px var(--sh-px); color: var(--sh-ink); background: rgb(10 10 21 / .6); border: 2px solid var(--sh-line);
    padding: 8px 10px; cursor: pointer; }
  .flp-ctl button:hover { border-color: var(--sh-gold); }

  .flp-lyr { height: var(--flp-h); overflow: hidden; position: relative; mask-image: linear-gradient(transparent, #000 16%, #000 82%, transparent); }
  .flp-lyr.top { mask-image: linear-gradient(#000 82%, transparent); }   /* 第一句貼在最上面: 上緣不淡出 */
  .flp-lyr.end { mask-image: linear-gradient(transparent, #000 16%); }   /* 最後一句貼在最下面: 下緣不淡出 */
  .flp-lyr.top.end { mask-image: none; }
  @media (min-width: 761px) { .flp-lyr { margin-left: 28px; } }          /* 歌詞跟舞台拉開一點, 不要貼著 */
  .flp-lyr-in { transition: transform .5s cubic-bezier(.2,.7,.2,1); padding: 300px 0; }
  .flp-ln { position: relative; padding: 8px 0 8px 22px; color: var(--sh-ink3); transition: color .3s; cursor: pointer; }
  .flp-ln::before { content: ''; position: absolute; left: 0; top: 10px; bottom: 10px; width: 4px; background: var(--c, var(--sh-line)); opacity: .4; }
  .flp-ln .ja { font: 24px/1.45 var(--sh-pxja); display: block; }
  /* 中文行比日文淡一階。原本用 opacity .85, 疊在底色上只剩 4.35:1 不到 AA;
     改成直接給顏色: 一般行調到 4.7:1 (看起來幾乎一樣), 唱過 / 正在唱的兩種照原本疊出來的顏色寫死 */
  .flp-ln .zh { font: 12px/1.7 var(--sh-px); display: block; color: #717c99; transition: color .3s; }
  .flp-ln.past { color: #464f6b; }
  .flp-ln.past .zh { color: #3d455e; }
  .flp-ln.cur { color: #fff; }
  .flp-ln.cur .ja { font-size: 36px; text-shadow: 0 0 22px rgb(var(--glow) / .5); }
  .flp-ln.cur .zh { color: #9ca6c2; }
  .flp-ln.cur::before { opacity: 1; box-shadow: 0 0 14px var(--c); }
  .flp-ln.gap .ja::after { content: ' ── 還沒有人拍到'; font: 12px var(--sh-px); color: var(--sh-ink3); }
  .flp-ln.skip { cursor: default; opacity: .45; }
  .flp-ln.skip .ja::after { content: ' ── 沒有 short 拍到，跳過'; font: 12px var(--sh-px); color: var(--sh-ink3); }
  /* 換段記號: 色條上一個發光的方塊 (剪接點), 往右一條淡出的虛線 — 鏡頭換了, 不用文字講。
     影片名稱 / 觀看數寬版右邊清單有, 這裡只給螢幕閱讀器; 清單看不到的版面 (≤1180px / ?embed=1) 才在虛線前顯示一行小字 */
  .flp-seam { position: relative; height: 26px; margin-top: 6px; }
  .flp-seam::before { content: ''; position: absolute; left: -2px; top: 9px; width: 8px; height: 8px; background: var(--c); box-shadow: 0 0 10px var(--c); }
  .flp-seam::after { content: ''; position: absolute; left: 16px; right: 35%; top: 12px; height: 2px; opacity: .55;
    background: repeating-linear-gradient(90deg, var(--c) 0 6px, transparent 6px 12px);
    -webkit-mask-image: linear-gradient(90deg, #000, transparent); mask-image: linear-gradient(90deg, #000, transparent); }
  .flp-seam > span, .flp-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .flp-seam.first { height: 0; margin: 0; }              /* 第 1 段: 寬版不畫記號, 文字留給螢幕閱讀器 */
  .flp-seam.first::before, .flp-seam.first::after { display: none; }
  .flp-kind { font-style: normal; color: #0a0a15; background: var(--sh-ink2); padding: 0 6px; letter-spacing: .04em; }

  .flp-list { height: var(--flp-h); overflow: auto; display: flex; flex-direction: column; gap: 8px; padding-left: 2px; }
  .flp-it { display: grid; grid-template-columns: 54px 1fr; gap: 10px; padding: 8px; border: 2px solid transparent; background: rgb(15 15 29 / .7);
    cursor: pointer; text-align: left; color: var(--sh-ink2); font: 12px/1.5 var(--sh-px); position: relative; }
  .flp-it::before { content: ''; position: absolute; left: -2px; top: -2px; bottom: -2px; width: 4px; background: var(--c); }
  .flp-it img { width: 54px; height: 96px; object-fit: cover; filter: saturate(.8); background: #111; }
  .flp-it b { display: block; font-weight: 400; color: var(--c); }
  .flp-it .t { color: var(--sh-ink); font-family: var(--sh-pxja); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .flp-it .m { color: var(--sh-ink3); }
  .flp-it.cur { border-color: var(--c); background: rgb(25 25 45 / .9); }
  .flp-it.done { opacity: .5; }

  .flp-track-h { display: flex; justify-content: flex-end; margin: 32px 0 8px; font: 12px var(--sh-px); color: var(--sh-ink2); }
  .flp-track-h b { color: var(--sh-gold); font-weight: 400; }
  .flp-track { position: relative; display: flex; gap: 3px; height: 48px; }
  /* 最窄 24px: 手機上短的段落 (MC、轉場) 也點得到; 320 寬塞 11 段時讓一點, 不擠出軌道 */
  .flp-seg { position: relative; flex: var(--w) 1 0; min-width: min(24px, calc((100vw - 62px) / 11)); background: #111 center / cover no-repeat; cursor: pointer; overflow: hidden; border: 0; padding: 0; }
  .flp-seg::after { content: attr(data-n); position: absolute; left: 6px; top: 4px; font: 12px var(--sh-px); color: #fff; text-shadow: 1px 1px 0 #000; }
  .flp-seg > .bar { position: absolute; left: 0; right: 0; bottom: 0; height: 5px; background: var(--c); z-index: 1; }
  .flp-seg.gap { background: repeating-linear-gradient(45deg, #1a1f33 0 4px, #0d1020 4px 8px); }
  .flp-seg.done { filter: saturate(.4) brightness(.6); }
  .flp-seg.cur { outline: 2px solid #fff; outline-offset: 2px; z-index: 1; }
  .flp-seg .fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: rgb(255 255 255 / .22); }
  .flp-head { position: absolute; top: -6px; bottom: -6px; width: 2px; background: #fff; box-shadow: 0 0 8px #fff; left: 0; pointer-events: none; z-index: 2; }
  .flp-legend { margin: 10px 0 0; font: 12px var(--sh-px); color: var(--sh-ink3); }

  /* ?embed=1 (N247i ワンセグ 的大螢幕裡): 只留舞台 + 歌詞, 塞滿整個視窗 */
  .flp-embed, .flp-embed body { background: #05050b !important; overflow: hidden; }
  .flp-embed .sh-hd, .flp-embed .sh-hero, .flp-embed .site-footer, .flp-embed .sh-cli, .flp-embed .flp-list,
  .flp-embed .flp-legend, .flp-embed .flp-track-h, .flp-embed .flp-track { display: none !important; }
  .flp-embed main { padding: 0 !important; margin: 0 !important; max-width: none !important; }
  .flp-embed .flp { --flp-h: calc(100vh - 76px); margin: 0; padding: 12px 16px 0; }
  .flp-embed .flp-main { grid-template-columns: calc(var(--flp-h) * 9 / 16) minmax(0, 1fr) !important; gap: 24px; }
  .flp-embed .flp-stage { width: calc(var(--flp-h) * 9 / 16) !important; height: var(--flp-h) !important; aspect-ratio: auto !important; margin: 0 !important; }
  .flp-embed .flp-ctl { margin: 10px 0 0 !important; max-width: none !important; }
  .flp-embed .flp-ctl button { white-space: nowrap; padding: 8px 4px; }
  .flp-embed .flp-lyr { display: block !important; height: calc(var(--flp-h) + 48px) !important; }
  .flp-embed .flp-lyr-in { padding: 40vh 0 !important; }
  .flp-embed .flp-seam { display: flex; align-items: center; gap: 10px; height: auto; min-height: 26px; padding-left: 16px; }
  .flp-embed .flp-seam.first::before, .flp-embed .flp-seam.first::after { display: block; }
  .flp-embed .flp-seam::after { position: static; flex: 1 1 24px; min-width: 24px; }
  .flp-embed .flp-seam > span { position: static; width: auto; height: auto; clip-path: none; text-overflow: ellipsis; max-width: 80%;
    font: 12px var(--sh-px); color: var(--c); letter-spacing: .04em; }
  .flp-embed .flp-seam span[lang] { font-family: var(--sh-pxja); }
  .flp-embed .flp-seam i { font-style: normal; color: var(--sh-ink3); }
  @media (max-aspect-ratio: 1/1) {   /* 直的視窗 (手機): 只放舞台 */
    .flp-embed .flp { --flp-h: calc(100vh - 76px); }
    .flp-embed .flp-main { grid-template-columns: 1fr !important; justify-items: center; }
    .flp-embed .flp-stage { width: min(calc(var(--flp-h) * 9 / 16), 100%) !important; height: auto !important; aspect-ratio: 9 / 16 !important; }
    .flp-embed .flp-lyr { display: none !important; }
  }

  @media (max-width: 1180px) {
    .flp-main { grid-template-columns: var(--flp-stage) minmax(0, 1fr); }
    .flp-list { display: none; }
    /* 右邊清單藏起來了: 換段記號旁顯示這段的影片名稱 / 觀看數 */
    .flp-seam, .flp-seam.first { display: flex; align-items: center; gap: 10px; height: auto; min-height: 26px; padding-left: 16px; }
    .flp-seam.first::before, .flp-seam.first::after { display: block; }
    .flp-seam::after { position: static; flex: 1 1 24px; min-width: 24px; }
    .flp-seam > span { position: static; width: auto; height: auto; clip-path: none; text-overflow: ellipsis; max-width: 80%;
      font: 12px var(--sh-px); color: var(--c); letter-spacing: .04em; }
    .flp-seam span[lang] { font-family: var(--sh-pxja); }
    .flp-seam i { font-style: normal; color: var(--sh-ink3); }
  }
  @media (max-width: 760px) {
    .flp-main { grid-template-columns: 1fr; gap: 20px; }
    .flp-stage { width: min(360px, 100%); height: auto; aspect-ratio: 9 / 16; margin: 0 auto; }
    .flp-ctl { max-width: 360px; margin: 16px auto 0; }
    .flp-lyr { height: 320px; }
    .flp-lyr-in { padding: 130px 0; }
    .flp-ln.cur .ja { font-size: 24px; }
  }
</style>

<script>
  import { plan, type FLSong, type FLSeg } from '../lib/fullLive';

  declare const YT: any;
  type Seg = FLSeg & { color: string };
  type RealSeg = Extract<Seg, { v: string }>;            // 不是「還沒有人拍到」的空白段
  type Player = {
    loadVideoById(o: { videoId: string; startSeconds: number }): void; playVideo(): void; pauseVideo(): void;
    seekTo(s: number, a?: boolean): void; getCurrentTime(): number | undefined; getPlayerState(): number | undefined;
    getDuration(): number | undefined; mute(): void; unMute(): void; setVolume(v: number): void;
  };

  const Q = new URLSearchParams(location.search), MOCK = Q.has('mock'), SPEED = MOCK ? +(Q.get('speed') || 1) : 1;
  const COLORS = ['#ff8c69', '#5ca8ff', '#e8c94a', '#46be6e', '#c86ef0', '#60e0d2', '#f064a0', '#ffb347'];
  const LEAD = 2.5;       // 下一段提早幾秒在背景載入, 載好後停在切入點等
  const XF = 0.12;        // 換段時兩段最多重疊 (交叉淡化) 幾秒 — 只用新段第一句前的換氣, 起音貼著切入點的段不重疊
  const HOLD = 1.2;       // 時間到了下一段還沒準備好: 目前這段最多再多播幾秒等它 (只在 seg.safe 以內, 不會播到下一句)
  const FADE = 0.12;      // 段落淡入 / 淡出幾秒 (切點都在換氣處, 只修掉喀一聲)
  const FADE_END = 2;     // 整首最後一段最多淡出幾秒 (只淡人聲唱完後的尾巴, 見 seg.sung)
  const hex2rgb = (h: string) => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16)).join(' ');
  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  const views = (n: number) => n >= 10000 ? (n / 10000).toFixed(1).replace(/\.0$/, '') + ' 萬次觀看' : n + ' 次觀看';
  const esc = (s: string) => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  // iPhone 不能用 JS 調音量 (只能靜音 / 取消靜音), 也同時只准一支影片有聲音: 不做交叉淡化, 在切點直接換
  const IOS = MOCK && Q.has('ios'), BLOCK = MOCK && Q.has('block');
  let volLocked = IOS || (!MOCK && /iPhone|iPod/.test(navigator.userAgent));
  if (!MOCK) try { const v = document.createElement('video'); v.volume = 0.5; setTimeout(() => { if (v.volume !== 0.5) volLocked = true; }, 200); } catch (e) {}

  /* ---------- 自動測試用的假播放器 (?mock=1) ----------
   * 照真的 YouTube IFrame API 的行為做, 不然測不出問題:
   *   load* 一呼叫, getCurrentTime() / getPlayerState() 先變 undefined (widget 清空快取), 0.4 秒後才開播; 剛載入時下的暫停壓不住
   *   從暫停 playVideo(): 聲音 10 ms 就出來, 但 0.27 秒後才回報 1 (Chrome 等第一個 timeupdate), 這段 getCurrentTime() 停住
   *   unMute() 會把音量拉到至少 5
   * &speed=N 快轉 / &fail=<videoId> 載入 0.3 秒後 onError / &fastresume 恢復播放馬上回報 1 (Firefox) / &load=<ms> 載入多久
   * &short=<秒> 影片實際比資料的 dur 短 / &loopend 片尾自己跳回開頭 (嵌入的 Shorts, 不報 ENDED) / &nodur getDuration() 讀不到
   * &stuck=<videoId> 載入後一直停在 -1、也不報錯
   * &ios 音量鎖住 + 同時只准一支有聲音 (iPhone) / &block 沒在點擊裡碰過的播放器不准有聲播放 (Safari)
   * window.__flpMock.probe() 讀得到每支「真正」播到哪、實際音量多少 */
  type Mock = Player & { probe(): { v: string; t: number; on: boolean; vol: number } };
  let gesture = false;
  if (BLOCK) document.addEventListener('click', () => { gesture = true; setTimeout(() => { gesture = false; }); }, true);
  function mockPlayer(el: HTMLElement, peers: Mock[], durOf: (v: string) => number,
                      ev: { error(p: Player): void; blocked(p: Player): void }): Mock {
    const now = () => performance.now(), wait = (f: () => void, ms: number) => window.setTimeout(f, ms / SPEED);
    let vid = '', pos = 0, at = 0, on = false, vol = 100, muted = false, unlocked = false, loading = 0, reports: number[] = [];
    let info: { st?: number; ct?: number; at?: number } = {};
    el.style.cssText = 'width:100%;height:100%;background:#111 center/cover';
    const cur = () => on ? pos + Math.max(0, now() - at) / 1000 * SPEED : pos;
    const tell = (st: number, ms: number) => { reports.push(wait(() => { info = { st, ct: cur(), at: now() }; }, ms)); };
    const hush = () => { reports.forEach(clearTimeout); reports = []; };
    const touch = () => { if (gesture) unlocked = true; };
    const locked = () => BLOCK && !unlocked && !gesture;
    const halt = () => { pos = cur(); on = false; hush(); tell(2, 5); };
    const solo = () => { if (IOS && on && !muted) peers.forEach(o => { const x = o.probe(); if (o !== api && x.on && x.vol > 0) o.pauseVideo(); }); };
    const len = () => durOf(vid) - +(Q.get('short') || 0);
    setInterval(() => {                                   // 播到片尾 / 每 250 ms 回報一次時間 (timeupdate)
      if (on && cur() >= len()) {
        if (Q.has('loopend')) { pos = 0; at = now(); }
        else { pos = len(); on = false; hush(); info = { st: 0, ct: pos, at: now() }; }
      } else if (on && info.st === 1 && now() - (info.at ?? 0) >= 250 / SPEED) info = { st: 1, ct: cur(), at: now() };
    }, 20);
    const api: Mock = {
      loadVideoById({ videoId, startSeconds }) {
        touch(); hush(); clearTimeout(loading);
        vid = videoId; pos = startSeconds || 0; on = false; info = {};
        el.style.backgroundImage = `url(https://i.ytimg.com/vi/${vid}/hqdefault.jpg)`;
        tell(-1, 30);
        if (Q.get('stuck') === videoId) { loading = -1; return; }   // 一直卡在 -1, 也不報錯
        loading = wait(() => {
          loading = 0;
          if (!muted && locked()) return ev.blocked(api);
          on = true; at = now(); info = { st: 1, ct: pos, at: now() }; solo();
        }, +(Q.get('load') || 400));
        if (Q.get('fail') === videoId) wait(() => ev.error(api), 300);
      },
      playVideo() {
        touch();
        if (on || loading) return;
        if (!muted && locked()) { wait(() => ev.blocked(api), 5); return; }
        pos = cur(); at = now() + 10 / SPEED; on = true; hush(); solo();
        tell(3, 8); tell(1, Q.has('fastresume') ? 30 : 270);
      },
      pauseVideo() { touch(); if (on) halt(); },
      seekTo(s) { touch(); pos = s; at = now() + (on ? 10 / SPEED : 0); tell(on ? 1 : info.st == null || info.st === -1 ? -1 : 2, 10); },
      getCurrentTime: () => info.ct == null ? undefined : info.ct + (info.st === 1 ? Math.min(1, (now() - info.at!) / 1000 * SPEED) : 0),
      getPlayerState: () => info.st,
      getDuration: () => vid && !Q.has('nodur') ? len() : undefined,
      mute() { touch(); muted = true; },
      unMute() {
        touch(); muted = false; vol = Math.max(5, vol);
        if (on && locked()) { halt(); wait(() => ev.blocked(api), 5); } else solo();
      },
      setVolume(v) { if (v > 0) touch(); if (!IOS) vol = v; },
      probe: () => ({ v: vid, t: cur(), on: on && now() >= at, vol: muted ? 0 : IOS ? 1 : vol / 100 }),
    };
    return api;
  }

  function mount(root: HTMLElement) {
    const song: FLSong = JSON.parse(root.dataset.song!);
    const q = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)! as unknown as T;
    const stage = q('[data-stage]'), lyrIn = q('[data-lyr-in]'), lyr = q('[data-lyr]'), list = q('[data-list]'), track = q('[data-track]');
    const startBtn = q<HTMLButtonElement>('[data-start]'), playBtn = q('[data-play]'), cap = q('[data-cap]');
    const osdL = q('[data-osd-l]'), osdR = q('[data-osd-r]'), osdBig = q('[data-osd-big]'), nosig = q('[data-nosig]');
    const plEls = [...root.querySelectorAll<HTMLElement>('[data-pl]')];

    // pre = 背景預載的下一段: parked = 已經緩衝好、停在切入點 (parkedAt = 停好的時間); fired = 按下播放的時間 (0 = 還沒);
    //       vol = 它現在的音量; oe = 按了之後上一段淡完的時間 (上一段的時間軸);
    //       r2 = 停好時離切點還夠完整淡出 (之後這段照一般換段在 end 前淡完, 不再多播到 safe)
    let segs: Seg[] = [], bad = new Set<string>(), k = -1, act = 0;
    let pre: { n: number; p: number; v: string; parked: boolean; parkedAt?: number; fired: number; vol?: number; oe?: number; r2?: boolean } | null = null;
    let out: { p: number; end: number; v: number } | null = null;    // 交叉淡化中、正在淡出的上一段 (v = 目前音量上限, 淡出不會回升)
    // kick[i] = 剛對停住的第 i 支按了播放 (見 pos()): st0 = 按的當下回報的狀態, ack = 之後狀態變過 (播放器收到了), m = 拿來量 lat
    const kick: ({ at: number; from: number; m: boolean; st0?: number; ack: boolean } | null)[] = [null, null];
    const lastT = [NaN, NaN];                              // 每支上一拍 (播放中) 的時間 (抓影片自己跳回開頭)
    const movedAt = [0, 0];                                // 上次對第 i 支 load / seek 的時間: 之後一陣子回報的時間可能還是舊的
    let lat = 0.06, fireTimer = 0;                         // lat = 按播放到真的出聲的延遲 (實測, 決定要提早多少按)
    let curLim = Infinity;                                 // 這段已經開始淡出時, 對準的淡完時間 (上一拍算的; 還沒在淡 = Infinity)
    let paused = false, lost = false, tapped = false, gate: number | null = null, gateFix = false, seen = { t: NaN, at: 0 };
    let gapT0 = 0, gapAt = 0, durs: number[] = [], curLine = -2, vol = -1;
    let players: Player[] = [], ready: Promise<void> = Promise.resolve(), isReady = MOCK;
    const segDur = (s: FLSeg) => s.gap ? s.len : s.end - s.start;
    // 新段第一句起音前的換氣: 淡入 / 跟上一段重疊都只用這一段 (淡入在起音前 0.05 秒就到滿)。
    // 起音貼著切入點 (連唱 / 影片一開頭就在唱) 就不淡入也不重疊, 免得吃掉第一個字
    const finOf = (s: RealSeg) => Math.min(FADE, s.cues[0][1] - s.start - 0.05);
    const fadeIn = (s: RealSeg, t: number) => { const f = finOf(s); return f <= 0.03 ? (t >= s.start - 0.02 ? 1 : 0) : (t - s.start) / f; };
    const overlapOf = (s: RealSeg) => volLocked ? 0 : Math.min(XF, Math.max(0, s.cues[0][1] - s.start - 0.03));
    const level = (x: number) => Math.round(100 * Math.max(0, Math.min(1, x)));
    let ahead = 0.025 * SPEED;     // 音量一拍 (~25 ms) 才調一次: 照下一拍的位置算, 淡出才會在切點前真的到 0 (拍子變粗就看更遠)

    // 影片實際長度常比資料的 dur 短 0.02–0.5 秒 (嵌入的 Shorts 還會在片尾前自己跳回開頭, 不報 ENDED): 用播放器回報的長度封頂。
    // 要接下一段的留 0.1 秒 (下一段要在片尾前起播); 最後一段只留一拍 (只要在片尾前淡完, 留多了會淡到最後一個字)
    function clip(i: number, s: RealSeg) {
      const D = players[i].getDuration?.(), m = s === segs[segs.length - 1] ? 0.03 : 0.1, M = D && D > s.start + 1 ? D - m : Infinity;
      return { end: Math.min(s.end, M), safe: Math.min(s.safe, M) };
    }
    function load(i: number, v: string, at: number) { movedAt[i] = performance.now(); players[i].loadVideoById({ videoId: v, startSeconds: at }); }
    function seek(i: number, at: number) { movedAt[i] = performance.now(); players[i].seekTo(at, true); }
    /** 丟掉預載 (已經按了播放的那支還在出聲, 要先停) */
    function dropPre() {
      if (!pre) return;
      try { players[pre.p].pauseVideo(); players[pre.p].mute(); } catch (e) {}
      kick[pre.p] = null; pre = null;
    }

    /* ---------- 播放器 ---------- */
    function onPlayerError(p: Player) {
      if (k < 0) return;
      if (p === players[act] && !segs[k].gap) {
        if (paused) { lost = true; return; }                 // 暫停中不開播替代段: 按繼續時才換
        return recover();
      }
      // 背景預載的下一段出錯: 現在就換人, 不要等切過去才卡住
      if (pre && players[pre.p] === p) {
        bad.add(pre.v); dropPre();
        build([...segs.slice(0, k + 1), ...plan(song, bad, segs[k].to + 1)]);
        mark(k);
      }
    }
    function onBlocked(p: Player) {
      if (k >= 0 && (p === players[act] || (pre && pre.fired && players[pre.p] === p))) needTap();
    }
    if (MOCK) {
      const mocks: Mock[] = [], durOf = (v: string) => song.shorts.find(x => x.v === v)?.dur ?? 1e9;
      players = plEls.map(el => { const m = mockPlayer(el.firstElementChild as HTMLElement, mocks, durOf, { error: onPlayerError, blocked: onBlocked }); mocks.push(m); return m; });
      (window as any).__flpMock = { probe: () => mocks.map(m => m.probe()), segs: () => segs,
        state: () => ({ k, act, lat, paused, worker: !!tw, pre: pre && { n: pre.n, parked: pre.parked, fired: !!pre.fired } }),
        sysPause: () => mocks[act].pauseVideo(), sysPlay: () => mocks[act].playVideo() };   // 模擬系統 / 媒體鍵在背後暫停 / 播放
    } else ready = new Promise(res => {
      const make = () => {
        let n = 0;
        const opts = { width: '100%', height: '100%',
          playerVars: { controls: 0, playsinline: 1, rel: 0, modestbranding: 1, iv_load_policy: 3, disablekb: 1, fs: 0, origin: location.origin },
          events: { onReady: () => { if (++n === 2) res(); }, onError: (e: any) => onPlayerError(e.target),
                    onAutoplayBlocked: (e: any) => onBlocked(e.target) } };
        players = plEls.map(el => new YT.Player(el.firstElementChild, opts));
      };
      if ((window as any).YT?.Player) return make();
      const prev = (window as any).onYouTubeIframeAPIReady;
      (window as any).onYouTubeIframeAPIReady = () => { prev?.(); make(); };
      const s = document.createElement('script'); s.src = 'https://www.youtube.com/iframe_api'; document.head.append(s);
    });

    /** 第 i 支現在播到哪。我們對停住的播放器按播放後, Chrome / Edge 會先回報 3、等 ~0.27 秒 (第一個 timeupdate) 才回報 1,
     *  這段 getCurrentTime() 停住不動, 聲音卻 ~20 ms 就出來了 → 用牆鐘推算 (最多 0.4 秒); 收到 1 就改回 API 的時間, 順便量 lat */
    function pos(i: number): number | undefined {
      const p = players[i], t = p.getCurrentTime(), r = kick[i];
      if (!r || t == null) return t;
      const st = p.getPlayerState(), d = (performance.now() - r.at) / 1000 * SPEED;
      if (st !== r.st0) r.ack = true;                      // 按之前的舊狀態 (例如還沒送到的回報) 不算數
      if (!r.ack || (st !== 1 && st !== 3)) return t;      // 還沒回應 / 被擋住: 不推算
      if (st === 1 && t > r.from + 0.005) {
        // 量 lat: 太早回報 1 的 (影片開頭附近常見, API 時間跑在聲音前面) 不準, 不取樣; 單次慢啟動最多拉高 XF
        if (r.m && d >= 0.15) lat = Math.min(0.6, Math.max(0.02, lat * 0.6 + Math.max(0.02, Math.min(d - (t - r.from), lat + XF)) * 0.4));
        kick[i] = null;
        return t;
      }
      return Math.max(t, r.from + Math.min(0.4, Math.max(0, d - lat)));   // 最多推 0.4 秒, 真的卡住就停在那
    }
    function kickOff(i: number, from: number, m: boolean) {
      kick[i] = { at: performance.now(), from, m, st0: players[i].getPlayerState(), ack: false };
      players[i].playVideo();
    }

    /** 對停在切入點的第 i 支按播放; 起音貼著切入點的段直接全開, 其他從 0 由計時器淡入 */
    function play(i: number, s: RealSeg, m: boolean): number {
      const p = players[i], v0 = finOf(s) <= 0.03 ? 100 : 0;
      p.unMute(); p.setVolume(v0);                         // unMute 會把音量拉到至少 5, 所以先 unMute 再設
      kickOff(i, s.start, m);
      return v0;
    }

    // Safari / iOS: 播放器要在使用者點擊的同步流程裡碰過, 之後計時器才能讓它有聲音地播 (不然換段時會被擋)
    // → 每次點擊都對另一支切一次靜音, 兩支都解鎖
    function unlock(keep: number) {
      players.forEach((p, i) => { if (i !== keep) try { p.unMute(); p.mute(); } catch (e) {} });
    }

    // 播不出聲 (Safari 擋下不是點擊開始的有聲播放 / 被系統暫停): 停下來請使用者點一下, 點擊裡的播放會解鎖
    function needTap() {
      if (paused || k < 0) return;
      setPaused(true); tapped = true;
      startLabel('▶ 點一下繼續', ''); startBtn.dataset.resume = '1'; startBtn.hidden = false;
    }
    // 看門狗被觸發後, 使用者用媒體鍵 / 耳機 / 系統控制在外面恢復了播放: 跟著繼續 (不要再把它停掉)
    function externalResume() {
      delete startBtn.dataset.resume; startBtn.hidden = true;
      paused = false; playBtn.textContent = '⏸ 暫停'; seen = { t: NaN, at: performance.now() };
      queueMicrotask(pace);
    }
    // 看門狗: 這段一直沒往前走 — 被暫停 (2) 1.5 秒就請使用者點一下; 一直沒開始 (-1 / 5 / 讀不到) 等 12 秒
    // (真的 YouTube 慢網路冷載入會停在 -1 五到八秒; 被擋主要靠 onAutoplayBlocked), 點過還是不動就當成這支壞了, 換別支; 緩衝中 (3) 就等
    function watchdog(st: number | undefined, t: number): boolean {   // true = 動了狀態 (這一拍別再往下做)
      const now = performance.now();
      if (t !== seen.t) { if (Number.isFinite(seen.t)) tapped = false; seen = { t, at: now }; return false; }
      const idle = (now - seen.at) / 1000 * SPEED;
      if (st === 2 && idle > 1.5) { needTap(); return true; }
      if ((st === -1 || st === 5 || st == null) && idle > 12) { if (tapped) recover(); else needTap(); return true; }
      return false;
    }
    function startLabel(big: string, small: string) { startBtn.firstElementChild!.innerHTML = `<span>${big}</span>${small}`; }

    /* ---------- 換段雜訊 ---------- */
    const nz = q<HTMLCanvasElement>('[data-noise]'), ng = nz.getContext('2d')!, nimg = ng.createImageData(90, 160);
    function glitch(text: string) {
      const t0 = performance.now();
      nz.classList.add('on'); osdBig.textContent = text; osdBig.classList.add('on');
      (function f(t: number) {
        for (let i = 0; i < nimg.data.length; i += 4) {
          const v = Math.random() * 255 | 0, band = ((i / 360 | 0) + (t / 16 | 0)) % 23 < 2;
          nimg.data[i] = band ? 255 : v; nimg.data[i + 1] = band ? 140 : v; nimg.data[i + 2] = band ? 105 : v; nimg.data[i + 3] = 255;
        }
        ng.putImageData(nimg, 0, 0);
        if (t - t0 < 300) requestAnimationFrame(f);
        else { nz.classList.remove('on'); setTimeout(() => osdBig.classList.remove('on'), 450); }
      })(t0);
    }

    /* ---------- 畫面 ---------- */
    function build(next: FLSeg[]) {
      segs = next.map((s, n) => ({ ...s, color: COLORS[n % COLORS.length] }));
      durs = segs.map(segDur);
      const lineSeg: number[] = [];
      segs.forEach((s, n) => { for (let l = s.from; l <= s.to; l++) lineSeg[l] = n; });
      lyrIn.innerHTML = song.lines.map((ln, l) => {
        const n = lineSeg[l], s = segs[n];
        // song.skip 裡沒人拍到的句子: 不屬於任何一段, 照樣列出來 (setLine 靠 .flp-ln 的順序對句號), 但不能點
        if (!s) return `<div class="flp-ln skip" data-l="${l}"><span class="ja" lang="ja">${esc(ln.ja)}</span><span class="zh">${esc(ln.zh)}</span></div>`;
        // 換段記號: 剪接點 (純視覺); 名稱 / 觀看數寬版只給螢幕閱讀器 (右邊清單有), 清單看不到的版面才顯示 (見 CSS)
        const part = s.from === l && !s.gap
          ? `<div class="flp-seam${n ? '' : ' first'}" style="--c:${s.color}"><span><b class="flp-sr">第 ${n + 1} 段・</b>`
            + `${s.live ? '' : `<em class="flp-kind">${s.kind}</em> `}<span lang="ja">${esc(s.title)}</span> <i>${views(s.views)}</i></span></div>` : '';
        return part + `<div class="flp-ln${s.gap ? ' gap' : ''}" data-l="${l}" data-n="${n}" style="--c:${s.gap ? '#243154' : s.color}">`
          + `<span class="ja" lang="ja">${esc(ln.ja)}</span><span class="zh">${esc(ln.zh)}</span></div>`;
      }).join('');
      list.innerHTML = segs.map((s, n) => s.gap
        ? `<button class="flp-it" type="button" data-i="${n}" style="--c:#243154"><img alt=""><div><b>第 ${n + 1} 段</b><div class="t">還沒有人拍到</div><div class="m">第 ${s.from + 1} 句</div></div></button>`
        : `<button class="flp-it" type="button" data-i="${n}" style="--c:${s.color}"><img src="https://i.ytimg.com/vi/${s.v}/hqdefault.jpg" alt="" loading="lazy">`
          + `<div><b>第 ${n + 1} 段${s.live ? '' : ` <em class="flp-kind">${s.kind}</em>`}</b><div class="t" lang="ja">${esc(s.title)}</div>`
          + `<div class="m">第 ${s.from + 1}–${s.to + 1} 句・${views(s.views)}</div></div></button>`).join('');
      track.innerHTML = segs.map((s, n) => `<button class="flp-seg${s.gap ? ' gap' : ''}" type="button" data-n="${n + 1}${s.gap || s.live ? '' : ' ' + s.kind}" data-i="${n}"`
        + ` title="${s.gap ? '還沒有人拍到' : esc(s.title)}" style="--w:${durs[n].toFixed(2)};--c:${s.color};${s.gap ? '' : `background-image:url(https://i.ytimg.com/vi/${s.v}/mqdefault.jpg)`}">`
        + '<span class="fill"></span><span class="bar"></span></button>').join('') + '<div class="flp-head" data-head></div>';
      q('[data-all]').textContent = fmt(durs.reduce((a, b) => a + b, 0));
    }

    function mark(n: number) {
      root.querySelectorAll('.flp-seg').forEach((e, i) => { e.classList.toggle('cur', i === n); e.classList.toggle('done', i < n); });
      root.querySelectorAll('.flp-it').forEach((e, i) => { e.classList.toggle('cur', i === n); e.classList.toggle('done', i < n); });
      root.querySelector('.flp-it.cur')?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      const l = curLine; curLine = -2; setLine(l);
    }

    function setLine(l: number) {
      if (l === curLine) return;
      curLine = l;
      const lines = root.querySelectorAll<HTMLElement>('.flp-ln');
      lines.forEach(e => { const x = +e.dataset.l!; e.classList.toggle('cur', x === l); e.classList.toggle('past', l >= 0 && x < l); });
      const el = lines[l];
      // 唱到的那句停在中間, 但不捲過頭: 開頭第一句貼齊上緣 (還沒播也是, 跟舞台齊頭), 結尾最後一句貼齊下緣,
      // 不然第一段上面、最後一段下面會空一大塊; 貼齊的那一邊不淡出
      requestAnimationFrame(() => {
        const pad = parseFloat(getComputedStyle(lyrIn).paddingTop), lo = pad, hi = Math.max(lo, lyrIn.offsetHeight - pad - lyr.clientHeight);
        const y = Math.min(hi, Math.max(lo, el ? el.offsetTop - lyr.clientHeight / 2 + el.offsetHeight / 2 : lo));
        lyr.classList.toggle('top', y <= lo + 1); lyr.classList.toggle('end', y >= hi - 1);
        lyrIn.style.transform = `translateY(${-y}px)`;
      });
    }

    /* ---------- 播放流程 ----------
     * 換段 (像現場切鏡頭, 聲音不能斷):
     *   1. 這段結束前 LEAD 秒, 下一段在另一個播放器背景靜音載入; 播起來就暫停、倒回切入點等 (parked)
     *   2. 這段播到 end − lat − 重疊 時按下一段的播放 (lat = 實測延遲; 重疊 = 新段第一句前的換氣, 最多 XF)
     *   3. 下一段一出聲就交棒 (commit): 畫面 / 雜訊轉場 / 清單一起切過去; 上一段照同一條斜線淡完就停
     *      (不等 YouTube 回報「播放中」: Chrome 從暫停恢復要 ~0.27 秒才回報, 位置用牆鐘推算, 見 pos())
     *   下一段來不及準備好: 這段最多多播到 safe (不會播到下一句), 再不行就停在 end 等它 (寧可空一下也不重疊)
     */
    function stopFade() {
      if (out) { try { players[out.p].pauseVideo(); players[out.p].mute(); } catch (e) {} kick[out.p] = null; out = null; }
    }
    function stopAll() {
      clearTimeout(fireTimer); fireTimer = 0; stopFade(); gate = null;
      players.forEach((p, i) => { try { p.pauseVideo(); } catch (e) {} kick[i] = null; });
      pre = null; plEls.forEach(e => e.classList.remove('on')); nosig.classList.remove('on');
    }

    /** 畫面 / 狀態切到第 n 段 (聲音由呼叫的地方負責) */
    function show(n: number) {
      const s = segs[n];
      k = n; seen = { t: NaN, at: performance.now() }; tapped = false; curLim = Infinity;
      root.style.setProperty('--glow', hex2rgb(s.gap ? '#6f7a99' : s.color));
      glitch(s.gap ? 'NO SIGNAL' : s.live ? `CAM ${String(n + 1).padStart(2, '0')}` : s.kind);
      osdR.textContent = `${n + 1} / ${segs.length}`;
      osdL.textContent = s.gap ? 'NO SIGNAL' : s.live ? 'LIVE' : s.kind;
      osdL.classList.toggle('rec', !s.gap && s.live);
      stage.classList.toggle('alt', !s.gap && !s.live);
      if (s.gap) {
        plEls.forEach(e => e.classList.remove('on'));
        nosig.classList.add('on'); gapT0 = performance.now(); gapAt = 0; cap.replaceChildren();
      } else {
        nosig.classList.remove('on');
        plEls.forEach((e, i) => e.classList.toggle('on', i === act));
        cap.innerHTML = `<div>${esc(s.title)}</div>`;      // 只放影片名稱; 第幾段 / 觀看數 / 第幾句右邊清單有
      }
      mark(n);
    }

    /** 直接跳到第 n 段 (開始播放 / 手動跳段 / 下一段來不及接上時的退路) */
    function go(n: number) {
      if (n < 0 || n >= segs.length) return finish();
      queueMicrotask(pace);   // 開始播 / 換段: 拍子馬上切回快的, 不等下一個慢拍
      clearTimeout(fireTimer); fireTimer = 0; stopFade(); lost = false; gate = null;
      const s = segs[n], prevAct = act;
      if (pre && (s.gap || pre.n !== n || pre.v !== s.v)) dropPre();   // 用不到的預載 (手動跳段): 停掉, 按了播放的那支還在出聲
      if (s.gap) {
        players[prevAct].pauseVideo(); kick[prevAct] = null;
        return show(n);
      }
      const usePre = !!pre && pre.n === n && pre.v === s.v;
      const nextAct = usePre ? pre!.p : (prevAct + 1) % 2, p = players[nextAct];
      lastT[nextAct] = NaN;
      if (!usePre) {
        kick[nextAct] = null;
        load(nextAct, s.v, s.start);
        p.unMute(); p.setVolume(vol = 0);                 // 由計時器淡入 (unMute 會把音量拉到至少 5, 所以後設)
      } else if (pre!.fired) {
        vol = -1;                                          // 已經按了播放 (正在 / 馬上出聲): 不再動它, 下一拍照它的時間設音量
      } else if (pre!.parked) {
        vol = play(nextAct, s, performance.now() - (pre!.parkedAt ?? 0) > 300);   // 剛停好 (seek 還沒完) 的不拿來量 lat
      } else {
        // 還在載入 (靜音、從 start−0.3 附近開播): 到切入點才取消靜音 (iPhone 不能用音量壓)。位置偏太多才拉回 (seek 會重新緩衝),
        // 但影片資訊還沒回來 (長度 0、時間是佔位的 0) 時不能 seek: 會被吃掉、還蓋掉 startSeconds, 變成從 0 靜音播 start 秒
        const t = p.getCurrentTime();
        if (t != null && (p.getDuration?.() || 0) > 0 && (t > s.start + .15 || t < s.start - .6)) seek(nextAct, s.start);
        p.setVolume(vol = 0); p.playVideo(); gate = s.start; gateFix = false; kick[nextAct] = null;
      }
      if (nextAct !== prevAct) { players[prevAct].pauseVideo(); kick[prevAct] = null; }
      act = nextAct; pre = null;
      show(n);
    }

    /** 下一段出聲了: 畫面切過去, 上一段交給 out 照原本的斜線淡完 */
    function commit() {
      const n = pre!.n, np = pre!.p, ns = segs[n] as RealSeg, pre0vol = pre!.vol ?? 0;
      out = { p: act, end: pre!.oe ?? clip(act, segs[k] as RealSeg).end, v: vol < 0 ? 100 : vol };
      act = np; pre = null;
      players[np].setVolume(vol = Math.max(pre0vol, level(fadeIn(ns, (pos(np) ?? ns.start) + ahead))));
      fadeOut();                                           // 上一段這一拍也要照斜線降, 不要停一拍
      show(n);
    }
    /** 上一段 (out) 的淡出: 照 out.end 淡完 (不比交棒時大聲) 就停; 它已經沒在播 (iPhone 同時只准一支出聲, 系統會暫停它)、
     *  或自己跳回開頭 (嵌入的 Shorts 片尾循環) 也停 */
    function fadeOut() {
      if (!out) return;
      const op = players[out.p], ot = pos(out.p) ?? out.end, ost = op.getPlayerState(), lt = lastT[out.p];
      lastT[out.p] = ot;
      const ov = out.v = Math.min(out.v, level((out.end - ot - ahead) / XF));   // 只降不升
      op.setVolume(ov);
      if (ov === 0 || ot >= out.end || (ost !== 1 && ost !== 3) || ot < lt - 1) stopFade();
    }

    /** 按下一段的播放; t = 這段現在的時間 */
    function fire(t: number) {
      if (!pre || pre.fired || !pre.parked) return;
      const s = clip(act, segs[k] as RealSeg), ns = segs[pre.n] as RealSeg;
      pre.vol = play(pre.p, ns, performance.now() - (pre.parkedAt ?? 0) > 300);   // 剛停好 (seek 還沒完) 的不拿來量 lat
      pre.fired = performance.now();
      // 這段淡完的時間 (它自己的時間軸): 已經在淡了 → 照原來那條斜線淡完 (curLim); 準時按 → end;
      // 還在全音量的晚按 (預載太慢, 已經在 HOLD 裡) → 等新段出聲、至少再淡 FADE 秒; 都不超過 safe / end + HOLD (不會播到下一句)
      const due = t + lat + overlapOf(ns);
      pre.oe = Math.min(s.safe, s.end + HOLD, curLim < Infinity ? curLim : due <= s.end + 0.01 ? s.end : Math.max(due, t + FADE));
    }

    // 正在播的那支播不了: 排除它, 從當下這句重新挑, 不整段跳過
    function recover() {
      const s = segs[k];
      if (s.gap) return;
      const line = Math.min(s.to, Math.max(s.from, curLine));
      bad.add(s.v);
      const head: FLSeg[] = segs.slice(0, k);
      if (line > s.from) { const e = s.cues.find(c => c[0] === line)![1] - .05; head.push({ ...s, to: line - 1, end: e, safe: e, sung: undefined }); }
      build([...head, ...plan(song, bad, line)]);
      dropPre(); go(head.length);
    }

    function preroll(n: number) {
      const s = segs[n];
      if (!s || s.gap || (pre && pre.n === n) || out) return;   // 上一段還在淡出時先別動那個播放器
      const pi = (act + 1) % 2, p = players[pi];
      p.mute(); p.setVolume(0); kick[pi] = null; lastT[pi] = NaN;
      load(pi, s.v, Math.max(0, s.start - 0.3));
      pre = { n, p: pi, v: s.v, parked: false, fired: 0 };
    }

    function finish() {
      stopAll(); k = -1; setLine(-1); paused = false; lost = false;
      osdL.textContent = 'END'; osdL.classList.remove('rec'); osdR.textContent = `${segs.length} / ${segs.length}`;
      delete startBtn.dataset.resume; startLabel('↺ 再聽一次', '從第一句聽到最後一句'); startBtn.hidden = false;
      cap.replaceChildren();
      root.dispatchEvent(new CustomEvent('flp:end'));
    }

    function setPaused(v: boolean) {
      if (k < 0) return;
      if (!v) { delete startBtn.dataset.resume; startBtn.hidden = true; }
      if (paused === v) return;
      paused = v;
      queueMicrotask(pace);
      playBtn.textContent = paused ? '▶ 繼續' : '⏸ 暫停';
      const s = segs[k];
      if (paused) {
        clearTimeout(fireTimer); fireTimer = 0; stopFade();
        if (pre && pre.fired) {                            // 已經按了播放的下一段: 停回切入點, 繼續後重新對時
          const pp = players[pre.p];
          pp.pauseVideo(); pp.mute(); seek(pre.p, (segs[pre.n] as RealSeg).start);
          pre.fired = 0; kick[pre.p] = null;
        }
        if (s.gap) gapAt += (performance.now() - gapT0) / 1000 * SPEED;
        else { players[act].pauseVideo(); kick[act] = null; }
        return;
      }
      // 繼續 (都在使用者點擊裡: 順便把另一支播放器解鎖)
      seen = { t: NaN, at: performance.now() };
      if (lost) { lost = false; recover(); }               // 暫停中這支出錯了: 現在才換
      else if (s.gap) gapT0 = performance.now();
      else {
        const t = pos(act) ?? s.start;
        // 離切點不到 0.4 秒就不恢復這段 (Chrome 恢復後 ~0.27 秒時間不動, 會播過頭到下一句), 直接接下一段
        if (segs[k + 1] && clip(act, s).end - t < 0.4) go(k + 1);
        else kickOff(act, t, false);
      }
      unlock(act);
    }

    /* 計時器 (~25 ms 一拍): 拍子由 Worker 打 — macOS Safari 的分頁在背景 / 視窗被遮住時, 主執行緒的計時器
     * 會被對齊到 1 秒一拍 (有聲也一樣), 換段就會亂掉; Worker 的計時器和它傳回來的訊息不受影響。
     * Worker 起不來 (或被擋) 才由主執行緒的計時器補 */
    let lastTick = 0, prevDt = 0.025;
    function tick() {
      pace();
      const now = performance.now(), dt = lastTick ? (now - lastTick) / 1000 : 0.025;
      // 連兩拍都長才算拍子變粗 (只有一拍長 = 主執行緒剛卡了一下, 排隊的拍子馬上補上; 照它往前看會一下子把音量算成 0)
      ahead = Math.min(1, Math.max(0.025, Math.min(dt, prevDt))) * SPEED;
      prevDt = dt; lastTick = now;
      if (!isReady) return;                                 // YouTube 播放器還沒準備好 (方法還沒掛上)
      // 沒在用的播放器自己播起來了 (剛載入時下的暫停常常壓不住): 停掉 —
      // 但看門狗停下來 (點一下繼續) 之後, 使用者用媒體鍵 / 耳機 / 系統控制在外面恢復的, 就跟著繼續
      players.forEach((pl, i) => {
        if (pl.getPlayerState() !== 1) return;
        if (k >= 0 && ((i === act && !paused && !segs[k].gap) || pre?.p === i || out?.p === i)) return;
        if (k >= 0 && paused && i === act && !segs[k].gap && startBtn.dataset.resume) return externalResume();
        pl.pauseVideo();
      });
      if (k < 0) return;
      // 預載的下一段播起來了 → 暫停、倒回切入點等 (暫停中也要做, 不然它會在背景一路播到片尾)
      let parkedNow = false;
      if (pre && !pre.parked && !pre.fired && players[pre.p].getPlayerState() === 1) {
        const pp = players[pre.p];
        pp.pauseVideo(); seek(pre.p, (segs[pre.n] as RealSeg).start);
        pre.parked = parkedNow = true; pre.parkedAt = now; lastT[pre.p] = NaN;
      }
      if (paused) return;
      fadeOut();                                            // 上一段在交叉淡化
      const s = segs[k];
      let into: number;
      if (s.gap) {
        into = gapAt + (performance.now() - gapT0) / 1000 * SPEED;
        q('[data-nosig-t]').textContent = `${Math.max(0, s.len - into).toFixed(1)}s`;
        setLine(s.from);
        if (into >= s.len - LEAD) preroll(k + 1);
        if (into >= s.len) return go(k + 1);
      } else {
        const p = players[act], t = pos(act), st = p.getPlayerState();
        if (t == null || !Number.isFinite(t)) return;     // 剛 loadVideoById: widget 先把狀態清空, iframe 回報前讀不到時間
        // 影片自己跳回開頭 (嵌入的 Shorts 片尾會循環, 不報 ENDED): 當成播完。只看播放中的時間, 剛 load / seek 完的不算
        // (Firefox 會先讀到上一支的舊時間, 再掉回真的位置)
        const lt = lastT[act];
        if (st === 1) lastT[act] = t;
        if (st === 1 && t < lt - 1 && (now - movedAt[act]) * SPEED > 1000) {
          root.dispatchEvent(new CustomEvent('flp:cut', { detail: { seg: k, at: lt, end: s.end } }));
          return go(k + 1);
        }
        if (watchdog(st, t) || paused) return;
        into = Math.max(0, t - s.start);
        if (gate !== null) {                              // 還在載入時接手的: 到切入點才出聲
          if (t >= gate - 0.01) { p.unMute(); gate = null; vol = -1; }
          else if (st === 1 && t < gate - 1 && !gateFix) { gateFix = true; seek(act, gate); }   // 還是從 0 播起了: 拉回切入點一次
        }
        let l = s.from;
        for (const [line, ct] of s.cues) if (t >= ct - .1) l = line;
        setLine(l);
        root.dispatchEvent(new CustomEvent('flp:line', { detail: l }));
        const c = clip(act, s);                            // 切點用影片實際長度封頂
        if (t >= c.end - LEAD) preroll(k + 1);
        const nx = segs[k + 1], mine = !!pre && pre.n === k + 1 && !!nx && !nx.gap;
        // 提早 lat + 重疊 按下一段的播放; 快到了就用 setTimeout 對準, 不等下一次計時器
        if (mine && pre!.parked && !pre!.fired && !parkedNow) {
          const fireAt = c.end - lat - overlapOf(nx as RealSeg);
          if (t >= fireAt) fire(t);
          else if (!fireTimer && fireAt - t < 0.08) fireTimer = window.setTimeout(() => {
            fireTimer = 0; if (pre && pre.n === k + 1 && !paused) fire(pos(act) ?? fireAt);
          }, (fireAt - t) / SPEED * 1000);
        }
        if (mine && pre!.fired) {
          const ns = nx as RealSeg, np = players[pre!.p], npos = pos(pre!.p) ?? ns.start, kk = kick[pre!.p];
          // 下一段出聲了 → 交棒。不等它回報 1 (Chrome 要 ~0.27 秒): 播放器回應了這次播放、推算的位置過了切入點就算
          // (kick 已經清掉 = 確認在播)
          if (kk ? kk.ack && npos > ns.start + 0.005 : np.getPlayerState() === 1) {
            root.dispatchEvent(new CustomEvent('flp:cut', { detail: { seg: k, at: t, end: s.end } }));
            return commit();
          }
          // 還沒交棒前就照它自己的時間淡入 (起音前的換氣)
          const nv = level(fadeIn(ns, npos + ahead));
          if (nv > (pre!.vol ?? 0)) { pre!.vol = nv; np.setVolume(nv); }
        }
        // 這段淡到哪: 下一段已經按了播放 → oe; 停好時還來得及完整淡出 (r2, 記住不變) → 照一般換段在 end 前淡完
        // (換過去不會讓音量突然掉一截才換); 還沒準備好 → 最多多播到 safe / end + HOLD (之後就是下一句了); 沒有下一段要接 → end
        const fired = mine && !!pre!.fired;
        if (mine && pre!.parked && !parkedNow && c.end - t - ahead >= FADE) pre!.r2 = true;
        const ready2 = mine && !!pre!.r2;
        const limit = fired ? pre!.oe! : ready2 ? c.end : nx && !nx.gap ? Math.min(c.safe, c.end + HOLD) : c.end;
        // 最後一段只淡人聲唱完後的尾巴 (影片唱完就結束的只留一點防喀聲, 不提早淡到最後一個字)
        const fo = k === segs.length - 1 ? Math.min(FADE_END, Math.max(0.05, c.end - Math.min(s.sung ?? c.end - FADE_END, c.end))) : FADE;
        let v = level(Math.min(fadeIn(s, t + ahead), (limit - t - ahead) / fo));
        curLim = (limit - t - ahead) / fo < 1 ? limit : Infinity;
        if (fired && vol >= 0) v = Math.min(v, vol);       // 下一段按了播放之後, 這段只會越來越小聲
        if (v !== vol) { vol = v; p.setVolume(v); }
        if (t >= limit || st === 0) {
          root.dispatchEvent(new CustomEvent('flp:cut', { detail: { seg: k, at: t, end: s.end } }));
          return go(k + 1);
        }
      }
      q('[data-now]').textContent = fmt(durs.slice(0, k).reduce((a, b) => a + b, 0) + Math.min(into, durs[k]));
      const seg = root.querySelectorAll<HTMLElement>('.flp-seg')[k];
      seg.querySelector<HTMLElement>('.fill')!.style.width = Math.min(100, into / durs[k] * 100) + '%';
      q('[data-head]').style.left = (seg.offsetLeft + seg.offsetWidth * Math.min(1, into / durs[k])) + 'px';
    }
    // 拍子快慢: 正在播 (要算淡入淡出、換段) 25 ms 一拍; 還沒開始 / 暫停中 250 ms 一拍就夠
    // (那時候只剩看門狗: 壓住自己播起來的播放器、跟上從耳機 / 媒體鍵恢復的播放), 不用一秒 40 次空轉
    const FAST = 25, SLOW = 250;
    let rate = FAST, lastWorker = 0, timer = 0;
    let tw: Worker | null = null;
    try {
      tw = new Worker(URL.createObjectURL(new Blob(['let h = setInterval(() => postMessage(0), 25); onmessage = e => { clearInterval(h); h = setInterval(() => postMessage(0), e.data); };'], { type: 'text/javascript' })));
      tw.onmessage = () => { if (!root.isConnected) { tw?.terminate(); tw = null; return; } lastWorker = performance.now(); tick(); };
      tw.onerror = () => { tw?.terminate(); tw = null; };
    } catch (e) { tw = null; }
    function beat() {
      clearInterval(timer);
      timer = window.setInterval(() => {
        if (!root.isConnected) { clearInterval(timer); tw?.terminate(); return; }
        if (performance.now() - lastWorker > rate * 2.4) tick();     // Worker 沒在打拍子才由這裡補
      }, rate);
    }
    function pace() {
      const want = k >= 0 && !paused ? FAST : SLOW;
      if (want === rate) return;
      rate = want; tw?.postMessage(rate); beat();
    }
    beat();

    /* ---------- 操作 (都在點擊的同步流程裡做, Safari 才會把播放器解鎖) ---------- */
    function jump(n: number) {
      if (!isReady) return;
      startBtn.hidden = true; delete startBtn.dataset.resume;
      paused = false; lost = false; playBtn.textContent = '⏸ 暫停';
      go(n);
      unlock(act);
    }
    startBtn.addEventListener('click', () => startBtn.dataset.resume ? setPaused(false) : jump(0));
    playBtn.addEventListener('click', () => setPaused(!paused));
    q('[data-prev]').addEventListener('click', () => { if (k > 0) jump(k - 1); });
    q('[data-next]').addEventListener('click', () => { if (k >= 0) jump(k + 1); });
    track.addEventListener('click', e => { const b = (e.target as Element).closest<HTMLElement>('.flp-seg'); if (b) jump(+b.dataset.i!); });
    list.addEventListener('click', e => { const b = (e.target as Element).closest<HTMLElement>('.flp-it'); if (b) jump(+b.dataset.i!); });
    lyrIn.addEventListener('click', e => { const l = (e.target as Element).closest<HTMLElement>('.flp-ln'); if (l?.dataset.n) jump(+l.dataset.n); });

    build(plan(song, bad));
    setLine(-1);
    osdR.textContent = `— / ${segs.length}`;
    setLine(-1);
    // YouTube 播放器準備好之前不能按播放 (點擊要直接開播, Safari 才放行)
    if (!isReady) {
      startBtn.disabled = true; startLabel('載入中…', '從第一句聽到最後一句');
      ready.then(() => { isReady = true; startBtn.disabled = false; if (k < 0) startLabel('▶ 播放', '從第一句聽到最後一句'); });
    }
  }

  document.querySelectorAll<HTMLElement>('[data-flp]').forEach(mount);
</script>
