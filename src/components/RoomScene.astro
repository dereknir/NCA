---
/**
 * 首頁的房間: 2005 年夜裡我的房間 (/img/room/room.png, 480×270 的像素畫; Aseprite 原檔不進 repo)。
 * 首頁就只有這間房間, 房間裡的東西就是網站的入口; 座標全部寫原圖像素, 螢幕上的大小交給 /js/room.js 算倍率。
 * 熱區疊的順序有意義: 後面的蓋在前面上面 (月亮、望遠鏡在窗戶上; 桌面資料夾在電腦上; しっぽ在軟木板上)。
 * 名牌只寫點了會去哪, 東西本身是什麼看圖就知道。
 * 海報 (今日の一曲的封面)、月曆 (這個月、今天、下一場)、書櫃上的鬧鐘 (現在幾點) 是 room.js 畫在 canvas 上的;
 * 檯燈關掉換 room-off.png。
 * 開場: 走廊上虛掩的門 (/img/room/door-0~3.png, 門口是透明的, 後面就是這間房間);
 * 每次打開網站演一次 (sessionStorage), 壓下門把才進來。
 */
interface Spot { k: string; sub: string; x: number; y: number; w: number; h: number; href?: string; act?: string }

const SPOTS: Spot[] = [
  { k: 'poster', sub: '完整 Live', x: 26, y: 28, w: 76, h: 76, href: '/live/full/' },   // 名牌和連結 room.js 換成今日の一曲
  { k: 'sky', sub: '歌詞星圖', x: 152, y: 17, w: 176, h: 110, href: '/star-map/' },
  { k: 'moon', sub: '歌詞宇宙', x: 285, y: 25, w: 29, h: 29, href: '/lyric-universe/' },
  { k: 'telescope', sub: 'にしなの宇宙', x: 163, y: 100, w: 37, h: 28, href: '/galaxy/' },
  { k: 'lamp', sub: '關燈', x: 124, y: 134, w: 64, h: 24, act: 'lamp' },
  { k: 'shelf', sub: '日文歌翻譯', x: 22, y: 128, w: 86, h: 74, href: '/translations' },
  { k: 'cabinet', sub: '歌詞索引', x: 22, y: 202, w: 86, h: 66, href: '/kwic/' },
  { k: 'notebook', sub: '日記', x: 164, y: 199, w: 40, h: 10, href: '/diary' },
  { k: 'drawer', sub: '歌詞卡ガチャ', x: 121, y: 223, w: 82, h: 20, href: '/gacha/' },
  { k: 'phone', sub: '拿起來看看', x: 210, y: 150, w: 42, h: 58, act: 'phone' },
  { k: 'crt', sub: '指令列', x: 258, y: 118, w: 98, h: 88, act: 'cli' },
  { k: 'about', sub: '關於我', x: 325, y: 137, w: 16, h: 16, href: '/about' },
  { k: 'projects', sub: '作品集', x: 325, y: 153, w: 16, h: 16, href: '/projects' },
  { k: 'radio', sub: '花絮', x: 366, y: 146, w: 50, h: 60, href: '/extras/' },
  { k: 'calendar', sub: 'Live 演出', x: 393, y: 14, w: 48, h: 68, href: '/live/' },
  { k: 'corkboard', sub: '巡演 Setlist', x: 385, y: 87, w: 64, h: 43, href: '/setlists/' },
  { k: 'shippo', sub: '', x: 420, y: 121, w: 32, h: 63, act: 'shippo' },   // 不連去哪, 點了會晃
];
// 熱區沒有名牌的時候 (しっぽ), 讀螢幕的人還是要知道那是什麼
const LABEL: Record<string, string> = { shippo: 'しっぽ (點了會晃)', phone: 'N247i: 拿起來看看', crt: '電腦: 打開指令列', lamp: '檯燈: 開關' };

// 會亮的小東西 (圖上本來就畫了, 這裡只負責閃)。
// 用蓋的那兩個多蓋一圈: 倍率有小數時 (手機 8/3) 邊界會差一個實體像素, 底下的燈會露一圈邊
const PX = [
  { c: 'rm-led-mail', x: 236, y: 159, w: 2, h: 1 },   // 手機轉軸的來信燈
  { c: 'rm-led-hdd', x: 394, y: 257, w: 3, h: 3 },    // 主機的硬碟燈 (395,258)
  { c: 'rm-cursor', x: 282, y: 162, w: 5, h: 6 },     // 終端機游標 (283,163 3×4)
];
const pos = (o: { x: number; y: number; w: number; h: number }) => `--x:${o.x};--y:${o.y};--w:${o.w};--h:${o.h}`;
---

<link rel="stylesheet" href="/css/room.css">
<!-- 這次打開網站還沒進過門就先把門蓋上 (在畫面出來之前決定, 才不會先閃一下房間); 分享出去的 ?n2= 連結直接進房間 -->
<script is:inline>
  try { if (!sessionStorage.getItem('rm-door') && !/[?&]n2=/.test(location.search)) document.documentElement.classList.add('rm-intro'); } catch (e) {}
</script>

<section class="rm" data-room aria-label="Derek 的房間">
  <h1 class="sr-only">Derek 的房間</h1>
  <div class="rm-pan">
    <div class="rm-stage">
      <img class="rm-bg" src="/img/room/room.png" width="480" height="270" decoding="async"
        alt="夜裡的房間: 書桌上有檯燈、插在充電座上的折疊手機、CRT 電腦和收音機, 窗外是月亮和城市">
      <canvas class="rm-cv rm-poster" width="66" height="66" style={pos({ x: 31, y: 33, w: 66, h: 66 })} aria-hidden="true"></canvas>
      <canvas class="rm-cv rm-cal" width="44" height="54" style={pos({ x: 395, y: 23, w: 44, h: 54 })} aria-hidden="true"></canvas>
      <canvas class="rm-cv rm-clock" width="25" height="8" style={pos({ x: 54, y: 121, w: 25, h: 8 })} aria-hidden="true"></canvas>
      <img class="rm-shippo" src="/img/room/shippo.png" width="480" height="270" alt="" aria-hidden="true">
      {PX.map(p => <span class={`rm-px ${p.c}`} style={pos(p)} aria-hidden="true"></span>)}
      <div class="rm-scan" style={pos({ x: 271, y: 135, w: 72, h: 41 })} aria-hidden="true"><i></i></div>
      <div class="rm-sky" style={pos({ x: 153, y: 18, w: 85, h: 52 })} aria-hidden="true"></div>
      <div class="rm-sky" style={pos({ x: 240, y: 18, w: 87, h: 52 })} aria-hidden="true"></div>
      {SPOTS.map(s => s.href
        ? <a class="rm-hs" href={s.href} data-k={s.k} data-sub={s.sub} style={pos(s)} aria-label={LABEL[s.k] || s.sub}></a>
        : <button class="rm-hs" type="button" data-k={s.k} data-act={s.act} data-sub={s.sub} style={pos(s)} aria-label={LABEL[s.k] || s.sub}></button>)}
      <div class="rm-tip" aria-hidden="true"></div>
    </div>
  </div>
  <p class="rm-swipe" aria-hidden="true">← 左右滑 →</p>

  <!-- 開場: 走廊上虛掩的門。門縫看得到房間 (room.js 讓鏡頭在裡面慢慢看), 壓下門把才進來 -->
  <div class="rm-door">
    <div class="rm-door-stage">
      <img class="rm-door-img" src="/img/room/door-0.png" width="480" height="270" alt="走廊上虛掩的房門, 門牌寫著 derekk, 門縫透出房間的燈光">
      <span class="rm-dp rm-glint" style={pos({ x: 228, y: 138, w: 3, h: 3 })} aria-hidden="true"></span>
      <button class="rm-dp rm-knob" type="button" style={pos({ x: 218, y: 128, w: 30, h: 26 })} aria-label="壓下門把, 進房間"></button>
    </div>
    <!-- 趕時間的捷徑, 先收起來, 之後要用再打開
    <p class="rm-rush">趕時間的話 → <a href="/about">關於我</a><a href="/projects">作品集</a></p>
    -->
  </div>
</section>
<link rel="stylesheet" href="/css/n247i.css">
<script is:inline src="/js/n247i.js"></script>
<script is:inline src="/js/room.js"></script>
