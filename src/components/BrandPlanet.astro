---
/**
 * BrandPlanet — 「derekkk」那顆帶環的小像素行星 (16×16 畫素), 頁尾、關於頁共用
 */
import { PLANET } from '../lib/brandPlanet';

interface Props { size?: number; class?: string }
const { size = 32, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 16 16" width={size} height={size} shape-rendering="crispEdges" aria-hidden="true">{PLANET.map(([x, y, w, h, c]) => <rect x={x} y={y} width={w} height={h} fill={c} />)}</svg>
