---
/**
 * PageHero — 全站統一的頁頂 (樣式 /css/site-shell.css, 星空 / 行星由 /js/site-shell.js 畫)
 *
 * 骨架固定: shell 提示 (路徑) / 標題 / 一句說明 / 一行資訊 / 動作 / 右側像素行星。
 * 提示列的路徑就是麵包屑: 有對應頁面的那一段可以點 (~ 是首頁), 這一頁自己、星球名不能點; 所以動作那排不放「‹ 列表」這種回上一層的。
 * 資訊 (chips) 不加框, 排成一行淡色字, 才看得出跟按鈕不一樣; 動作那排只放要去別頁的, 主按鈕永遠排第一個。
 * 用法: <PageHero slot="hero" planet="earth" title="日文歌翻譯" desc="…" chips={[['51/51', '已翻譯']]} />
 * variant: page (預設) / tool (收成一條, 工具頁) / song (封面 + 資訊, 背景是封面馬賽克)
 * compact: 內容才是主角的頁 (完整 Live 播放、日記內文、作品介紹) 標題區壓矮, 一打開就看得到內容; 列表頁保留大的星空跟行星
 * width 要跟 BaseLayout 的 width 一樣, 左緣才會對齊內文。
 * orb={false} 不畫行星, 改用 slot="aside" 放自己的東西 (Live 頁的雷達)。
 */
import { PLANETS, NAV_GROUPS } from '../config';
import { coverAt } from '../lib/covers';

interface Props {
  planet: keyof typeof PLANETS | string;
  title: string;
  titleLang?: string;
  desc?: string;
  path?: string;                       // shell 提示裡的路徑, 預設取選單設定
  cmd?: string;
  chips?: Array<[string, string?, string?]>;     // 資訊: [數字, 說明, 連結]
  actions?: Array<{ label: string; href: string; primary?: boolean; external?: boolean }>;
  variant?: 'page' | 'tool' | 'song';
  width?: 'wide' | 'read' | 'stage';
  cover?: string;
  coverAlt?: string;
  coverTransition?: string;            // 跟列表頁縮圖同名, 換頁時封面接續
  orb?: boolean;
  compact?: boolean;
}

const {
  planet, title, titleLang, desc, cmd = 'cat README', chips = [], actions = [],
  variant = 'page', width = 'wide', cover, coverAlt = '', coverTransition, orb = true, compact = false,
} = Astro.props;
const p = PLANETS[planet];
const navPath = NAV_GROUPS.flatMap(g => g.items).find(it => it.planet === planet)?.path;
const path = Astro.props.path ?? navPath ?? '~';
const isSong = variant === 'song';

// 路徑一段一段: 選單裡有這個路徑的就連過去; 手機只留最後兩段, 前面收成「…/」
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const HREF = new Map(NAV_GROUPS.flatMap(g => g.items).map(it => [it.path, it.href]));
const parts = path.split('/');
const segs = parts.map((name, i) => {
  const href = i === 0 && name === '~' ? '/' : HREF.get(parts.slice(0, i + 1).join('/'));
  return { name, href: href && (href.replace(/\/$/, '') || '/') !== here ? href : undefined };
});
const far = (i: number) => segs.length > 2 && i < segs.length - 2;
const acts = [...actions].sort((a, b) => Number(!!b.primary) - Number(!!a.primary));
---

<section
  class={`sh-hero sh-hero--${variant}${compact ? ' sh-hero--compact' : ''}`}
  data-sh-hero
  data-planet={planet}
  data-kind={p?.kind}
  data-palette={p ? JSON.stringify(p.palette) : undefined}
  data-cover={isSong ? coverAt(cover, 80) : undefined}
  data-orb={orb ? undefined : 'off'}
  style={p ? `--sh-accent:${p.palette[0].join(' ')}` : undefined}
>
  <div class="sh-hero-bg" aria-hidden="true"></div>
  <div class={`sh-wrap sh-hero-inner${width === 'read' ? ' sh-wrap--read' : width === 'stage' ? ' sh-wrap--stage' : ''}`}>
    {isSong && cover && (
      <img class="sh-cover" src={coverAt(cover, 448)} alt={coverAlt} width="224" height="224" loading="eager"
           style={coverTransition ? `view-transition-name:${coverTransition}` : undefined} />
    )}
    <div class="sh-hero-text">
      <div class="sh-prompt"><span class="u">derek@nishina</span>:<span class="pa">{segs.map((g, i) => <>{i === segs.length - 2 && segs.length > 2 && <span class="sh-more" aria-hidden="true">…/</span>}<span class={far(i) ? 'sh-far' : undefined}>{g.href ? <a class="sh-seg" href={g.href}>{g.name}</a> : g.name}{i < segs.length - 1 ? '/' : ''}</span></>)}</span> $ <span class="cmd">{cmd}</span></div>
      <h1 class="sh-title" lang={titleLang} id={isSong ? 'songTitle' : undefined}>{title}</h1>
      {desc && <p class="sh-desc">{desc}</p>}
      <slot />
      {chips.length > 0 && (
        <p class="sh-facts">{chips.map(([num, label, href], i) => <>{i > 0 && <i aria-hidden="true">·</i>}{href ? <a href={href}><b>{num}</b>{label}</a> : <span>{label ? <><b>{num}</b>{label}</> : num}</span>}</>)}</p>
      )}
      {acts.length > 0 && (
        <div class="sh-row">
          {acts.map(a => (
            <a class={`sh-btn${a.primary ? ' sh-btn--pri' : ''}`} href={a.href}
               {...(a.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{a.label}</a>
          ))}
        </div>
      )}
    </div>
  </div>
  <slot name="aside" />
</section>
