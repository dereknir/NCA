---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ContentCard from '../components/ContentCard.astro';

const isTranslated = (body: string | undefined) =>
  !!body && !body.includes('翻譯準備中');

const allTranslations = await getCollection('translations');
const translatedOnly = allTranslations.filter(t => isTranslated(t.body));

const recentTranslations = translatedOnly
  .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf())
  .slice(0, 3);

const featuredProjects = (await getCollection('projects'))
  .filter(project => project.data.featured)
  .slice(0, 3);

const recentDiary = (await getCollection('diary'))
  .filter(entry => !entry.data.isPrivate)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 3);

const stats = {
  translations: translatedOnly.length,
  totalSongs: allTranslations.length,
  diary: recentDiary.length,
  projects: featuredProjects.length,
};
---

<BaseLayout
  title="Derek's Site"
  description="歡迎來到 Derek 的個人網站。探索日文歌曲翻譯、閱讀生活日記，以及查看程式作品集。"
>
  <!-- Hero Section -->
  <section class="text-center py-20">
    <h1 class="text-5xl font-bold mb-4">
      歡迎來到我的個人空間
    </h1>
    <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
      日文歌翻譯 · 生活日記 · 程式作品
    </p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="/translations"
         class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
        探索翻譯
      </a>
      <a href="/projects"
         class="px-6 py-3 border-2 border-blue-600 text-blue-600 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition">
        查看作品
      </a>
    </div>

    {stats.totalSongs > 0 && (
      <div class="mt-12 flex justify-center gap-8 text-sm text-gray-500 dark:text-gray-400">
        <div>
          <div class="text-2xl font-bold text-gray-900 dark:text-gray-100">
            {stats.translations}
            <span class="text-sm text-gray-400 font-normal"> / {stats.totalSongs}</span>
          </div>
          <div>已翻譯</div>
        </div>
        {stats.diary > 0 && (
          <div>
            <div class="text-2xl font-bold text-gray-900 dark:text-gray-100">{stats.diary}</div>
            <div>篇日記</div>
          </div>
        )}
        {stats.projects > 0 && (
          <div>
            <div class="text-2xl font-bold text-gray-900 dark:text-gray-100">{stats.projects}</div>
            <div>個作品</div>
          </div>
        )}
      </div>
    )}
  </section>

  <!-- Recent Translations (only fully translated songs) -->
  {recentTranslations.length > 0 && (
    <section class="py-12">
      <div class="flex justify-between items-center mb-8">
        <h2 class="text-3xl font-bold">最新翻譯</h2>
        <a href="/translations" class="text-blue-600 hover:text-blue-800">查看全部 →</a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {recentTranslations.map(translation => (
          <ContentCard
            title={translation.data.title}
            subtitle={`${translation.data.artist}${translation.data.album ? ` · ${translation.data.album}` : ''}`}
            href={`/translations/${translation.id}`}
            date={translation.data.publishDate}
            tags={translation.data.tags}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Recent Diary -->
  {recentDiary.length > 0 && (
    <section class="py-12">
      <div class="flex justify-between items-center mb-8">
        <h2 class="text-3xl font-bold">最近日記</h2>
        <a href="/diary" class="text-blue-600 hover:text-blue-800">查看全部 →</a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {recentDiary.map(entry => (
          <ContentCard
            title={entry.data.title}
            subtitle={entry.data.mood ?? '📝'}
            href={`/diary/${entry.id}`}
            date={entry.data.date}
            tags={entry.data.tags}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Featured Projects -->
  {featuredProjects.length > 0 && (
    <section class="py-12">
      <div class="flex justify-between items-center mb-8">
        <h2 class="text-3xl font-bold">精選作品</h2>
        <a href="/projects" class="text-blue-600 hover:text-blue-800">查看全部 →</a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {featuredProjects.map(project => (
          <ContentCard
            title={project.data.title}
            description={project.data.description}
            href={`/projects/${project.id}`}
            image={project.data.coverImage}
            tags={project.data.techStack}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
