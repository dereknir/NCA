---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleEnd from '../../components/ArticleEnd.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const diaryEntries = await getCollection('diary', ({ data }) => !data.isPrivate);
  return diaryEntries.map(entry => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, mood, weather, tags } = entry.data;

// 字數: 中日文一個字算一個, 英數一個詞算一個 (HTML 標籤、連結網址不算); 一分鐘讀 400 字左右
const plain = (entry.body ?? '').replace(/<[^>]+>/g, ' ').replace(/\]\([^)]*\)/g, ']');
const words = (plain.match(/[\u3040-\u30ff\u3400-\u9fff\uf900-\ufaff]/g)?.length ?? 0) + (plain.match(/[A-Za-z0-9]+/g)?.length ?? 0);
const minutes = Math.max(1, Math.round(words / 400));

// 使用可選鏈確保類型安全
const description = `${new Date(date).toLocaleDateString('zh-TW', { timeZone: 'UTC' })} 的日記${mood ? ' ' + mood : ''}。${tags?.slice(0, 3).map(t => '#' + t).join(' ') ?? ''}`;
---

<BaseLayout
  title={title}
  description={description}
  article={true}
  publishDate={new Date(date)}
  width="read"
>
  <PageHero slot="hero" planet="moon" width="read" compact title={title} cmd="cat entry.md"
    path={`~/moon/diary/${entry.id}`}
    chips={[
      [new Date(date).toLocaleDateString('zh-TW', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' })],
      ...(mood || weather ? [[[mood, weather].filter(Boolean).join(' ')] as [string]] : []),
      ...(words ? [[words.toLocaleString('zh-TW'), ` 字 · 約 ${minutes} 分鐘`] as [string, string]] : []),
    ]} />
  <article>

    <div class="prose max-w-none">
      <Content />
    </div>

    <footer class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-700">
      <div class="flex gap-2">
        {tags.map(tag => (
          <span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-full text-sm">
            #{tag}
          </span>
        ))}
      </div>
    </footer>

    <div class="mt-8">
      <a href="/diary" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">
        ← 返回日記列表
      </a>
    </div>
    <ArticleEnd shareText={`derekkk 的日記「${title}」`} />
  </article>
</BaseLayout>
