---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

const allDiary = (await getCollection('diary'))
  .filter(entry => !entry.data.isPrivate)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<BaseLayout title="日記" description="生活記錄與心情日記" width="read">
  <PageHero slot="hero" planet="moon" width="read" title="日記" cmd="ls -t"
    desc="生活的點點滴滴。" chips={[[String(allDiary.length), '篇']]} />
  <div>

    {allDiary.length === 0 && (
      <p class="sh-label text-center py-12">還沒有日記，敬請期待！</p>
    )}

    <div class="space-y-6">
      {allDiary.map(entry => (
        <a href={`/diary/${entry.id}`} class="sh-card p-6">
          <div class="flex items-center gap-3 mb-3">
            {entry.data.mood && <span class="text-3xl">{entry.data.mood}</span>}
            <div>
              <time class="sh-label" style="margin: 0">
                {new Date(entry.data.date).toLocaleDateString('zh-TW', { timeZone: 'UTC',
                  year: 'numeric', month: 'long', day: 'numeric', weekday: 'long'
                })}
              </time>
              {entry.data.weather && (
                <span class="sh-label ml-2" style="margin: 0 0 0 8px">{entry.data.weather}</span>
              )}
            </div>
          </div>
          <h2 class="px-h2 mb-3" style="font-size: 24px">{entry.data.title}</h2>
          <div class="flex flex-wrap gap-2">
            {entry.data.tags.map(tag => (
              <span class="sh-tag">#{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
