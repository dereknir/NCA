---
/**
 * /live/footprint — にしな出演足跡(67 場活動落點 · 都道府縣熱區地圖)
 *
 * DATA: src/data/live_appearances.json (取 appearance[67])
 * SERIES: src/data/live_series.json (系列 ×N 分組)
 * 蓋章 localStorage key = 'nishina-visited' (與 concerts 頁共用)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import appearances from '../../data/live_appearances.json';
import series from '../../data/live_series.json';

const appList = appearances.appearance;
---

<BaseLayout title="にしな出演足跡" description="にしな 67 場音樂祭/活動出演,按都道府縣落點">
  <div class="fp-page">
    <h1>にしな出演足跡</h1>
    <p class="sub">{appList.length} 場音樂祭/活動出演,按都道府縣落點・點色塊看場次・按 ⭘ 蓋參戰章 · <a href="/live/">← 回 Live hub</a></p>
    <div id="mystats"></div>
    <div id="wrap">
      <div id="map"></div>
      <div id="side"><div class="ph">← 點一個縣</div></div>
    </div>
    <div id="unmapped"></div>
    <p class="foot">地點對照表為站長可編輯的關鍵字規則(頁內 GEO 常數)・未定位場次列於下方待補</p>
  </div>

  <style>
    .fp-page {
      max-width: 980px;
      margin: 0 auto;
      line-height: 1.6;
    }
    .fp-page h1 { font-size: 30px; letter-spacing: .08em; }
    .fp-page .sub { color: #8b97b8; font-size: 13px; margin-top: 6px; }
    .fp-page .sub a { color: #3d63ff; text-decoration: none; }
    .fp-page .sub a:hover { text-decoration: underline; }
    #wrap {
      display: grid; grid-template-columns: minmax(340px, 1fr) 300px; gap: 20px; margin-top: 26px;
    }
    #map {
      background: #141d31; border: 1px solid #243154; border-radius: 14px; padding: 16px;
    }
    #map svg { width: 100%; height: auto; }
    .tile { fill: #1a2440; stroke: #243154; stroke-width: 1; cursor: default; }
    .tile.hit { cursor: pointer; }
    .tile.hit:hover { stroke: #e8c94a; }
    .tile.sel { stroke: #e8c94a; stroke-width: 2; }
    .tlab { font-size: 9px; fill: #8b97b8; pointer-events: none; }
    .tnum {
      font-size: 10px; fill: #e8ecf6; pointer-events: none; font-weight: 700;
    }
    #side {
      background: #141d31; border: 1px solid #243154; border-radius: 14px; padding: 16px;
      font-size: 13px; max-height: 560px; overflow-y: auto;
    }
    #side .ph { color: #8b97b8; }
    #side h3 { font-size: 15px; margin-bottom: 8px; }
    .sgh { margin: 12px 0 2px; font-size: 12.5px; color: #e8c94a; letter-spacing: .03em; }
    .ev {
      padding: 7px 0; border-bottom: 1px solid rgba(36, 49, 84, .5);
      display: flex; align-items: center; gap: 8px;
    }
    .ev .d { color: #8b97b8; font-size: 11px; font-variant-numeric: tabular-nums; }
    .ev a { color: #e8ecf6; text-decoration: none; font-size: 13px; }
    .ev a:hover { color: #3d63ff; }
    .ev .cx { color: #c05555; font-size: 10px; margin-left: 6px; }
    .ev .body { flex: 1; min-width: 0; }
    .stx {
      width: 30px; height: 30px; flex: none; border: 1.5px solid #243154; border-radius: 50%;
      background: transparent; color: #8b97b8; font-size: 10px; cursor: pointer; font-family: inherit;
    }
    .stx.on {
      border-color: #d65555; color: #d65555; transform: rotate(-10deg); font-weight: 700;
    }
    #mystats { color: #8b97b8; font-size: 13px; margin-top: 10px; }
    #mystats b { color: #d65555; }
    #unmapped {
      margin-top: 22px; background: #141d31; border: 1px dashed #243154;
      border-radius: 14px; padding: 16px; font-size: 12.5px; color: #8b97b8;
    }
    #unmapped b { color: #e8ecf6; }
    @media (max-width: 760px) { #wrap { grid-template-columns: 1fr; } }
    .fp-page .foot { margin-top: 60px; color: #5a6784; font-size: 11.5px; text-align: center; }
  </style>

  <script is:inline define:vars={{ APP: appList, SERIES: series }}>
    const SNAME = {};   // news_url → 系列名(含單場系列,分組用)
    if (SERIES) for (const s of SERIES.series)
      for (const e of s.editions) SNAME[e.news_url] = s.series;

    /* 都道府縣グリッド座標 [col,row](タイルマップ,地理近似) */
    const PREF = {
     '北海道':[12,0],'青森':[12,1],'秋田':[11,2],'岩手':[12,2],'山形':[11,3],'宮城':[12,3],
     '新潟':[10,4],'福島':[12,4],
     '石川':[8,5],'富山':[9,5],'長野':[10,5],'群馬':[11,5],'栃木':[12,5],'茨城':[13,5],
     '福井':[8,6],'岐阜':[9,6],'山梨':[11,6],'埼玉':[12,6],'千葉':[13,6],
     '京都':[7,7],'滋賀':[8,7],'愛知':[9,7],'静岡':[10,7],'東京':[12,7],
     '兵庫':[6,8],'大阪':[7,8],'奈良':[8,8],'三重':[9,8],'神奈川':[12,8],
     '和歌山':[7,9],
     '島根':[3,7],'鳥取':[4,7],
     '山口':[2,8],'広島':[3,8],'岡山':[4,8],
     '愛媛':[3,9],'香川':[4,9],'徳島':[5,9],'高知':[4,10],
     '佐賀':[0,9],'福岡':[1,9],'大分':[2,9],'長崎':[0,10],'熊本':[1,10],'宮崎':[2,11],'鹿児島':[1,11],
     '沖縄':[0,13],
    };

    /* 活動 → 縣 對照規則,前綴命中優先;不確定的別亂填,留給未定位清單 */
    const GEO = [
     ['RUSH BALL','大阪'],['LOVE SHOWER','山梨'],['ROCK IN JAPAN','千葉'],['ロック・イン・ジャパン','千葉'],
     ['JAPAN JAM','千葉'],['COUNTDOWN JAPAN','千葉'],['ツタロック','千葉'],
     ['VIVA LA ROCK','埼玉'],['ビバラ','埼玉'],
     ['MONSTER baSH','香川'],['百万石','石川'],['森、道、市場','愛知'],['森道市場','愛知'],
     ['WILD BUNCH','山口'],['りんご音楽祭','長野'],['ARABAKI','宮城'],['荒吐','宮城'],
     ['TOKYO ISLAND','東京'],['SYNCHRONICITY','東京'],['YATSUI','東京'],['SHINJUKU','東京'],
     ['BAYCAMP','神奈川'],['GREENROOM','神奈川'],
     ['京都大作戦','京都'],['OTODAMA','大阪'],['RADIO CRAZY','大阪'],['FM802','大阪'],
     ['SAKAE SP-RING','愛知'],['MERRY ROCK PARADE','愛知'],['Merry Rock Parade','愛知'],
     ['FM NORTH WAVE','北海道'],['ROCK KIDS 802','大阪'],['PIA MUSIC','東京'],
     ['Osaka','大阪'],['Nagoya','愛知'],['Tokyo','東京'],
     ['宇都宮大学','栃木'],['徳島大学','徳島'],
     /* 泛用地名關鍵字(排最後,前綴規則優先) */
     ['大阪','大阪'],['東京','東京'],['京都','京都'],['幕張','千葉'],['横浜','神奈川'],
     ['名古屋','愛知'],['仙台','宮城'],['渋谷','東京'],['新宿','東京'],['下北沢','東京'],['日比谷','東京'],
    ];
    function locate(ev) {
      const src = ev.name + ' ' + (ev.venue || '');
      for (const [k, p] of GEO) if (src.includes(k)) return p;
      return null;
    }

    /* 參戰蓋章(存於本機瀏覽器;與公演史頁共用同一份紀錄) */
    const LS = 'nishina-visited';
    let visited = {};
    try { visited = JSON.parse(localStorage.getItem(LS) || '{}'); } catch (e) {}
    const saveV = () => { try { localStorage.setItem(LS, JSON.stringify(visited)); } catch (e) {} };
    let selPref = null;

    const byPref = {}, unmapped = [];
    for (const ev of APP) {
      const p = locate(ev);
      if (p) (byPref[p] = byPref[p] || []).push(ev);
      else unmapped.push(ev);
    }
    const maxN = Math.max(1, ...Object.values(byPref).map(a => a.length));
    const esc = s => s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

    /* 畫地圖(可重繪:蓋章後縣塊出現紅印) */
    const CELL = 40, GAP = 3;
    const side = document.getElementById('side');
    function renderMap() {
      let svg = `<svg viewBox="0 0 ${14 * (CELL + GAP) + GAP} ${14 * (CELL + GAP) + GAP}" xmlns="http://www.w3.org/2000/svg">`;
      for (const [name, [cx, cy]] of Object.entries(PREF)) {
        const evs = byPref[name] || [];
        const n = evs.length;
        const x = cx * (CELL + GAP) + GAP, y = cy * (CELL + GAP) + GAP;
        const heat = n ? 0.25 + 0.75 * (n / maxN) : 0;
        const fill = n ? `rgba(61,99,255,${heat.toFixed(2)})` : '';
        const been = evs.some(e => visited[e.news_url]);
        svg += `<rect class="tile${n ? ' hit' : ''}${name === selPref ? ' sel' : ''}" data-p="${name}" x="${x}" y="${y}"
            width="${CELL}" height="${CELL}" rx="6" ${fill ? `style="fill:${fill}"` : ''}></rect>
          <text class="tlab" x="${x + 4}" y="${y + 13}">${name.slice(0, 3)}</text>
          ${n ? `<text class="tnum" x="${x + CELL - 5}" y="${y + CELL - 6}" text-anchor="end">${n}</text>` : ''}
          ${been ? `<circle cx="${x + 8}" cy="${y + CELL - 10}" r="4" fill="#d65555"/>` : ''}`;
      }
      svg += '</svg>';
      document.getElementById('map').innerHTML = svg;
      document.querySelectorAll('.tile.hit').forEach(t =>
        t.addEventListener('click', () => openPref(t.dataset.p)));
    }
    function updateStats() {
      const stamped = Object.keys(visited).filter(k => !k.startsWith('oneman:'));
      const prefs = new Set();
      for (const [p, evs] of Object.entries(byPref))
        if (evs.some(e => visited[e.news_url])) prefs.add(p);
      document.getElementById('mystats').innerHTML = stamped.length
        ? `你的足跡:<b>${stamped.length}</b> 場出演・<b>${prefs.size}</b> 個都道府縣`
        : '去過的場次按 ⭘ 蓋章,足跡會落在地圖上(僅存於你的瀏覽器)';
    }
    function openPref(p) {
      selPref = p;
      renderMap();
      const evs = byPref[p];
      // 按系列分組:多回系列列在前(帶 ×N 標頭),單場平列在後
      const g = {};
      for (const e of evs) {
        const k = SNAME[e.news_url] || e.name;
        (g[k] = g[k] || []).push(e);
      }
      const row = e => `<div class="ev">
          <button class="stx${visited[e.news_url] ? ' on' : ''}" data-k="${esc(e.news_url)}">${visited[e.news_url] ? '印' : '⭘'}</button>
          <div class="body"><div class="d">${esc(e.event_date || e.date_text)}</div>
          <a href="${esc(e.news_url)}" target="_blank" rel="noopener">${esc(e.name)}</a>
          ${e.status ? '<span class="cx">中止</span>' : ''}</div></div>`;
      const multi = Object.entries(g).filter(([, a]) => a.length >= 2)
        .sort((a, b) => b[1].length - a[1].length);
      const single = Object.entries(g).filter(([, a]) => a.length === 1)
        .flatMap(([, a]) => a)
        .sort((a, b) => (a.event_date || '').localeCompare(b.event_date || ''));
      side.innerHTML = `<h3>${p}(${evs.length} 場)</h3>`
        + multi.map(([name, a]) => `<div class="sgh">${esc(name)} ×${a.length}</div>`
            + a.sort((x, y) => (x.event_date || '').localeCompare(y.event_date || '')).map(row).join('')).join('')
        + (multi.length && single.length ? `<div class="sgh" style="color:#8b97b8">單次出演</div>` : '')
        + single.map(row).join('');
    }
    side.addEventListener('click', e => {
      const b = e.target.closest('.stx');
      if (!b) return;
      const k = b.dataset.k;
      if (visited[k]) delete visited[k]; else visited[k] = Date.now();
      saveV();
      renderMap();
      updateStats();
      if (selPref) openPref(selPref);
    });
    renderMap();
    updateStats();

    document.getElementById('unmapped').innerHTML =
      `<b>未定位 ${unmapped.length} 場</b>(補 GEO 規則後自動上圖):<br>` +
      unmapped.map(e => `${esc(e.event_date || e.date_text)} ${esc(e.name)}`).join('・');
  </script>
</BaseLayout>
