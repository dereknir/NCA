---
/**
 * /live/full/ — 完整 Live 列表: 目前能從第一句聽到最後一句的歌
 * (還差幾句的進度不公開, 只在審片工具裡給自己看)
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import data from '../../../data/full_live.json';
import { summary, type FLSong } from '../../../lib/fullLive';
import { coverAt } from '../../../lib/covers';

const covers = Object.fromEntries((await getCollection('translations')).map(t => [t.id, t.data]));
const songs = (data.songs as FLSong[])
  .map(song => ({ song, sum: summary(song), meta: covers[song.id] }))
  .filter(x => x.sum.complete)
  .sort((a, b) => b.sum.liveShorts - a.sum.liveShorts);
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
---

<BaseLayout title="完整 Live" description="把不同場次的演唱會 shorts 照歌詞一句一句接起來，從第一句聽到最後一句。" width="wide">
  <PageHero slot="hero" planet="deimos" title="完整 Live" cmd="ls --full"
    desc="把不同場次的演唱會 shorts 照歌詞一句一句接起來，從第一句聽到最後一句。"
    chips={[[String(songs.length), '首可以完整聽完']]} />
  <div class="flx">
    {songs.map(({ song, sum, meta }) => (
      <a class="flx-it" href={`/live/full/${song.id}/`}>
        {meta?.coverImage ? <img src={coverAt(meta.coverImage, 80)} alt="" width="64" height="64" loading="lazy" /> : <span class="flx-ph"></span>}
        <span class="flx-t" lang="ja">{song.title}</span>
        <span class="flx-m">{meta?.album ?? ''}</span>
        <span class="flx-m">{sum.segs} 段・{fmt(sum.duration)}{sum.nonLive > 0 && <em>含 MV {sum.nonLiveLines} 句</em>}</span>
        <span class="flx-go">▶</span>
      </a>
    ))}
  </div>
  <p class="flx-note">演唱會 shorts 都來自にしな官方頻道。每審完一批 shorts 就會重算一次，能完整聽完的歌會慢慢變多。</p>
</BaseLayout>

<style>
  .flx { display: grid; gap: 8px; }
  .flx-it { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto auto 24px; align-items: center; gap: 20px; padding: 12px 16px;
    background: rgb(15 15 29 / .7); border: 2px solid var(--sh-line); color: var(--sh-ink); text-decoration: none; font: 12px var(--sh-px); }
  .flx-it:hover { border-color: rgb(var(--sh-accent)); }
  .flx-it img, .flx-ph { width: 64px; height: 64px; display: block; background: #111; }
  .flx-t { font: 24px/1.3 var(--sh-pxja); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .flx-m { color: var(--sh-ink3); white-space: nowrap; }
  .flx-m em { font-style: normal; margin-left: 8px; padding: 0 6px; color: #0a0a15; background: var(--sh-ink2); }
  .flx-go { color: rgb(var(--sh-accent)); }
  .flx-note { margin: 24px 0 64px; font: 12px/1.8 var(--sh-px); color: var(--sh-ink3); }
  @media (max-width: 760px) {
    .flx-it { grid-template-columns: 56px minmax(0, 1fr) 20px; gap: 4px 14px; }
    .flx-it img, .flx-ph { width: 56px; height: 56px; grid-row: span 3; }
    .flx-t { font-size: 24px; }
    .flx-go { grid-row: 1 / span 3; grid-column: 3; }
  }
</style>
