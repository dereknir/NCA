---
/**
 * /live/concerts — にしな公演史(10 場個人公演, 參戰蓋章)
 *
 * DATA: src/data/live_appearances.json (取 oneman[10])
 * 蓋章存於 localStorage key = 'nishina-visited' (與 footprint 頁共用)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import appearances from '../../data/live_appearances.json';

const oneman = appearances.oneman;

/* 各場 setlist 短連結(lnk.to),key = 場次序號 1-10 */
const SETLIST_URLS: Record<number, string> = {
  // 5: 'https://nishina.lnk.to/CBJ_setlist',   // 例:クランベリー巡演
};
---

<BaseLayout title="にしな公演史" description="にしな 全 10 場個人公演">
  <div class="cc-page">
    <h1>にしな公演史</h1>
    <p class="sub">個人公演全 {oneman.length} 場・2021「hatsu」→ 2026「日々散漫」 · <a href="/live/">← 回 Live hub</a></p>
    <div id="att"></div>
    <div id="list"></div>
    <p class="foot">news 連結指向官方・SETLIST 連結由站長自 lnk.to 各場短連結填入</p>
  </div>

  <style>
    .cc-page {
      max-width: 760px;
      margin: 0 auto;
      line-height: 1.7;
    }
    .cc-page h1 { font-size: 30px; letter-spacing: .08em; }
    .cc-page .sub { color: #8b97b8; font-size: 13px; margin-top: 6px; }
    .cc-page .sub a { color: #3d63ff; text-decoration: none; }
    .cc-page .sub a:hover { text-decoration: underline; }
    .card {
      background: #141d31; border: 1px solid #243154; border-radius: 14px;
      padding: 20px 22px; margin-top: 20px; position: relative;
    }
    .num {
      position: absolute; top: 16px; right: 20px; font-size: 26px; color: #2a3a63;
      font-variant-numeric: tabular-nums; letter-spacing: .05em;
    }
    .name { font-size: 18px; padding-right: 64px; }
    .period { color: #e8c94a; font-size: 13px; margin-top: 6px; font-variant-numeric: tabular-nums; }
    .period.todo { color: #8b97b8; font-style: italic; }
    .links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }
    .links a {
      font-size: 12px; border: 1px solid #243154; border-radius: 99px; padding: 4px 12px;
      color: #8b97b8; text-decoration: none;
    }
    .links a:hover { border-color: #3d63ff; color: #3d63ff; }
    .links a.setlist { border-color: #e8c94a; color: #e8c94a; }
    .links a.setlist.todo { opacity: .4; pointer-events: none; }
    .stamp {
      display: none; position: absolute; right: 64px; top: 12px; transform: rotate(-11deg);
      border: 2.5px solid #d65555; color: #d65555; border-radius: 9px; padding: 5px 12px;
      font-size: 14px; letter-spacing: .25em; opacity: .9; pointer-events: none;
    }
    .stamp small {
      display: block; font-size: 9px; letter-spacing: .05em; text-align: center; margin-top: 1px;
    }
    .card.stamped .stamp { display: block; }
    .stbtn {
      font-size: 12px; border: 1px solid #243154; border-radius: 99px; padding: 4px 12px;
      color: #8b97b8; background: transparent; cursor: pointer; font-family: inherit;
    }
    .stbtn:hover { border-color: #d65555; color: #d65555; }
    .card.stamped .stbtn { border-color: #d65555; color: #d65555; }
    #att { color: #8b97b8; font-size: 13px; margin-top: 14px; }
    #att b { color: #d65555; }
    .cc-page .foot { margin-top: 70px; color: #5a6784; font-size: 11.5px; text-align: center; }
  </style>

  <script is:inline define:vars={{ ONEMAN: oneman, SETLIST_URLS }}>
    /* 參戰蓋章(存於本機瀏覽器;與出演足跡頁共用同一份紀錄) */
    const LS = 'nishina-visited';
    let visited = {};
    try { visited = JSON.parse(localStorage.getItem(LS) || '{}'); } catch (e) {}
    const saveV = () => { try { localStorage.setItem(LS, JSON.stringify(visited)); } catch (e) {} };
    const esc = s => s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
    const list = document.getElementById('list');
    function updateAtt() {
      const n = ONEMAN.filter((_, i) => visited['oneman:' + (i + 1)]).length;
      document.getElementById('att').innerHTML =
        n ? `你的參戰:<b>${n}</b> / ${ONEMAN.length} 場公演`
          : '參戰過的公演,按「参戦」蓋個章吧(僅存於你的瀏覽器)';
    }
    ONEMAN.forEach((ev, idx) => {
      const n = idx + 1;
      const key = 'oneman:' + n;
      const card = document.createElement('div');
      card.className = 'card' + (visited[key] ? ' stamped' : '');
      const todo = ev.note ? ' todo' : '';
      const sl = SETLIST_URLS[n];
      card.innerHTML = `
        <div class="num">${String(n).padStart(2, '0')}</div>
        <div class="name">${esc(ev.name)}</div>
        <div class="period${todo}">${esc(ev.period)}${ev.note ? '(' + esc(ev.note) + ')' : ''}</div>
        <div class="links">
          ${ev.news.map(nw => `<a href="${esc(nw.url)}" target="_blank" rel="noopener">news: ${esc(nw.title.slice(0, 18))}…</a>`).join('')}
          <a class="setlist${sl ? '' : ' todo'}" href="${sl || '#'}" target="_blank" rel="noopener">♪ SETLIST${sl ? '' : '(待填)'}</a>
          <button class="stbtn"></button>
        </div>
        <div class="stamp">参戦<small></small></div>`;
      const btn = card.querySelector('.stbtn'), st = card.querySelector('.stamp small');
      const paint = () => {
        const v = visited[key];
        card.classList.toggle('stamped', !!v);
        btn.textContent = v ? '取消蓋章' : '参戦した!';
        if (v) st.textContent = new Date(v).toISOString().slice(0, 10);
      };
      btn.onclick = () => {
        if (visited[key]) delete visited[key]; else visited[key] = Date.now();
        saveV(); paint(); updateAtt();
      };
      paint();
      list.appendChild(card);
    });
    updateAtt();
  </script>
</BaseLayout>
