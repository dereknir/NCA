---
/**
 * /live/ — にしな 演出資料 hub
 *
 * 三個子頁面是 live/inject.py 注入產出的靜態頁(public/live/<page>/index.html):
 *   /live/timeline/    年表(官方 news 全量 · 六色篩選 · 搜尋 · 未來場次 .ics)
 *   /live/concerts/    公演史(10 場個人公演 · setlist 歌單選單 · 參戰蓋章)
 *   /live/footprint/   出演足跡(真實日本地圖 · 巡演站點圖層 · 足跡の旅 · 參戰卡)
 *
 * 資料更新流程: 改 live/data/*.json → python live/inject.py → commit
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlanetHeroBanner from '../../components/PlanetHeroBanner.astro';
import events from '../../../live/data/nishina_live_events.json';
import news from '../../../live/data/nishina_news_classified.json';
import tours from '../../../live/data/tour_stops.json';

const oneman = events.oneman.length;
const app = events.appearance.length;
const total = news.length;
const stops = tours.meta.total_stops;
---

<BaseLayout title="にしな 演出資料" description="にしな 公演史・出演足跡・年表">
  <PlanetHeroBanner slot="hero" nameJa="火星" title="Live 演出" sub="LIVE DATA HUB"
    glType="dry" seed={3.7} palette={[[255,168,130],[230,96,72],[178,62,50],[116,40,34],[58,24,22],[0,0,0]]} />
  <div class="max-w-4xl mx-auto">
    <h1 class="px text-4xl font-bold mb-2">にしな 演出資料</h1>
    <p class="text-gray-400 text-sm mb-10">
      官方 news {total} 條・{oneman} 場個人公演({stops} 站)・{app} 場音樂祭活動出演
    </p>

    <div class="grid gap-5 md:grid-cols-3">
      <a href="/live/timeline/" class="hub-card">
        <div class="hub-emoji">🗓</div>
        <h2>年表</h2>
        <p class="hub-sub">六色標籤篩選 + 搜尋(?q= 深連結)。未來場次倒數、一鍵加入行事曆(.ics)</p>
        <div class="hub-num">{total} 件</div>
      </a>
      <a href="/live/concerts/" class="hub-card">
        <div class="hub-emoji">🎤</div>
        <h2>公演史</h2>
        <p class="hub-sub">2021「hatsu」→ 2026「日々散漫」全 {oneman} 場。各場巡演站數、setlist 歌單直連、參戰蓋章</p>
        <div class="hub-num">{oneman} 場</div>
      </a>
      <a href="/live/footprint/" class="hub-card">
        <div class="hub-emoji">🗾</div>
        <h2>出演足跡</h2>
        <p class="hub-sub">真實縣界日本地圖,公演/出演雙圖層。「足跡の旅」時間軸動畫、像素參戰卡生成</p>
        <div class="hub-num">{app + stops} 點</div>
      </a>
    </div>

    <p class="text-xs text-gray-500 mt-10">
      資料源:nishina247.jp/news(2021.04 開站起)・僅日期/標題/連結,內文請至官方
    </p>
  </div>

  <style>
    .hub-card {
      display: block;
      background: #141d31;
      border: 1px solid #243154;
      border-radius: 14px;
      padding: 24px 22px;
      color: inherit;
      text-decoration: none;
      transition: transform .15s ease, border-color .15s ease;
      position: relative;
    }
    .hub-card:hover {
      transform: translateY(-2px);
      border-color: #3d63ff;
    }
    .hub-emoji { font-size: 36px; margin-bottom: 8px; }
    .hub-card h2 {
      font-size: 20px;
      font-weight: 700;
      margin: 0 0 8px;
      letter-spacing: .04em;
    }
    .hub-sub {
      font-size: 13px;
      color: #8b97b8;
      line-height: 1.6;
      min-height: 4em;
    }
    .hub-num {
      position: absolute;
      top: 18px;
      right: 20px;
      font-size: 15px;
      color: #e8c94a;
      font-variant-numeric: tabular-nums;
      letter-spacing: .05em;
    }
  </style>
</BaseLayout>
