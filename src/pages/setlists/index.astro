---
/**
 * setlists/index.astro — にしな 巡演 setlist 一覽 (10 場)
 *
 * 資料來源 src/data/setlists.json 由 scripts/scrape_setlists.py 每日更新
 * (從 https://nishina.lnk.to/live_setlist 抓 Linkfire hub + 各場 Spotify
 * embed page 的 __NEXT_DATA__ tracklist)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import setlists from '../../data/setlists.json';

interface Track {
  index: number;
  title: string;
  artist: string;
  uid: string;
  matched_song_id: string | null;
  match_score: number;
}
interface Tour {
  title: string;
  date: string;
  spotify: string | null;
  applemusic: string | null;
  cover: string | null;
  tracks: Track[];
  track_count: number;
  matched_count: number;
}

const tours = (setlists.tours as Tour[]).slice().reverse();  // 最新在上
const meta = setlists.meta;
---

<BaseLayout title="巡演 Setlist" description="にしな 歷年巡演的完整 setlist,含每首歌的翻譯連結">
  <div class="max-w-5xl mx-auto">
    <h1 class="text-4xl font-bold mb-2">巡演 Setlist</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-2">
      にしな 歷年巡演的完整曲目清單。每首歌都連到對應的翻譯頁,對得上的話。
    </p>
    <p class="text-xs text-gray-500 dark:text-gray-500 mb-8">
      資料源：
      <a href="https://nishina.lnk.to/live_setlist" target="_blank" rel="noopener noreferrer"
         class="text-blue-500 hover:underline">nishina.lnk.to/live_setlist</a>
      · Spotify embed public tracklist
      · 更新於 {meta.generated?.slice(0, 10) ?? '—'}
      · {meta.tour_count} 場 · {meta.total_tracks} 首次入單
    </p>

    <div class="grid gap-6">
      {tours.map(tour => (
        <article class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800/50 overflow-hidden">
          {/* header: cover on left + title/date/stats on right */}
          <header class="p-5 border-b border-gray-200 dark:border-gray-700 flex gap-5">
            {tour.cover && (
              <img src={tour.cover} alt={`${tour.title} 巡演封面`}
                   width="120" height="120" loading="lazy"
                   class="w-24 h-24 md:w-28 md:h-28 rounded-lg object-cover flex-shrink-0
                          border border-gray-200 dark:border-gray-700 shadow-sm" />
            )}
            <div class="flex-1 min-w-0 flex flex-col justify-center gap-1">
              <h2 class="text-2xl font-bold leading-tight">{tour.title}</h2>
              <span class="text-sm text-gray-500 dark:text-gray-400 font-mono">{tour.date}</span>
              <span class="text-xs text-gray-600 dark:text-gray-400 mt-1">
                {tour.matched_count} / {tour.track_count} 首已翻譯
              </span>
            </div>
          </header>

          {/* action buttons */}
          <div class="px-5 pt-4 flex flex-wrap gap-2">
            {tour.spotify && (
              <a href={tour.spotify} target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold
                        bg-green-600 hover:bg-green-700 text-white transition">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.42 1.56-.301.42-1.02.599-1.56.3z"/>
                </svg>
                在 Spotify 開啟
              </a>
            )}
            {tour.applemusic && (
              <a href={tour.applemusic} target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold
                        bg-gray-900 hover:bg-black text-white transition
                        border border-gray-700">
                在 Apple Music 開啟
              </a>
            )}
          </div>

          {/* tracklist */}
          <ol class="p-5 grid gap-1.5 md:grid-cols-2">
            {tour.tracks.map(tr => (
              <li class="flex items-baseline gap-3 text-sm">
                <span class="text-xs text-gray-400 dark:text-gray-500 font-mono w-6 flex-shrink-0 text-right">
                  {String(tr.index).padStart(2, '0')}
                </span>
                {tr.matched_song_id ? (
                  <a href={`/translations/${tr.matched_song_id}`}
                     class="text-gray-800 dark:text-gray-100 hover:text-blue-500 dark:hover:text-blue-400
                            hover:underline decoration-1 underline-offset-2 transition min-w-0 flex-1">
                    {tr.title}
                    {tr.artist && tr.artist !== 'nishina' && (
                      <span class="text-xs text-gray-500 dark:text-gray-400 ml-1.5">
                        (with {tr.artist.replace('nishina, ', '')})
                      </span>
                    )}
                  </a>
                ) : (
                  <span class="text-gray-400 dark:text-gray-500 min-w-0 flex-1 italic">
                    {tr.title}
                    <span class="text-xs ml-1.5 not-italic">(尚未翻譯)</span>
                  </span>
                )}
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>

    <p class="text-xs text-gray-500 dark:text-gray-500 mt-10 leading-relaxed">
      Setlist 為公開事實資料,曲目順序依 にしな 官方 Linkfire hub 提供的 Spotify 播放列表為準。<br>
      每首歌連結至本站的中文翻譯頁; 尚未翻譯的曲目以斜體標示。
    </p>
  </div>
</BaseLayout>
