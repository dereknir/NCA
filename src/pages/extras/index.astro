---
/**
 * extras/index.astro — にしな「花絮」— 音樂之外的 shorts 分類展示
 *
 * 資料來源 src/data/shorts_extras.json 由 scripts/import_anchors.py 產出
 * (從 annotation/shorts_anchors.json 讀取被標為 __ad/__mc/__cover/__tv 的 shorts)
 *
 * OTHERS (__others) 桶不上網站 — 那是 annotator 內部「還沒分好」的暫存區。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import extras from '../../data/shorts_extras.json';

interface Short {
  videoId: string;
  title: string;
  url: string;
  thumbnail: string;
  viewCount: number;
  // __live_song 出演演唱專屬 (其他類別為 undefined)
  appearanceName?: string | null;
  songTitle?: string | null;
  songId?: string | null;
}
interface Category {
  displayName: string;
  emoji: string;
  count: number;
  shorts: Short[];
}

const categories = extras.categories as Record<string, Category>;
const meta = extras.meta;

// tab 顯示順序 (跟 annotator 的順序一致)
const TAB_ORDER = ['live_song', 'mc', 'ad', 'promo', 'cover', 'tv', 'travel', 'yearly', 'daily'];
const orderedCategories = TAB_ORDER
  .map(k => ({ key: k, ...categories[k] }))
  .filter(c => c.displayName);   // 保護: 若 schema 少 category, 不 crash

// 預設打開第一個「非空」tab (避免 live_song 還沒標注時一進來就是空畫面)
const activeIdx = Math.max(0, orderedCategories.findIndex(c => c.count > 0));

function formatViews(n: number): string {
  if (n >= 10000) return `${(n / 10000).toFixed(1)}萬`;
  if (n >= 1000)  return `${(n / 1000).toFixed(1)}k`;
  return String(n);
}
---

<BaseLayout title="花絮" description="にしな 音樂之外的 shorts 內容分類展示">
  <div class="max-w-6xl mx-auto">
    <h1 class="text-4xl font-bold mb-2">花絮</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-2">
      除了歌曲翻譯之外,にしな 的 YouTube shorts 還包含出演現場的演唱片段、演唱會 MC、
      廣告代言、電視節目片段和翻唱 —— 這裡是這些「正式作品以外」的各種片段。
    </p>
    <p class="text-xs text-gray-500 dark:text-gray-500 mb-8">
      共 {meta.total} 支 · 分為 {orderedCategories.length} 類 · 資料來源:手動分類 annotator + YouTube shorts
    </p>

    {meta.total === 0 ? (
      <div class="rounded-xl border border-dashed border-gray-300 dark:border-gray-700 p-10 text-center text-gray-500 dark:text-gray-400 text-sm">
        還沒有 shorts 被分到這些類別。<br>
        <span class="text-xs">在 <a href="/annotate/" class="text-blue-500 hover:underline">/annotate/</a> 挑一支未匹配的 short,選擇底部的「非歌曲類別」就會在這裡出現。</span>
      </div>
    ) : (
      <div class="extras-container">
        {/* tab 列 */}
        <div class="flex flex-wrap gap-2 mb-6 border-b border-gray-200 dark:border-gray-700 pb-3" id="extraTabs">
          {orderedCategories.map((cat, i) => (
            <button
              class={`tab-btn px-4 py-2 rounded-lg text-sm font-medium transition ${
                i === activeIdx
                  ? 'bg-blue-500 text-white'
                  : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'
              }`}
              data-tab={cat.key}>
              {cat.emoji} {cat.displayName}
              <span class="ml-1.5 text-xs opacity-80 font-mono">{cat.count}</span>
            </button>
          ))}
        </div>

        {/* 各 tab 的 grid panel */}
        {orderedCategories.map((cat, i) => (
          <section
            class={`extras-panel grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 ${i === activeIdx ? '' : 'hidden'}`}
            data-panel={cat.key}>
            {cat.shorts.length === 0 && (
              <div class="col-span-full text-center py-10 text-sm text-gray-500 dark:text-gray-500 italic">
                目前這個類別還沒有 short。
              </div>
            )}
            {cat.shorts.map(s => (
              <div class="group block rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700
                          bg-white dark:bg-gray-800/50 hover:shadow-lg transition">
                <div class="thumb-wrap aspect-[9/16] overflow-hidden bg-gray-100 dark:bg-gray-900 relative cursor-pointer"
                     data-vid={s.videoId}>
                  <img src={s.thumbnail} alt={s.title} loading="lazy"
                       class="thumb-img w-full h-full object-cover group-hover:scale-105 transition" />
                  <div class="play-ov absolute inset-0 flex items-center justify-center pointer-events-none">
                    <div class="w-12 h-12 rounded-full bg-black/55 group-hover:bg-red-600/90 transition flex items-center justify-center">
                      <svg class="w-5 h-5" style="margin-left:2px" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                  </div>
                  <div class="views-badge absolute bottom-1 right-1 bg-black/60 text-white text-xs px-1.5 py-0.5 rounded font-mono pointer-events-none">
                    ▶ {formatViews(s.viewCount)}
                  </div>
                  <a href={s.url} target="_blank" rel="noopener noreferrer" title="在 YouTube 開啟"
                     class="yt-link absolute top-1 right-1 bg-black/60 hover:bg-red-600 text-white text-sm w-6 h-6 rounded flex items-center justify-center opacity-0 group-hover:opacity-100 transition">↗</a>
                </div>
                <div class="p-2.5">
                  {(s.appearanceName || s.songTitle) ? (
                    <div>
                      <div class="text-xs font-medium text-gray-800 dark:text-gray-100 line-clamp-1 leading-snug">
                        {s.appearanceName ?? '(未指定場次)'}
                      </div>
                      <div class="text-[11px] text-gray-500 dark:text-gray-400 line-clamp-1 mt-0.5">
                        · {s.songTitle ?? '未指定歌曲'}
                      </div>
                    </div>
                  ) : (
                    <div class="text-xs text-gray-700 dark:text-gray-200 line-clamp-2 leading-snug">
                      {s.title}
                    </div>
                  )}
                </div>
              </div>
            ))}
          </section>
        ))}
      </div>
    )}
  </div>

  <script is:inline>
    // Tab 切換: click .tab-btn → 顯示對應 .extras-panel
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.tab;
        document.querySelectorAll('.tab-btn').forEach(b => {
          const active = b.dataset.tab === key;
          b.classList.toggle('bg-blue-500', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('bg-gray-100', !active);
          b.classList.toggle('dark:bg-gray-800', !active);
          b.classList.toggle('text-gray-700', !active);
          b.classList.toggle('dark:text-gray-300', !active);
        });
        document.querySelectorAll('.extras-panel').forEach(p => {
          p.classList.toggle('hidden', p.dataset.panel !== key);
        });
        stopAllPlaying();   // 切 tab 時停掉正在播的 short
      });
    });

    // 花絮卡片: 點縮圖 → 就地內嵌 YouTube 播放 (不跳頁、不彈窗; 一次只播一個)
    function stopAllPlaying(except){
      document.querySelectorAll('.thumb-wrap.playing').forEach(w => {
        if (w === except) return;
        w.classList.remove('playing');
        const f = w.querySelector('iframe');
        if (f) f.remove();
      });
    }
    document.querySelectorAll('.thumb-wrap').forEach(w => {
      w.addEventListener('click', () => {
        if (w.classList.contains('playing')) return;   // 已在播, 忽略
        stopAllPlaying(w);
        const ifr = document.createElement('iframe');
        ifr.src = `https://www.youtube.com/embed/${w.dataset.vid}?autoplay=1&playsinline=1&rel=0`;
        ifr.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        ifr.setAttribute('allowfullscreen', '');
        ifr.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
        w.appendChild(ifr);
        w.classList.add('playing');
      });
    });
    // 右上角 ↗ 只去 YouTube 原頁, 不觸發就地播放
    document.querySelectorAll('.yt-link').forEach(a =>
      a.addEventListener('click', e => e.stopPropagation()));
  </script>

  <style>
    /* 就地播放時, 蓋掉縮圖/播放鈕/角標 (iframe 已定位在 .thumb-wrap 內填滿) */
    .thumb-wrap.playing .thumb-img,
    .thumb-wrap.playing .play-ov,
    .thumb-wrap.playing .views-badge,
    .thumb-wrap.playing .yt-link { display: none; }
  </style>
</BaseLayout>
