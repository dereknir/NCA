---
/**
 * extras/index.astro — にしな「花絮」— 音樂之外的 shorts 分類展示
 *
 * 資料來源 src/data/shorts_extras.json 由 scripts/import_anchors.py 產出
 * (從 annotation/shorts_anchors.json 讀取被標為 __ad/__mc/__cover/__tv 的 shorts)
 *
 * OTHERS (__others) 桶不上網站 — 那是 annotator 內部「還沒分好」的暫存區。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import extras from '../../data/shorts_extras.json';

interface Short {
  videoId: string;
  title: string;
  url: string;
  thumbnail: string;
  viewCount: number;
  // __live_song 出演演唱專屬 (其他類別為 undefined)
  appearanceName?: string | null;
  songTitle?: string | null;
  songId?: string | null;
}
interface Category {
  displayName: string;
  emoji: string;
  count: number;
  shorts: Short[];
}

const categories = extras.categories as Record<string, Category>;
const meta = extras.meta;

// tab 顯示順序 (跟 annotator 的順序一致)
const TAB_ORDER = ['live_song', 'mc', 'ad', 'promo', 'cover', 'tv', 'travel', 'yearly', 'daily'];
const orderedCategories = TAB_ORDER
  .map(k => ({ key: k, ...categories[k] }))
  .filter(c => c.displayName);   // 保護: 若 schema 少 category, 不 crash

// 預設打開第一個「非空」tab (避免 live_song 還沒標注時一進來就是空畫面)
const activeIdx = Math.max(0, orderedCategories.findIndex(c => c.count > 0));

function formatViews(n: number): string {
  if (n >= 10000) return `${(n / 10000).toFixed(1)}萬`;
  if (n >= 1000)  return `${(n / 1000).toFixed(1)}k`;
  return String(n);
}
---

<BaseLayout title="花絮" description="にしな 音樂之外的 shorts 內容分類展示" width="wide">
  <PageHero slot="hero" planet="phobos" title="花絮" cmd="ls shorts/"
    desc="にしな 的 YouTube shorts 裡，歌曲以外的現場片段、MC、廣告、節目和翻唱。"
    chips={[[String(meta.total), '支'], [String(orderedCategories.length), '類']]} />
  <div>
    <p class="sh-label mb-8">
      共 {meta.total} 支 · 分為 {orderedCategories.length} 類 · 資料來源:手動分類 annotator + YouTube shorts
    </p>

    {meta.total === 0 ? (
      <div class="sh-card p-10 text-center sh-label" style="border-style: dashed">
        還沒有 shorts 被分到這些類別。<br>
        在 <a href="/annotate/" class="sh-link">/annotate/</a> 挑一支未匹配的 short,選擇底部的「非歌曲類別」就會在這裡出現。
      </div>
    ) : (
      <div class="extras-container">
        {/* 分類: 單選開關 (aria-pressed), 一次顯示一類 */}
        <div class="ex-tabs" id="extraTabs" role="group" aria-label="花絮分類">
          {orderedCategories.map((cat, i) => (
            <button type="button" class="tab-btn" aria-pressed={i === activeIdx ? 'true' : 'false'} data-tab={cat.key}>
              {cat.emoji} {cat.displayName}<small>{cat.count}</small>
            </button>
          ))}
        </div>

        {/* 各分類的格子 */}
        {orderedCategories.map((cat, i) => (
          <section
            class={`extras-panel grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 ${i === activeIdx ? '' : 'hidden'}`}
            data-panel={cat.key}>
            {cat.shorts.length === 0 && (
              <div class="col-span-full text-center py-10 sh-label">目前這個類別還沒有 short。</div>
            )}
            {cat.shorts.map(s => (
              <div class="sh-card ex-card">
                <div class="thumb-wrap aspect-[9/16] overflow-hidden relative" data-vid={s.videoId}>
                  <img src={s.thumbnail} alt="" loading="lazy" class="thumb-img w-full h-full object-cover" />
                  {/* 整張縮圖就是播放鈕 (鍵盤也按得到); 就地內嵌播放 */}
                  <button type="button" class="play-ov" aria-label={`播放「${s.title}」`}>
                    <span aria-hidden="true"><svg viewBox="0 0 7 7" width="14" height="14" shape-rendering="crispEdges" fill="currentColor"><path d="M1 0h1v1h1v1h1v1h1v1H4v1H3v1H2v1H1z"/></svg></span>
                  </button>
                  <span class="views-badge">▶ {formatViews(s.viewCount)}</span>
                  <a href={s.url} target="_blank" rel="noopener noreferrer" title="在 YouTube 開啟" aria-label={`在 YouTube 開啟「${s.title}」`} class="yt-link">↗</a>
                </div>
                <div class="ex-t">
                  {(s.appearanceName || s.songTitle) ? (
                    <div>
                      <div class="a">{s.appearanceName ?? '(未指定場次)'}</div>
                      <div class="b">· {s.songTitle ?? '未指定歌曲'}</div>
                    </div>
                  ) : (
                    <div class="c">{s.title}</div>
                  )}
                </div>
              </div>
            ))}
          </section>
        ))}
      </div>
    )}
  </div>

  <script is:inline>
    // 分類切換: 按下的那顆 aria-pressed, 顯示對應的格子
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.tab;
        document.querySelectorAll('.tab-btn').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.tab === key)));
        document.querySelectorAll('.extras-panel').forEach(p => {
          p.classList.toggle('hidden', p.dataset.panel !== key);
        });
        stopAllPlaying();   // 切分類時停掉正在播的 short
      });
    });

    // 花絮卡片: 按縮圖上的播放 → 就地內嵌 YouTube 播放 (不跳頁、不彈窗; 一次只播一個)
    function stopAllPlaying(except){
      document.querySelectorAll('.thumb-wrap.playing').forEach(w => {
        if (w === except) return;
        w.classList.remove('playing');
        const f = w.querySelector('iframe');
        if (f) f.remove();
      });
    }
    document.querySelectorAll('.thumb-wrap .play-ov').forEach(btn => {
      btn.addEventListener('click', () => {
        const w = btn.closest('.thumb-wrap');
        if (w.classList.contains('playing')) return;
        stopAllPlaying(w);
        const ifr = document.createElement('iframe');
        ifr.src = `https://www.youtube.com/embed/${w.dataset.vid}?autoplay=1&playsinline=1&rel=0`;
        ifr.title = btn.getAttribute('aria-label').replace(/^播放/, '');
        ifr.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        ifr.setAttribute('allowfullscreen', '');
        ifr.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
        w.appendChild(ifr);
        w.classList.add('playing');
        ifr.focus();
      });
    });
  </script>

  <style>
    .ex-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 24px; padding-bottom: 14px; border-bottom: 1px dashed var(--sh-line); }
    .ex-tabs button { display: inline-flex; align-items: center; gap: 6px; font: 12px var(--sh-px); letter-spacing: .06em; color: var(--sh-ink2);
      background: rgb(10 10 21 / .6); border: 2px solid var(--sh-line); padding: 7px 12px; cursor: pointer; }
    .ex-tabs button small { font-size: 12px; color: var(--sh-ink3); }
    .ex-tabs button:hover { border-color: var(--sh-gold); color: var(--sh-gold); }
    .ex-tabs button[aria-pressed="true"] { background: rgb(var(--sh-accent)); border-color: rgb(var(--sh-accent)); color: #0a0a15; }
    .ex-tabs button[aria-pressed="true"] small { color: #0a0a15; }
    .ex-tabs button:focus-visible { outline: 2px solid var(--sh-gold); outline-offset: 2px; }
    .ex-card { overflow: hidden; }
    .thumb-wrap { background: #05050b; }
    .play-ov { position: absolute; inset: 0; display: grid; place-items: center; background: none; border: 0; padding: 0; cursor: pointer; }
    .play-ov span { display: grid; place-items: center; width: 40px; height: 40px; color: #fff; background: rgb(5 5 12 / .65); border: 2px solid rgb(255 255 255 / .5); }
    .play-ov:hover span, .play-ov:focus-visible span { background: #e2603a; border-color: #fff; }
    .play-ov:focus-visible { outline: 2px solid var(--sh-gold); outline-offset: -4px; }
    .views-badge { position: absolute; right: 4px; bottom: 4px; font: 12px var(--sh-px); color: #fff; background: rgb(5 5 12 / .75); padding: 1px 5px; pointer-events: none; }
    .yt-link { position: absolute; top: 4px; right: 4px; width: 24px; height: 24px; display: grid; place-items: center; font: 12px var(--sh-px);
      color: #fff; background: rgb(5 5 12 / .75); text-decoration: none; opacity: 0; }
    .ex-card:hover .yt-link, .yt-link:focus-visible { opacity: 1; }
    .yt-link:hover, .yt-link:focus-visible { background: #e2603a; outline: none; }
    @media (hover: none) { .yt-link { opacity: 1; } }
    .ex-t { padding: 8px 10px; }
    .ex-t .a { font: 12px/1.6 var(--sh-px); color: var(--sh-ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ex-t .b { font: 12px/1.6 var(--sh-px); color: var(--sh-ink3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ex-t .c { font: 12px/1.6 var(--sh-px); color: var(--sh-ink2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    /* 就地播放時, 蓋掉縮圖/播放鈕/角標 (iframe 已定位在 .thumb-wrap 內填滿) */
    .thumb-wrap.playing .thumb-img,
    .thumb-wrap.playing .play-ov,
    .thumb-wrap.playing .views-badge,
    .thumb-wrap.playing .yt-link { display: none; }
  </style>
</BaseLayout>
