---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects'))
  .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf());
---

<BaseLayout title="作品集" description="程式作品與專案展示" width="wide">
  <PageHero slot="hero" planet="belt" title="作品集" cmd="ls"
    desc="我的程式專案與作品展示。" chips={[[String(allProjects.length), '個作品']]} />
  <div>

    {allProjects.length === 0 && (
      <p class="sh-label text-center py-12">還沒有作品，敬請期待！</p>
    )}

    <div class="grid md:grid-cols-2 gap-8">
      {allProjects.map(project => (
        <a href={`/projects/${project.id}`} class="sh-card overflow-hidden">
          {project.data.coverImage && (
            <img src={project.data.coverImage} alt="" class="w-full h-48 object-cover" style="border-bottom: 2px solid var(--sh-line)" />
          )}
          <div class="p-6">
            <div class="flex items-center gap-2 mb-2">
              <h2 class="px-h2" style="font-size: 24px; margin: 0">{project.data.title}</h2>
              {project.data.featured && <span class="sh-tag sh-tag--gold">精選</span>}
            </div>
            <p class="mb-4" style="font: 1rem/1.8 var(--sh-read); color: var(--sh-ink2)">{project.data.description}</p>
            <div class="flex flex-wrap gap-2">
              {project.data.techStack.map(tech => (
                <span class="sh-tag">{tech}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
