---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, coverImage, demoUrl, githubUrl, techStack, publishDate } = project.data;

// 使用可選鏈確保類型安全
const fullDescription = `${description} 使用技術：${techStack?.slice(0, 4).join('、') ?? ''}${(techStack?.length ?? 0) > 4 ? ' 等' : ''}。`;
---

<BaseLayout
  title={title}
  description={fullDescription}
  image={coverImage}
  article={true}
  publishDate={new Date(publishDate)}
  width="wide"
>
  <PageHero slot="hero" planet="belt" title={title} desc={description} cmd="cat README.md"
    path={`~/belt/projects/${project.id}`}
    chips={[[new Date(publishDate).toLocaleDateString('zh-TW'), ' 發布']]}
    actions={[
      ...(demoUrl ? [{ label: '查看 Demo', href: demoUrl, primary: true, external: true }] : []),
      ...(githubUrl ? [{ label: 'GitHub 原始碼', href: githubUrl, external: true }] : []),
      { label: '‹ 作品集', href: '/projects' },
    ]} />
  <article>
    {coverImage && (
      coverImage.startsWith('http') ? (
        <img src={coverImage} alt={title} class="w-full h-96 object-cover rounded-lg mb-8" />
      ) : (
        <Image
          src={coverImage}
          alt={title}
          width={1200}
          height={384}
          class="w-full h-96 object-cover rounded-lg mb-8"
          loading="eager"
        />
      )
    )}

    <div class="mb-8">
      <h3 class="text-sm font-semibold text-gray-500 mb-2">技術棧</h3>
      <div class="flex flex-wrap gap-2">
        {techStack.map(tech => (
          <span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-full">
            {tech}
          </span>
        ))}
      </div>
    </div>

    <div class="prose max-w-none">
      <Content />
    </div>

    <div class="mt-12">
      <a href="/projects" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">
        ← 返回作品集
      </a>
    </div>
  </article>
</BaseLayout>
