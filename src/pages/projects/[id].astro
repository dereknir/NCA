---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, coverImage, demoUrl, githubUrl, techStack, publishDate } = project.data;

// 使用可選鏈確保類型安全
const fullDescription = `${description} 使用技術：${techStack?.slice(0, 4).join('、') ?? ''}${(techStack?.length ?? 0) > 4 ? ' 等' : ''}。`;
---

<BaseLayout
  title={title}
  description={fullDescription}
  image={coverImage}
  article={true}
  publishDate={new Date(publishDate)}
  width="wide"
>
  <PageHero slot="hero" planet="belt" compact title={title} desc={description} cmd="cat README.md"
    path={`~/belt/projects/${project.id}`}
    chips={[[new Date(publishDate).toLocaleDateString('zh-TW', { timeZone: 'UTC' }), ' 發布']]}
    actions={[
      ...(demoUrl ? [{ label: '查看 Demo', href: demoUrl, primary: true, external: true }] : []),
      ...(githubUrl ? [{ label: 'GitHub 原始碼', href: githubUrl, external: true }] : []),
    ]} />
  <article>
    {coverImage && (
      coverImage.startsWith('http') ? (
        <img src={coverImage} alt={title} class="sh-img w-full h-96 object-cover mb-8" />
      ) : (
        <Image
          src={coverImage}
          alt={title}
          width={1200}
          height={384}
          class="sh-img w-full h-96 object-cover mb-8"
          loading="eager"
        />
      )
    )}

    <div class="mb-8">
      <h2 class="sh-label">技術棧</h2>
      <div class="flex flex-wrap gap-2">
        {techStack.map(tech => (
          <span class="sh-tag">{tech}</span>
        ))}
      </div>
    </div>

    <div class="prose max-w-none">
      <Content />
    </div>

    <div class="mt-12">
      <a href="/projects" class="sh-back">← 返回作品集</a>
    </div>
  </article>
</BaseLayout>
