---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { SITE_CONFIG } from '../config';
import BrandPlanet from '../components/BrandPlanet.astro';
import { getCollection } from 'astro:content';
import translationDates from '../data/translation_dates.json';
import fullLive from '../data/full_live.json';
import shorts from '../data/shorts_by_song.json';
import liveEvents from '../../live/data/nishina_live_events.json';
import tourStops from '../../live/data/tour_stops.json';

// 「這個站現在有」: build 的時候算, 新翻好一首、多一篇日記就自己變
const songs = await getCollection('translations');
const done = songs.filter(t => t.data.instrumental === true || (!!t.body && !t.body.includes('翻譯準備中')));
const lines = done.reduce((n, t) => n + (t.data.instrumental ? 0 : (t.body ?? '').split('class="lyrics-line"').length - 1), 0);
const dates = translationDates as Record<string, { translated: string | null }>;
// 最近一次翻好的那天 (同一天常常一次翻好好幾首, 不挑其中一首)
const day = (iso: string) => new Date(iso).toLocaleDateString('zh-TW', { timeZone: 'Asia/Taipei' });
const doneDays = done.map(t => dates[t.id]?.translated).filter((d): d is string => !!d).map(day);
const lastDay = done.map(t => dates[t.id]?.translated ?? '').sort().at(-1);
const lastCount = lastDay ? doneDays.filter(d => d === day(lastDay)).length : 0;
const diary = await getCollection('diary', ({ data }) => !data.isPrivate);
const projects = await getCollection('projects');
const stops = tourStops.tours.reduce((n, t) => n + t.stops.length, 0);
const appear = liveEvents.appearance.length;
const shortCount = Object.values(shorts.by_song as Record<string, unknown[]>).reduce((n, v) => n + v.length, 0);
const fmt = (n: number) => n.toLocaleString('zh-TW');
const STATS: Array<{ n: string; u: string; links: Array<[string, string]>; note: string }> = [
  { n: String(done.length), u: `/ ${songs.length} 首`, links: [['翻好的歌', '/translations/']],
    note: lastDay ? `最近一次 ${day(lastDay)}, 翻好 ${lastCount} 首` : '' },
  { n: fmt(lines), u: '句', links: [['翻好的歌詞', '/translations/']], note: '每一句日文都有中文和拼音' },
  { n: String(fullLive.songs.length), u: '首', links: [['完整 Live', '/live/full/']], note: '每一句都找得到有人在現場唱' },
  { n: fmt(shortCount), u: '支', links: [['現場影片', '/live/']], note: '按版本分好: Live / MV / THE FIRST TAKE' },
  { n: fmt(stops + appear), u: '場', links: [['演出紀錄', '/live/timeline/']], note: `${tourStops.tours.length} 次巡演 ${stops} 站 + 出演 ${appear} 場` },
  { n: `${diary.length} · ${projects.length}`, u: '篇', links: [['日記', '/diary/'], ['作品', '/projects/']], note: '寫網站時的碎碎念、做過的東西' },
];
---

<BaseLayout title="關於我" description="認識 Derek" width="read">
  <PageHero slot="hero" planet="neptune" width="read" title="關於我" cmd="whoami" />
  <div>

    <div class="ab">
      <div class="ab-me">
        <!-- 頭像: 頁尾那顆「derekkk」帶環小行星放大 -->
        <BrandPlanet size={128} class="ab-planet" />

        <div>
          <h2 class="px-h2" style="margin: 0 0 12px">Derek Ni</h2>
          <p class="ab-p">
            嗨！我是 Derek，一個喜歡日文歌、程式設計和寫日記的人。
          </p>
          <p class="ab-p">
            這個網站是我的個人空間，用來記錄我翻譯的日文歌曲、分享程式作品，以及記錄日常生活的點滴。
          </p>
        </div>
      </div>

      <hr class="ab-hr">

      <!-- 喜歡的事: 三格像素卡, 編號 + 名稱 + 一句話 -->
      <div class="ab-likes">
        <div class="sh-card ab-like"><span class="sh-label">01</span><h3>日文歌翻譯</h3><p>喜歡日文歌，享受翻譯歌詞的過程</p></div>
        <div class="sh-card ab-like"><span class="sh-label">02</span><h3>程式開發</h3><p>熱愛寫程式，持續學習新技術</p></div>
        <div class="sh-card ab-like"><span class="sh-label">03</span><h3>寫日記</h3><p>用文字記錄生活中的美好時刻</p></div>
      </div>

      <hr class="ab-hr">

      <!-- 這個站現在有: 跟標題區的提示列同一個語言, 打一個指令吐出一張對齊的表 -->
      <section class="ab-term" aria-labelledby="ab-term-h">
        <h3 id="ab-term-h" class="sr-only">這個站現在有</h3>
        <div class="sh-prompt" aria-hidden="true"><span class="u">derek@nishina</span>:<span class="pa">~</span> $ du -h --summary ~/*</div>
        <ul>
          {STATS.map(r => (
            <li>
              <span class="n">{r.n}</span><span class="un">{r.u}</span>
              <span class="l">{r.links.map(([t, href], i) => <>{i > 0 && <i aria-hidden="true"> · </i>}<a href={href}>{t}</a></>)}</span>
              {r.note && <span class="c"><span aria-hidden="true"># </span>{r.note}</span>}
            </li>
          ))}
        </ul>
        <div class="sh-prompt" aria-hidden="true"><span class="u">derek@nishina</span>:<span class="pa">~</span> $ <span class="cmd"></span></div>
      </section>

      <hr class="ab-hr">

      <!-- Contact -->
      <div>
        <h3 class="px-h2" style="margin: 0 0 14px">聯絡我</h3>
        <div class="flex flex-wrap gap-3">
          <a href={SITE_CONFIG.social.github} target="_blank" rel="noopener noreferrer" class="sh-btn">GitHub</a>
          <a href={`mailto:${SITE_CONFIG.social.email}`} class="sh-btn sh-btn--pri">Email</a>
        </div>
      </div>

      <hr class="ab-hr">
      <div>
        <h3 class="sh-label" style="margin-bottom: 12px">素材與致謝</h3>
        <ul class="ab-credits">
          <li>行星 shader — 改編自 <a href="https://github.com/Deep-Fold/PixelPlanets" target="_blank" rel="noopener noreferrer" class="sh-link">Deep-Fold「PixelPlanets」</a>(Godot, MIT)之 Unity 移植版 <a href="https://github.com/hmcGit/UniPixelPlanet" target="_blank" rel="noopener noreferrer" class="sh-link">hmcGit/UniPixelPlanet</a>(MIT, © Harry Kilian);WebGL 移植為本站自製。</li>
          <li>像素字型 — <a href="https://github.com/TakWolf/fusion-pixel-font" target="_blank" rel="noopener noreferrer" class="sh-link">fusion-pixel-font</a>(OFL-1.1,含俐方體11號/Ark Pixel/Galmuri 字形)。</li>
          <li>內文字型 — <a href="https://github.com/justfont/open-huninn-font" target="_blank" rel="noopener noreferrer" class="sh-link">jf open 粉圓</a>(justfont, OFL-1.1)、<a href="https://fonts.google.com/specimen/DotGothic16" target="_blank" rel="noopener noreferrer" class="sh-link">DotGothic16</a>(Fontworks, OFL-1.1)。</li>
          <li>日本地圖 — dataofjapan/land(Natural Earth, 公有領域)。</li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .ab-me { display: flex; align-items: flex-start; gap: 32px; }
  .ab-planet { flex: none; image-rendering: pixelated; filter: drop-shadow(0 0 24px rgb(232 201 74 / .25)); }
  .ab-p { margin: 0 0 12px; font: 1.125rem/1.9 var(--sh-read); color: var(--sh-ink2); }
  .ab-hr { margin: 32px 0; border: 0; border-top: 1px dashed var(--sh-line); }
  .ab-likes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .ab-like { padding: 14px 16px; }
  .ab-like h3 { margin: 4px 0 6px; font: 400 24px var(--sh-px); letter-spacing: .05em; color: #fff; }
  .ab-like p { margin: 0; font: 1rem/1.7 var(--sh-read); color: var(--sh-ink2); }
  .ab-credits { list-style: none; margin: 0; padding: 0; font: 12px/2 var(--sh-px); color: var(--sh-ink3); }
  @media (max-width: 640px) {
    .ab-me { flex-direction: column; align-items: center; text-align: center; gap: 16px; }
    .ab-planet { width: 96px; height: 96px; }
    .ab-likes { grid-template-columns: 1fr; }
  }
  .ab-term { background: #07060f; border: 2px solid #2b2249; padding: 16px 18px; }
  /* 整張表共用一個格線 (li 是 display: contents), 每一欄上下對齊: 數字 (靠右) / 單位 / 連到哪 / # 說明; 手機說明換到下一行 */
  .ab-term ul { list-style: none; margin: 6px 0 8px; padding: 0; display: grid; grid-template-columns: auto auto auto minmax(0, 1fr);
    column-gap: 14px; align-items: baseline; font: 12px/2 var(--sh-px); color: var(--sh-ink2); }
  .ab-term li { display: contents; }
  .ab-term .n { justify-self: end; font: 24px/36px var(--sh-px); color: #fff; white-space: nowrap; }
  .ab-term .l a { color: inherit; text-decoration: underline dotted; text-underline-offset: 4px; }
  .ab-term .l a:hover, .ab-term .l a:focus-visible { color: var(--sh-gold); text-decoration-style: solid; }
  .ab-term .l a:focus-visible { outline: 2px solid var(--sh-gold); outline-offset: 2px; }
  .ab-term .l i { font-style: normal; color: var(--sh-ink3); }
  .ab-term .c { color: var(--sh-ink3); }
  @media (max-width: 640px) {
    .ab-term { padding: 12px; }
    .ab-term ul { grid-template-columns: auto auto minmax(0, 1fr); column-gap: 10px; }
    .ab-term .c { grid-column: 2 / -1; line-height: 1.6; margin-bottom: 8px; }
    .ab-term .sh-prompt { word-break: normal; }
  }
</style>

