---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { coverAt } from '../../lib/covers';
import Stamp from '../../components/SongStamp.astro';

const allTranslations = await getCollection('translations');

type Translation = typeof allTranslations[number];

// Instrumental tracks are "complete" for progress purposes (nothing to translate).
// A track counts as "complete" if it is instrumental OR its body has real content.
const isDone = (entry: Translation) =>
  entry.data.instrumental === true ||
  (!!entry.body && !entry.body.includes('翻譯準備中'));

// 分頁 = 專輯; にしな 以外的歌手併成一頁用歌手名
const MAIN_ARTIST = 'にしな';
const tabOf = (t: Translation) =>
  t.data.artist === MAIN_ARTIST ? (t.data.album ?? '單曲') : t.data.artist;

interface Tab { name: string; year: number; songs: Translation[] }
const tabs = Object.values(allTranslations.reduce((acc, t) => {
  const name = tabOf(t);
  acc[name] ??= { name, year: 0, songs: [] };
  acc[name].songs.push(t);
  // feat. / 單曲沒有專輯年份, 排在三張專輯後面
  if (t.data.albumYear && t.data.album !== 'feat.' && t.data.artist === MAIN_ARTIST) acc[name].year = t.data.albumYear;
  return acc;
}, {} as Record<string, Tab>)).sort((a, b) => b.year - a.year || b.songs.length - a.songs.length);

for (const tab of tabs) {
  tab.songs.sort((a, b) =>
    (a.data.trackNumber ?? 99) - (b.data.trackNumber ?? 99) ||
    new Date(a.data.publishDate).valueOf() - new Date(b.data.publishDate).valueOf());
}
const rows = tabs.flatMap(tab => tab.songs.map(t => ({ t, tab: tab.name })));

const totalTranslated = allTranslations.filter(t => isDone(t)).length;
const num = (t: Translation) => t.data.trackNumber ? String(t.data.trackNumber).padStart(2, '0') : '--';
// 唱片櫃的大封面: 這張專輯裡最多首共用的那張 (通常就是專輯封面)
const albumCover = (tab: Tab) => {
  const n = new Map<string, number>();
  tab.songs.forEach(t => { if (t.data.coverImage) n.set(t.data.coverImage, (n.get(t.data.coverImage) ?? 0) + 1); });
  return [...n].sort((a, b) => b[1] - a[1])[0]?.[0];
};
const totalSongs = allTranslations.length;
const albumCount = tabs.filter(t => t.year > 0).length;
---

<BaseLayout title="日文歌翻譯" description="日文歌曲中文翻譯收藏" viewTransitions={true} width="wide">
  <PageHero slot="hero" planet="earth" title="日文歌翻譯" cmd="ls -l"
    desc="收錄我喜愛的日文歌曲翻譯，包含原文與中文對照。"
    chips={[[`${totalTranslated}/${totalSongs}`, '已翻譯'], [String(albumCount), '張專輯']]}
    actions={[{ label: '隨機一首', href: '#random', primary: true }, { label: '歌詞索引', href: '/kwic/' }]} />

  {allTranslations.length === 0 && (
    <p class="text-gray-500 text-center py-12">還沒有翻譯文章，敬請期待！</p>
  )}

  {/* 專輯篩選: 單選開關 (aria-pressed), 篩的是下面同一張清單, 不是分頁; 三種檢視一起篩 */}
  <div class="tr-bar">
    <div class="sh-tabs" role="group" aria-label="依專輯篩選" data-song-tabs>
      <button type="button" aria-pressed="true" data-tab="">
        <span class="t">ALL</span><small>{totalSongs} 首</small>
      </button>
      {tabs.map(tab => (
        <button type="button" aria-pressed="false" data-tab={tab.name}>
          <span class="t">{tab.name}</span><small>{tab.year > 0 ? `${tab.year} · ` : ''}{tab.songs.length} 首</small>
        </button>
      ))}
    </div>
    {/* 檢視: 表格 / 封面牆 / 唱片櫃, 記住上次用的 (localStorage tr-view) */}
    <div class="tr-views" role="group" aria-label="檢視">
      <button type="button" data-v="table" aria-pressed="true"><svg viewBox="0 0 6 6" aria-hidden="true"><path d="M0 0h6v1H0zM0 2.5h6v1H0zM0 5h6v1H0z"/></svg>表格</button>
      <button type="button" data-v="wall" aria-pressed="false"><svg viewBox="0 0 6 6" aria-hidden="true"><path d="M0 0h2v2H0zM4 0h2v2H4zM0 4h2v2H0zM4 4h2v2H4z"/></svg>封面牆</button>
      <button type="button" data-v="shelf" aria-pressed="false"><svg viewBox="0 0 6 6" aria-hidden="true"><path d="M0 0h3v3H0zM4 0h2v1H4zM4 2h2v1H4zM0 4.5h6v1H0z"/></svg>唱片櫃</button>
    </div>
  </div>

  <div class="tr-views-body" data-view="table" data-song-views>
    {/* 畫面出來之前就換成上次用的檢視, 不會先閃一下表格 */}
    <script is:inline>
      (function () { var v; try { v = localStorage.getItem('tr-view'); } catch (e) {}
        if (v === 'wall' || v === 'shelf') document.currentScript.parentElement.dataset.view = v; })();
    </script>

    {/* 表格 */}
    <div class="sh-tbl tr-v tr-v--table" data-song-rows>
      {rows.map(({ t, tab }) => (
        <a href={`/translations/${t.id}`} data-tab={tab}>
          <span class="c-n">{num(t)}</span>
          {t.data.coverImage
            ? <img src={coverAt(t.data.coverImage, 80)} alt="" width="40" height="40" loading="lazy" decoding="async"
                   style={`view-transition-name:cover-${t.id}`} />
            : <span></span>}
          <span class="c-t" lang="ja" title={t.data.title}>{t.data.title}</span>
          <span class="c-a">{t.data.artist === MAIN_ARTIST ? (t.data.album ?? '單曲') : `${t.data.artist} · ${t.data.album ?? ''}`}</span>
          <span class="c-s"><Stamp t={t} /></span>
        </a>
      ))}
    </div>

    {/* 封面牆: 每首一格封面, 依專輯分段 */}
    <div class="tr-v tr-v--wall">
      {tabs.map(tab => (
        <section data-tab={tab.name}>
          <div class="tr-wall-hd"><h2 lang="ja">{tab.name}</h2><span>{tab.year > 0 ? `${tab.year} · ` : ''}{tab.songs.length} 首</span></div>
          <div class="tr-wall">
            {tab.songs.map(t => (
              <a class={`tr-tile${isDone(t) ? '' : ' is-wip'}`} href={`/translations/${t.id}`} title={t.data.title}>
                <span class="cv">
                  {t.data.coverImage && <img src={coverAt(t.data.coverImage, 320)} alt="" width="160" height="160" loading="lazy" decoding="async"
                    style={`view-transition-name:cover-${t.id}`} />}
                  {t.data.trackNumber && <span class="no">{num(t)}</span>}
                  <span class="st-at"><Stamp t={t} /></span>
                </span>
                <span class="t" lang="ja">{t.data.title}</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    {/* 唱片櫃: 一張專輯一列, 大封面 + 曲目單 */}
    <div class="tr-v tr-v--shelf">
      {tabs.map(tab => (
        <section class="tr-alb" data-tab={tab.name}>
          {albumCover(tab) ? <img class="big" src={coverAt(albumCover(tab)!, 448)} alt="" width="200" height="200" loading="lazy" decoding="async" /> : <span class="big"></span>}
          <div class="tr-alb-body">
            <h2 lang="ja">{tab.name}</h2>
            <p class="meta">{tab.year > 0 ? tab.year : '—'} · {tab.songs.length} 首</p>
            <ol class="tr-trk">
              {tab.songs.map(t => (
                <li><a href={`/translations/${t.id}`}>
                  <span class="n">{num(t)}</span><span class="tt" lang="ja">{t.data.title}</span><Stamp t={t} />
                </a></li>
              ))}
            </ol>
          </div>
        </section>
      ))}
    </div>
  </div>

  <script is:inline>
    /* 專輯篩選、檢視切換、隨機一首。翻譯頁圈內有 ClientRouter, 換頁回來要重綁 → astro:page-load (首載也會觸發) */
    (function () {
      function bind() {
        const bar = document.querySelector('[data-song-tabs]'), body = document.querySelector('[data-song-views]');
        if (!bar || !body || bar.dataset.bound) return;
        bar.dataset.bound = '1';
        // ClientRouter 換頁回來時, 上面那段先套檢視的 script 不一定跑得到: 這裡再套一次
        try { const v = localStorage.getItem('tr-view'); if (v === 'table' || v === 'wall' || v === 'shelf') body.dataset.view = v; } catch (e) {}
        const views = document.querySelectorAll('.tr-views button');
        const paint = () => views.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.v === body.dataset.view)));
        paint();
        views.forEach(b => b.addEventListener('click', () => {
          body.dataset.view = b.dataset.v; paint();
          try { localStorage.setItem('tr-view', b.dataset.v); } catch (e) {}
        }));
        bar.addEventListener('click', e => {
          const b = e.target.closest('button');
          if (!b) return;
          bar.querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
          body.querySelectorAll('[data-tab]').forEach(r => { r.hidden = !!b.dataset.tab && r.dataset.tab !== b.dataset.tab; });
        });
        const rows = body.querySelectorAll('[data-song-rows] a');
        document.querySelector('a[href="#random"]')?.addEventListener('click', e => {
          e.preventDefault();
          const pick = rows[Math.random() * rows.length | 0];
          if (pick) pick.click();   // 用點的: 走 ClientRouter, 封面接續動畫照樣有
        });
      }
      bind();
      document.addEventListener('astro:page-load', bind);
    })();
  </script>
</BaseLayout>

<style is:global>
  /* ---------- 篩選列 + 檢視切換 ---------- */
  .tr-bar { display: flex; align-items: center; gap: 16px; margin: 0 0 8px; border-top: 1px solid rgb(255 255 255 / .08); border-bottom: 1px solid rgb(255 255 255 / .08); }
  .tr-bar .sh-tabs { flex: 1; min-width: 0; border: 0; margin: 0; }
  .tr-views { display: inline-flex; flex: none; border: 2px solid var(--sh-line); filter: drop-shadow(3px 3px 0 rgb(0 0 0 / .5)); }
  .tr-views button { display: inline-flex; align-items: center; gap: 6px; font: 12px var(--sh-px); letter-spacing: .06em; color: var(--sh-ink2);
    background: rgb(10 10 21 / .6); border: 0; padding: 8px 12px; cursor: pointer; }
  .tr-views button + button { border-left: 2px solid var(--sh-line); }
  .tr-views button:hover { color: var(--sh-gold); }
  .tr-views button[aria-pressed="true"] { background: rgb(var(--sh-accent)); color: #0a0a15; }
  .tr-views button:focus-visible { outline: 2px solid var(--sh-gold); outline-offset: -4px; }
  .tr-views svg { width: 12px; height: 12px; fill: currentColor; shape-rendering: crispEdges; }
  @media (max-width: 760px) { .tr-bar { flex-direction: column; align-items: stretch; gap: 0; padding-bottom: 12px; } .tr-views { align-self: flex-start; } }

  /* 一次只顯示一種; 篩掉的整段收起來 */
  .tr-v { display: none; }
  [data-view="table"] > .tr-v--table, [data-view="wall"] > .tr-v--wall, [data-view="shelf"] > .tr-v--shelf { display: block; }
  [data-song-views] [hidden] { display: none !important; }

  /* ---------- 表格: 狀態欄只放一個章 ---------- */
  .tr-v--table.sh-tbl a { grid-template-columns: 48px 40px 1fr 170px 20px; }
  @media (max-width: 640px) { .tr-v--table.sh-tbl a { grid-template-columns: 28px 40px 1fr 20px; } }

  /* ---------- 封面牆 ---------- */
  .tr-wall-hd { display: flex; align-items: baseline; gap: 12px; margin: 28px 0 12px; font: 12px var(--sh-px); color: var(--sh-ink3); letter-spacing: .06em; }
  .tr-wall-hd h2 { margin: 0; font: 400 24px/32px var(--sh-pxja); color: #fff; letter-spacing: .04em; }
  .tr-wall-hd::after { content: ''; flex: 1; align-self: center; height: 2px; background: repeating-linear-gradient(90deg, var(--sh-line) 0 4px, transparent 4px 8px); }
  .tr-wall { display: grid; grid-template-columns: repeat(auto-fill, minmax(132px, 1fr)); gap: 18px 16px; }
  .tr-tile { display: block; color: inherit; text-decoration: none; }
  .tr-tile .cv { position: relative; display: block; aspect-ratio: 1; background: #131a2e; border: 2px solid rgb(255 255 255 / .12);
    filter: drop-shadow(4px 4px 0 rgb(0 0 0 / .5)); }
  .tr-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tr-tile .no { position: absolute; left: 0; top: 0; font: 12px var(--sh-px); color: #0a0a15; background: rgb(var(--sh-accent)); padding: 1px 5px; }
  .tr-tile .st-at { position: absolute; right: 4px; bottom: 4px; display: flex; }
  .tr-tile .st-at .stamp { background: rgb(10 10 21 / .82); }
  .tr-tile.is-wip img { filter: grayscale(.85) brightness(.6); }
  .tr-tile .t { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 8px;
    font: 16px/1.35 'PX10-JA', var(--sh-px10); }
  .tr-tile:hover .cv, .tr-tile:focus-visible .cv { border-color: var(--sh-gold); translate: -2px -2px; filter: drop-shadow(6px 6px 0 rgb(0 0 0 / .5)); }
  .tr-tile:hover .t { color: var(--sh-gold); }
  .tr-tile:focus-visible { outline: none; }
  .tr-tile:focus-visible .t { color: var(--sh-gold); text-decoration: underline; }
  @media (max-width: 640px) { .tr-wall { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px 10px; } .tr-tile .t { font-size: 12px; } }

  /* ---------- 唱片櫃 ---------- */
  .tr-alb { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 24px; padding: 24px 0; border-bottom: 1px solid rgb(255 255 255 / .06); }
  .tr-alb .big { display: block; width: 200px; height: 200px; object-fit: cover; background: #131a2e; border: 2px solid rgb(255 255 255 / .15);
    filter: drop-shadow(6px 6px 0 rgb(0 0 0 / .5)); }
  .tr-alb h2 { margin: 0 0 2px; font: 400 24px/32px var(--sh-pxja); color: #fff; letter-spacing: .04em; }
  .tr-alb .meta { margin: 0 0 12px; font: 12px var(--sh-px); color: var(--sh-ink3); letter-spacing: .06em; }
  .tr-trk { list-style: none; margin: 0; padding: 0; columns: 2 220px; column-gap: 28px; }
  .tr-trk li { break-inside: avoid; }
  .tr-trk a { display: grid; grid-template-columns: 28px minmax(0, 1fr) 20px; gap: 8px; align-items: center; padding: 5px 4px; color: inherit; text-decoration: none; }
  .tr-trk a:hover { background: rgb(var(--sh-accent) / .08); }
  .tr-trk a:hover .tt { color: var(--sh-gold); }
  .tr-trk .n { font: 12px var(--sh-px); color: var(--sh-ink3); }
  .tr-trk .tt { font: 16px/1.4 'PX10-JA', var(--sh-px10); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 640px) {
    .tr-alb { grid-template-columns: 96px minmax(0, 1fr); gap: 14px; }
    .tr-alb .big { width: 96px; height: 96px; }
    .tr-alb-body { display: contents; }
    .tr-alb h2 { grid-column: 2; grid-row: 1; align-self: end; font-size: 18px; line-height: 24px; }
    .tr-alb .meta { grid-column: 2; grid-row: 2; align-self: start; }
    .tr-alb .big { grid-row: 1 / span 2; }
    .tr-trk { grid-column: 1 / -1; columns: 1; }
  }
</style>
