---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

const allTranslations = await getCollection('translations');

type Translation = typeof allTranslations[number];

// Instrumental tracks are "complete" for progress purposes (nothing to translate).
// A track counts as "complete" if it is instrumental OR its body has real content.
const isDone = (entry: Translation) =>
  entry.data.instrumental === true ||
  (!!entry.body && !entry.body.includes('翻譯準備中'));

// 分頁 = 專輯; にしな 以外的歌手併成一頁用歌手名
const MAIN_ARTIST = 'にしな';
const tabOf = (t: Translation) =>
  t.data.artist === MAIN_ARTIST ? (t.data.album ?? '單曲') : t.data.artist;

interface Tab { name: string; year: number; songs: Translation[] }
const tabs = Object.values(allTranslations.reduce((acc, t) => {
  const name = tabOf(t);
  acc[name] ??= { name, year: 0, songs: [] };
  acc[name].songs.push(t);
  // feat. / 單曲沒有專輯年份, 排在三張專輯後面
  if (t.data.albumYear && t.data.album !== 'feat.' && t.data.artist === MAIN_ARTIST) acc[name].year = t.data.albumYear;
  return acc;
}, {} as Record<string, Tab>)).sort((a, b) => b.year - a.year || b.songs.length - a.songs.length);

for (const tab of tabs) {
  tab.songs.sort((a, b) =>
    (a.data.trackNumber ?? 99) - (b.data.trackNumber ?? 99) ||
    new Date(a.data.publishDate).valueOf() - new Date(b.data.publishDate).valueOf());
}
const rows = tabs.flatMap(tab => tab.songs.map(t => ({ t, tab: tab.name })));

const totalTranslated = allTranslations.filter(t => isDone(t)).length;
const totalSongs = allTranslations.length;
const albumCount = tabs.filter(t => t.year > 0).length;
---

<BaseLayout title="日文歌翻譯" description="日文歌曲中文翻譯收藏" viewTransitions={true} width="wide">
  <PageHero slot="hero" planet="earth" title="日文歌翻譯" cmd="ls -l"
    desc="收錄我喜愛的日文歌曲翻譯，包含原文與中文對照。"
    chips={[[`${totalTranslated}/${totalSongs}`, '已翻譯'], [String(albumCount), '張專輯']]}
    actions={[{ label: '隨機一首', href: '#random', primary: true }, { label: '歌詞索引', href: '/kwic/' }]} />

  {allTranslations.length === 0 && (
    <p class="text-gray-500 text-center py-12">還沒有翻譯文章，敬請期待！</p>
  )}

  <div class="sh-tabs" role="tablist" data-song-tabs>
    <button type="button" role="tab" aria-selected="true" data-tab="">
      <span class="t">ALL</span><small>{totalSongs} 首</small>
    </button>
    {tabs.map(tab => (
      <button type="button" role="tab" aria-selected="false" data-tab={tab.name}>
        <span class="t">{tab.name}</span><small>{tab.year > 0 ? `${tab.year} · ` : ''}{tab.songs.length} 首</small>
      </button>
    ))}
  </div>

  <div class="sh-tbl" data-song-rows>
    {rows.map(({ t, tab }) => {
      const done = isDone(t);
      const status = t.data.instrumental ? 'inst.' : done ? '已翻譯' : '翻譯中';
      return (
        <a href={`/translations/${t.id}`} data-tab={tab}>
          <span class="c-n">{t.data.trackNumber ? String(t.data.trackNumber).padStart(2, '0') : '--'}</span>
          {t.data.coverImage
            ? <img src={t.data.coverImage} alt="" width="40" height="40" loading="lazy" decoding="async"
                   style={`view-transition-name:cover-${t.id}`} />
            : <span></span>}
          <span class="c-t" lang="ja">{t.data.title}</span>
          <span class="c-a">{t.data.artist === MAIN_ARTIST ? (t.data.album ?? '單曲') : `${t.data.artist} · ${t.data.album ?? ''}`}</span>
          <span class={`c-s${done ? '' : ' wip'}`}>{status}</span>
        </a>
      );
    })}
  </div>

  <script is:inline>
    /* 專輯分頁 + 隨機一首。翻譯頁圈內有 ClientRouter, 換頁回來要重綁 → astro:page-load (首載也會觸發) */
    (function () {
      function bind() {
        const bar = document.querySelector('[data-song-tabs]');
        if (!bar || bar.dataset.bound) return;
        bar.dataset.bound = '1';
        const rows = document.querySelectorAll('[data-song-rows] a');
        bar.addEventListener('click', e => {
          const b = e.target.closest('button');
          if (!b) return;
          bar.querySelectorAll('button').forEach(x => x.setAttribute('aria-selected', x === b ? 'true' : 'false'));
          rows.forEach(r => { r.hidden = !!b.dataset.tab && r.dataset.tab !== b.dataset.tab; });
        });
        document.querySelector('a[href="#random"]')?.addEventListener('click', e => {
          e.preventDefault();
          const pick = rows[Math.random() * rows.length | 0];
          if (pick) pick.click();
        });
      }
      bind();
      document.addEventListener('astro:page-load', bind);
    })();
  </script>
</BaseLayout>
