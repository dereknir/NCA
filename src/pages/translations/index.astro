---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allTranslations = (await getCollection('translations'))
  .sort((a, b) => {
    // Sort by trackNumber if same album, otherwise by publishDate
    if (a.data.album && a.data.album === b.data.album) {
      return (a.data.trackNumber ?? 99) - (b.data.trackNumber ?? 99);
    }
    return new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf();
  });

// Group by artist → album
type Translation = typeof allTranslations[number];
interface AlbumGroup {
  albumYear?: number;
  songs: Translation[];
}
interface ArtistGroup {
  albums: Record<string, AlbumGroup>;
}

const byArtistAlbum = allTranslations.reduce((acc, t) => {
  const artist = t.data.artist;
  const album = t.data.album ?? '單曲 / 其他';

  if (!acc[artist]) acc[artist] = { albums: {} };
  if (!acc[artist].albums[album]) {
    acc[artist].albums[album] = { albumYear: t.data.albumYear, songs: [] };
  }
  acc[artist].albums[album].songs.push(t);
  return acc;
}, {} as Record<string, ArtistGroup>);
---

<BaseLayout title="日文歌翻譯" description="日文歌曲中文翻譯收藏">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold mb-4">日文歌翻譯</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">收錄我喜愛的日文歌曲翻譯，包含原文與中文對照</p>

    {allTranslations.length === 0 && (
      <p class="text-gray-500 text-center py-12">還沒有翻譯文章，敬請期待！</p>
    )}

    {Object.entries(byArtistAlbum).map(([artist, { albums }]) => (
      <section class="mb-16">
        <h2 class="text-2xl font-bold mb-6 text-blue-600 dark:text-blue-400 border-b-2 border-blue-600 dark:border-blue-400 pb-2">
          {artist}
        </h2>

        {Object.entries(albums)
          .sort(([, a], [, b]) => (b.albumYear ?? 0) - (a.albumYear ?? 0))
          .map(([albumName, { albumYear, songs }]) => (
            <div class="mb-8 ml-4">
              <h3 class="text-lg font-semibold mb-3 flex items-center gap-2">
                <span class="text-gray-400">💿</span>
                <span>{albumName}</span>
                {albumYear && (
                  <span class="text-sm font-normal text-gray-500">({albumYear})</span>
                )}
              </h3>

              <div class="space-y-3 ml-6">
                {songs.map((t, i) => (
                  <a href={`/translations/${t.id}`}
                     class="block p-4 bg-white dark:bg-gray-800 rounded-lg shadow hover:shadow-md transition">
                    <div class="flex justify-between items-start">
                      <div class="flex items-center gap-3">
                        {t.data.trackNumber && (
                          <span class="text-sm text-gray-400 font-mono w-6 text-right">{t.data.trackNumber}.</span>
                        )}
                        <div>
                          <h4 class="text-lg font-medium">{t.data.title}</h4>
                          <div class="flex gap-2 mt-1">
                            {t.data.tags.map(tag => (
                              <span class="px-2 py-0.5 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-xs rounded">
                                {tag}
                              </span>
                            ))}
                          </div>
                        </div>
                      </div>
                      <time class="text-sm text-gray-500 shrink-0">
                        {new Date(t.data.publishDate).toLocaleDateString('zh-TW')}
                      </time>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
      </section>
    ))}
  </div>
</BaseLayout>
